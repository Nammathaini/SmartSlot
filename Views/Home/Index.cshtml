@{
    ViewData["Title"] = "SmartSlot";
}

<style>
    .hero-section 
    {
    position: relative;
    height: 100vh;
    width: 100vw;
    margin: 0;
    padding: 0;
    background-image: url('/images/parking-bg.jpg');
    background-size: cover;
    background-position: center;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    }

    .hero-overlay {
        position: absolute;
        top: 0; left: 0;
        width: 100%; height: 100%;
        background: rgba(0, 0, 0, 0.6);
    }

    .hero-content {
        position: relative;
        z-index: 2;
        color: white;
    }

    .hero-content h1 {
        font-size: 3rem;
        font-weight: bold;
        margin-bottom: 10px;
        letter-spacing: 2px;
    }

    .hero-content p {
        font-size: 1.2rem;
        margin-bottom: 40px;
        color: #ddd;
    }

    .hero-buttons {
        display: flex;
        gap: 20px;
        justify-content: center;
        flex-wrap: wrap;
    }

    .btn-hero {
        padding: 15px 35px;
        font-size: 1.1rem;
        border: none;
        border-radius: 8px;
        cursor: pointer;
        text-decoration: none;
        font-weight: bold;
        transition: transform 0.2s, opacity 0.2s;
    }

    .btn-hero:hover {
        transform: scale(1.05);
        opacity: 0.9;
        text-decoration: none;
    }

    .btn-add {
        background-color: #28a745;
        color: white;
    }

    .btn-find {
        background-color: #007bff;
        color: white;
    }
</style>

<!-- Remove default navbar padding -->
<style>
    body { padding-top: 0 !important; }
    .navbar { position: absolute; width: 100%; z-index: 10; background: transparent !important; }
    .navbar-brand, .nav-link { color: white !important; }
    body {
    margin: 0 !important;
    padding: 0 !important;
    overflow-x: hidden;
}

.container {
    max-width: 100% !important;
    padding: 0 !important;
}

.navbar {
    display: none !important;
}
</style>


<div class="hero-section">
    <div class="hero-overlay"></div>
    <div class="hero-content">
        <h1>🅿️ SmartSlot</h1>
        <p>Find & Rent Residential Parking Slots Near You</p>
        <div class="hero-buttons">
            <a href="/Parking" class="btn-hero btn-add">🏠 Add Your Parking Slot</a>
            <a href="/Parking/Search" class="btn-hero btn-find">🔍 Find Parking Near Me</a>
        </div>
    </div>
</div>