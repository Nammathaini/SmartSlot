@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <title>Reset Password - SmartSlot</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <style>
        * { box-sizing: border-box; }
        body {
            margin: 0; font-family: 'Segoe UI', sans-serif;
            background-image: url('https://i.pinimg.com/1200x/ea/3f/92/ea3f92fcdab7799f742c813cdb651463.jpg');
            background-size: cover; background-position: center; background-attachment: fixed;
        }
        body::before {
            content: ''; position: fixed; width: 100%; height: 100%;
            background: rgba(0,0,0,0.75); z-index: 0;
        }
        .auth-container {
            position: relative; z-index: 1; height: 100vh;
            display: flex; justify-content: center; align-items: center;
        }
        .auth-card {
            background: rgba(26,26,26,0.95); padding: 35px; width: 370px;
            border-radius: 12px; border: 1px solid #333; text-align: center;
        }
        h2 { color: white; margin-bottom: 8px; font-size: 22px; }
        .desc { color: #aaa; font-size: 13px; margin-bottom: 24px; }
        input {
            width: 100%; padding: 12px; margin: 8px 0; border-radius: 6px;
            border: 1px solid #444; background: #2a2a2a; color: white; font-size: 15px;
        }
        input:focus { outline: none; border-color: #3b82f6; }
        button {
            width: 100%; padding: 12px; background: #3b82f6; border: none;
            border-radius: 6px; color: white; margin-top: 12px;
            cursor: pointer; font-size: 15px; font-weight: 600;
        }
        button:hover { opacity: 0.9; }
        .error {
            color: #ff4d4d; text-align: center; margin-bottom: 10px; font-size: 13px;
            background: rgba(255,77,77,0.1); padding: 8px; border-radius: 6px;
        }
        .success-box {
            background: rgba(74,222,128,0.1); border: 1px solid rgba(74,222,128,0.3);
            border-radius: 10px; padding: 24px; text-align: center;
        }
        .success-icon { font-size: 48px; margin-bottom: 12px; }
        .success-box h3 { color: #4ade80; margin-bottom: 8px; }
        .success-box p { color: #aaa; font-size: 14px; margin-bottom: 20px; }
        .signin-btn {
            display: inline-block; padding: 11px 28px; background: #3b82f6;
            color: white; border-radius: 8px; text-decoration: none;
            font-weight: 600; font-size: 14px;
        }
        .expired-box {
            background: rgba(255,77,77,0.1); border: 1px solid rgba(255,77,77,0.3);
            border-radius: 10px; padding: 24px; text-align: center;
        }
        .expired-box h3 { color: #f87171; margin-bottom: 8px; }
        .expired-box p { color: #aaa; font-size: 14px; margin-bottom: 20px; }
        .back a { color: #aaa; font-size: 13px; text-decoration: none; }
    </style>
</head>
<body>
    <div class="auth-container">
        <div class="auth-card">

            @if (ViewBag.TokenInvalid == true)
            {
                <div class="expired-box">
                    <div style="font-size:48px;margin-bottom:12px;">⏰</div>
                    <h3>Link Expired</h3>
                    <p>This password reset link has expired or already been used. Please request a new one.</p>
                    <a href="/Auth/ForgotPassword" class="signin-btn">Request New Link</a>
                </div>
            }
            else if (ViewBag.PasswordReset == true)
            {
                <div class="success-box">
                    <div class="success-icon">✅</div>
                    <h3>Password Reset Successfully!</h3>
                    <p>Your password has been updated. You can now sign in with your new password.</p>
                    <a href="/Auth/Signin" class="signin-btn">Go to Sign In →</a>
                </div>
            }
            else
            {
                <h2>🔒 Reset Password</h2>
                <p class="desc">Enter your new password below</p>

                @if (ViewBag.Error != null)
                {
                    <div class="error">@ViewBag.Error</div>
                }

                <form method="post">
                    <input type="hidden" name="token" value="@ViewBag.Token" />
                    <input type="password" name="newPassword" placeholder="New Password (min 6 chars)" required minlength="6" />
                    <input type="password" name="confirmPassword" placeholder="Confirm New Password" required minlength="6" />
                    <button type="submit">Reset Password →</button>
                </form>
            }

        </div>
    </div>
</body>
</html>
