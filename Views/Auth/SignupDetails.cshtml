@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>Account Details — SmartSlot</title>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@600;700;800&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
    <style>
        *,*::before,*::after{margin:0;padding:0;box-sizing:border-box;}
        :root{
            --primary:#2563EB;--green:#10b981;--green-dim:#059669;
            --dark:#0F172A;--border:rgba(255,255,255,0.08);
            --text:#f1f5f9;--text-dim:rgba(241,245,249,0.45);
            --red:#ef4444;--orange:#f59e0b;
        }
        html,body{height:100%;}
        body{
            font-family:'Inter',sans-serif;
            background:linear-gradient(135deg,#0F172A 0%,#111827 55%,#0f2820 100%);
            background-attachment:fixed;color:var(--text);
            display:flex;align-items:center;justify-content:center;
            min-height:100vh;padding:20px;position:relative;overflow-x:hidden;
        }
        .orb1{position:fixed;width:600px;height:600px;border-radius:50%;z-index:0;pointer-events:none;background:radial-gradient(circle,rgba(16,185,129,0.08) 0%,transparent 65%);bottom:-150px;left:-100px;}
        .orb2{position:fixed;width:500px;height:500px;border-radius:50%;z-index:0;pointer-events:none;background:radial-gradient(circle,rgba(37,99,235,0.06) 0%,transparent 65%);top:-100px;right:-80px;}
        .card{
            position:relative;z-index:1;width:100%;max-width:420px;
            background:rgba(30,41,59,0.65);backdrop-filter:blur(20px);-webkit-backdrop-filter:blur(20px);
            border:1px solid rgba(255,255,255,0.09);border-radius:24px;
            padding:40px 36px;box-shadow:0 24px 80px rgba(0,0,0,0.4),inset 0 1px 0 rgba(255,255,255,0.08);
            animation:cardIn 0.6s cubic-bezier(0.34,1.56,0.64,1) both;
        }
        @@keyframes cardIn{from{opacity:0;transform:translateY(24px) scale(0.97);}to{opacity:1;transform:translateY(0) scale(1);}}
        .logo{display:flex;align-items:center;gap:10px;margin-bottom:24px;justify-content:center;}
        .logo-mark{width:36px;height:36px;background:linear-gradient(135deg,#10b981,#059669);color:#fff;font-family:'Poppins',sans-serif;font-weight:700;font-size:18px;border-radius:11px;display:flex;align-items:center;justify-content:center;box-shadow:0 6px 18px rgba(16,185,129,0.35);}
        .logo-text{font-family:'Poppins',sans-serif;font-size:21px;font-weight:800;}
        .logo-text span{color:var(--green);}
        h2{font-family:'Poppins',sans-serif;font-size:24px;font-weight:700;margin-bottom:4px;text-align:center;}
        .subtitle{font-size:13px;color:var(--text-dim);text-align:center;margin-bottom:20px;}
        .steps{display:flex;align-items:center;justify-content:center;gap:8px;margin-bottom:4px;}
        .step-dot{width:32px;height:4px;border-radius:2px;background:var(--border);transition:background 0.3s;}
        .step-dot.done{background:rgba(16,185,129,0.35);}
        .step-dot.active{background:var(--green);}
        .step-label{display:flex;justify-content:center;font-size:11px;font-weight:600;letter-spacing:0.8px;text-transform:uppercase;color:var(--text-dim);margin-bottom:20px;}
        .step-label span{color:var(--green);}
        .alert-error{padding:11px 14px;border-radius:10px;font-size:13px;margin-bottom:16px;background:rgba(239,68,68,0.08);border:1px solid rgba(239,68,68,0.2);color:#fca5a5;}
        .field{margin-bottom:16px;}
        .field label{display:block;font-size:10px;font-weight:600;color:var(--text-dim);letter-spacing:1px;text-transform:uppercase;margin-bottom:7px;}
        .field input[type="email"]{
            width:100%;padding:13px 15px;background:#1F2937;border:1px solid rgba(255,255,255,0.06);
            border-radius:10px;color:var(--text);font-family:'Inter',sans-serif;font-size:14px;
            transition:border-color 0.2s,box-shadow 0.2s;outline:none;
        }
        .field input[type="email"]:focus{border-color:var(--green);box-shadow:0 0 0 3px rgba(16,185,129,0.2);}
        .field input[type="email"]::placeholder{color:var(--text-dim);}

        /* ✅ FEATURE 9: Username field with validation states */
        .username-wrap{position:relative;}
        .username-input{
            width:100%;padding:13px 40px 13px 15px;background:#1F2937;
            border:1px solid rgba(255,255,255,0.06);border-radius:10px;color:var(--text);
            font-family:'Inter',sans-serif;font-size:14px;transition:border-color 0.2s,box-shadow 0.2s;outline:none;
        }
        .username-input:focus{box-shadow:0 0 0 3px rgba(16,185,129,0.15);}
        .username-input.valid{border-color:var(--green)!important;}
        .username-input.invalid{border-color:var(--red)!important;}
        .username-input.checking{border-color:var(--orange)!important;}
        .username-status-icon{position:absolute;right:13px;top:50%;transform:translateY(-50%);font-size:16px;pointer-events:none;}
        .username-rules{margin-top:8px;display:grid;grid-template-columns:1fr 1fr;gap:4px 8px;}
        .rule{display:flex;align-items:center;gap:5px;font-size:11px;color:var(--text-dim);transition:color 0.2s;}
        .rule.pass{color:var(--green);}
        .rule.fail{color:#f87171;}
        .rule-dot{width:5px;height:5px;border-radius:50%;background:currentColor;flex-shrink:0;}

        /* ✅ FEATURE 10: Password field + strength meter */
        .pw-wrap{position:relative;display:flex;align-items:center;}
        .pw-wrap input{
            width:100%;padding:13px 44px 13px 15px;background:#1F2937;
            border:1px solid rgba(255,255,255,0.06);border-radius:10px;color:var(--text);
            font-family:'Inter',sans-serif;font-size:14px;
            transition:border-color 0.2s,box-shadow 0.2s;outline:none;
        }
        .pw-wrap input:focus{border-color:var(--green);box-shadow:0 0 0 3px rgba(16,185,129,0.2);}
        .pw-wrap input::placeholder{color:var(--text-dim);}
        .pw-toggle{position:absolute;right:12px;background:none;border:none;cursor:pointer;color:var(--text-dim);padding:4px;display:flex;align-items:center;justify-content:center;transition:color 0.2s;}
        .pw-toggle:hover{color:var(--text);}
        .pw-toggle svg{width:18px;height:18px;pointer-events:none;}

        /* Strength meter */
        .strength-bar-wrap{display:flex;gap:4px;margin-top:8px;}
        .strength-seg{flex:1;height:4px;border-radius:2px;background:rgba(255,255,255,0.08);transition:background 0.3s;}
        .strength-label{font-size:11px;font-weight:600;margin-top:5px;min-height:16px;transition:color 0.2s;}
        .strength-label.weak{color:#ef4444;}
        .strength-label.moderate{color:#f59e0b;}
        .strength-label.strong{color:#10b981;}
        .strength-label.very-strong{color:#3b82f6;}

        /* Password confirm */
        .pw-match-hint{font-size:11px;margin-top:5px;min-height:16px;}
        .pw-match-hint.match{color:var(--green);}
        .pw-match-hint.no-match{color:#f87171;}

        .btn-submit{width:100%;padding:14px;margin-top:10px;background:linear-gradient(90deg,#10b981,#059669);color:#fff;border:none;border-radius:12px;font-family:'Inter',sans-serif;font-size:15px;font-weight:600;cursor:pointer;transition:all 0.2s;box-shadow:0 6px 20px rgba(16,185,129,0.3);}
        .btn-submit:hover:not(:disabled){transform:translateY(-2px);box-shadow:0 12px 32px rgba(16,185,129,0.4);}
        .btn-submit:disabled{opacity:0.45;cursor:not-allowed;transform:none;}
        .divider{height:1px;background:var(--border);margin:20px 0;}
        .switch{text-align:center;font-size:13px;color:var(--text-dim);}
        .switch a{color:var(--primary);text-decoration:none;font-weight:500;}
        .switch a:hover{text-decoration:underline;}
    </style>
</head>
<body>
<div class="orb1"></div>
<div class="orb2"></div>
<div class="card">
    <div class="logo">
        <div class="logo-mark">P</div>
        <div class="logo-text">Smart<span>Slot</span></div>
    </div>
    <h2>Your Details</h2>
    <p class="subtitle">Set up your username and password</p>
    <div class="step-label">Step <span>&nbsp;3&nbsp;</span> of 3</div>
    <div class="steps">
        <div class="step-dot done"></div>
        <div class="step-dot done"></div>
        <div class="step-dot active"></div>
    </div>

    @if (ViewBag.Error != null) { <div class="alert-error">&#9888; @ViewBag.Error</div> }

    <form method="post" id="detailsForm" onsubmit="return validateForm()">
        <!-- Email -->
        <div class="field">
            <label>Email Address</label>
            <input type="email" name="email" id="emailInput" placeholder="you@example.com" required autocomplete="email"/>
        </div>

        <!-- ✅ FEATURE 9: Username with live rules -->
        <div class="field">
            <label>Username</label>
            <div class="username-wrap">
                <input type="text" name="username" id="usernameInput" class="username-input"
                       placeholder="e.g. rahul_drives" required autocomplete="username"
                       oninput="onUsernameInput(this.value)" maxlength="30"/>
                <span class="username-status-icon" id="usernameIcon"></span>
            </div>
            <div class="username-rules" id="usernameRules">
                <div class="rule" id="rule-len"><span class="rule-dot"></span>4–30 characters</div>
                <div class="rule" id="rule-chars"><span class="rule-dot"></span>Letters, numbers, _ .</div>
                <div class="rule" id="rule-start"><span class="rule-dot"></span>Starts with a letter</div>
                <div class="rule" id="rule-nodbl"><span class="rule-dot"></span>No __ or .. in a row</div>
                <div class="rule" id="rule-noend"><span class="rule-dot"></span>Doesn't end with _ or .</div>
                <div class="rule" id="rule-avail"><span class="rule-dot"></span>Username available</div>
            </div>
        </div>

        <!-- ✅ FEATURE 10: Password with strength meter -->
        <div class="field">
            <label>Password</label>
            <div class="pw-wrap">
                <input type="password" name="password" id="passwordInput"
                       placeholder="Create a strong password" required autocomplete="new-password"
                       oninput="onPasswordInput(this.value)"/>
                <button type="button" class="pw-toggle" onclick="togglePw('passwordInput',this)" title="Show password">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
                        <circle cx="12" cy="12" r="3"/>
                    </svg>
                </button>
            </div>
            <!-- Strength bar -->
            <div class="strength-bar-wrap">
                <div class="strength-seg" id="seg1"></div>
                <div class="strength-seg" id="seg2"></div>
                <div class="strength-seg" id="seg3"></div>
                <div class="strength-seg" id="seg4"></div>
            </div>
            <div class="strength-label" id="strengthLabel"></div>
        </div>

        <!-- Confirm Password -->
        <div class="field">
            <label>Confirm Password</label>
            <div class="pw-wrap">
                <input type="password" id="confirmInput" name="confirmPassword"
                       placeholder="Repeat your password" required autocomplete="new-password"
                       oninput="onConfirmInput(this.value)"/>
                <button type="button" class="pw-toggle" onclick="togglePw('confirmInput',this)" title="Show password">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
                        <circle cx="12" cy="12" r="3"/>
                    </svg>
                </button>
            </div>
            <div class="pw-match-hint" id="matchHint"></div>
        </div>

        <button type="submit" class="btn-submit" id="submitBtn">Create Account &#8594;</button>
    </form>
    <div class="divider"></div>
    <div class="switch">Already have an account? <a href="/Auth/Signin">Sign In</a></div>
</div>

<script>
// ✅ FEATURE 9: Username validation (Instagram-like rules)
var usernameValid = false;
var usernameCheckTimer = null;

var rules = {
    len:    function(v){ return v.length >= 4 && v.length <= 30; },
    chars:  function(v){ return /^[a-zA-Z0-9_.]+$/.test(v); },
    start:  function(v){ return /^[a-zA-Z]/.test(v); },
    nodbl:  function(v){ return !/__/.test(v) && !(/\.\./.test(v)); },
    noend:  function(v){ return !/[_.]$/.test(v); }
};

function onUsernameInput(val) {
    val = val.trim();
    var allFormatOk = Object.keys(rules).every(function(k){ return rules[k](val); });

    // Update rule indicators
    Object.keys(rules).forEach(function(k){
        var el = document.getElementById('rule-'+k);
        if (!el) return;
        if (!val) { el.className = 'rule'; return; }
        el.className = 'rule ' + (rules[k](val) ? 'pass' : 'fail');
    });

    // Reset availability indicator
    var availEl = document.getElementById('rule-avail');
    var input   = document.getElementById('usernameInput');
    var icon    = document.getElementById('usernameIcon');

    if (!val || !allFormatOk) {
        usernameValid = false;
        input.className = 'username-input' + (val && !allFormatOk ? ' invalid' : '');
        icon.textContent = val && !allFormatOk ? '✗' : '';
        availEl.className = 'rule';
        availEl.querySelector('.rule-dot').style.background = '';
        return;
    }

    // Debounce availability check
    clearTimeout(usernameCheckTimer);
    input.className = 'username-input checking';
    icon.textContent = '⏳';
    availEl.className = 'rule';
    availEl.textContent = '';
    availEl.innerHTML = '<span class="rule-dot"></span>Checking…';

    usernameCheckTimer = setTimeout(function(){
        fetch('/Auth/CheckUsername?username=' + encodeURIComponent(val))
        .then(function(r){ return r.json(); })
        .then(function(d){
            if (d.available) {
                usernameValid = true;
                input.className = 'username-input valid';
                icon.textContent = '✓';
                availEl.className = 'rule pass';
                availEl.innerHTML = '<span class="rule-dot"></span>Username available ✓';
            } else {
                usernameValid = false;
                input.className = 'username-input invalid';
                icon.textContent = '✗';
                availEl.className = 'rule fail';
                availEl.innerHTML = '<span class="rule-dot"></span>Username taken';
            }
        }).catch(function(){
            usernameValid = false;
            input.className = 'username-input invalid';
            icon.textContent = '?';
            availEl.className = 'rule fail';
            availEl.innerHTML = '<span class="rule-dot"></span>Could not check';
        });
    }, 600);
}

// ✅ FEATURE 10: Password strength meter
function calcStrength(pw) {
    var score = 0;
    if (pw.length >= 8)  score++;
    if (pw.length >= 12) score++;
    if (/[A-Z]/.test(pw) && /[a-z]/.test(pw)) score++;
    if (/[0-9]/.test(pw)) score++;
    if (/[^A-Za-z0-9]/.test(pw)) score++;
    return score; // 0-5
}

function onPasswordInput(val) {
    var score = calcStrength(val);
    var segs  = [document.getElementById('seg1'),document.getElementById('seg2'),document.getElementById('seg3'),document.getElementById('seg4')];
    var label = document.getElementById('strengthLabel');
    var colors = ['#ef4444','#ef4444','#f59e0b','#10b981','#3b82f6'];
    var labels = ['','Weak','Moderate','Strong','Very Strong'];
    var classes= ['','weak','moderate','strong','very-strong'];

    segs.forEach(function(s){ s.style.background = 'rgba(255,255,255,0.08)'; });
    if (!val) { label.textContent=''; label.className='strength-label'; return; }

    var fill = Math.min(4, Math.ceil(score * 4 / 5));
    var col  = colors[Math.min(score, colors.length-1)];
    for (var i=0;i<fill;i++) segs[i].style.background = col;
    var lvl = Math.min(fill, labels.length-1);
    label.textContent = labels[lvl];
    label.className   = 'strength-label ' + (classes[lvl] || '');

    // Also re-run confirm match
    onConfirmInput(document.getElementById('confirmInput').value);
}

function onConfirmInput(val) {
    var hint = document.getElementById('matchHint');
    var pw   = document.getElementById('passwordInput').value;
    if (!val) { hint.textContent=''; hint.className='pw-match-hint'; return; }
    if (val === pw) { hint.textContent='✓ Passwords match'; hint.className='pw-match-hint match'; }
    else            { hint.textContent='✗ Passwords don\'t match'; hint.className='pw-match-hint no-match'; }
}

function togglePw(id, btn) {
    var input = document.getElementById(id);
    var show  = input.type === 'password';
    input.type = show ? 'text' : 'password';
    btn.querySelector('svg').innerHTML = show
        ? '<path d="M17.94 17.94A10.07 10.07 0 0112 20c-7 0-11-8-11-8a18.45 18.45 0 015.06-5.94"/><path d="M9.9 4.24A9.12 9.12 0 0112 4c7 0 11 8 11 8a18.5 18.5 0 01-2.16 3.19"/><line x1="1" y1="1" x2="23" y2="23"/>'
        : '<path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/>';
    btn.title = show ? 'Hide password' : 'Show password';
    btn.style.color = show ? '#f1f5f9' : 'rgba(241,245,249,0.45)';
}

function validateForm() {
    var pw  = document.getElementById('passwordInput').value;
    var cpw = document.getElementById('confirmInput').value;
    var un  = document.getElementById('usernameInput').value.trim();

    if (!usernameValid) {
        alert('Please choose a valid, available username.');
        document.getElementById('usernameInput').focus();
        return false;
    }
    if (pw.length < 6) {
        alert('Password must be at least 6 characters.');
        document.getElementById('passwordInput').focus();
        return false;
    }
    if (pw !== cpw) {
        alert('Passwords do not match.');
        document.getElementById('confirmInput').focus();
        return false;
    }
    return true;
}
</script>
</body>
</html>
