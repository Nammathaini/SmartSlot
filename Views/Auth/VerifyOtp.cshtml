@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <title>Verify OTP - SmartSlot</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <style>
        body {
            margin: 0;
            font-family: 'Segoe UI', sans-serif;
            background-image: url('https://i.pinimg.com/1200x/ea/3f/92/ea3f92fcdab7799f742c813cdb651463.jpg');
            background-size: cover;
            background-position: center;
            background-attachment: fixed;
        }
        body::before {
            content: '';
            position: fixed;
            width: 100%;
            height: 100%;
            background: rgba(0,0,0,0.75);
            z-index: 0;
        }
        .auth-container {
            position: relative;
            z-index: 1;
            height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
        }
        .auth-card {
            background: rgba(26,26,26,0.95);
            padding: 35px;
            width: 350px;
            border-radius: 12px;
            border: 1px solid #333;
        }
        .step-label {
            text-align: center;
            font-size: 12px;
            color: #888;
            margin-bottom: 6px;
            letter-spacing: 1px;
            text-transform: uppercase;
        }
        h2 {
            color: white;
            text-align: center;
            margin-bottom: 8px;
            font-size: 22px;
        }
        .desc {
            text-align: center;
            color: #aaa;
            font-size: 13px;
            margin-bottom: 24px;
            line-height: 1.5;
        }
        .phone-highlight {
            color: #28a745;
            font-weight: 600;
        }
        .steps {
            display: flex;
            justify-content: center;
            gap: 8px;
            margin-bottom: 24px;
        }
        .step-dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: #444;
        }
        .step-dot.done { background: #28a745; }
        .step-dot.active { background: #007bff; }

        /* OTP Input boxes */
        .otp-row {
            display: flex;
            gap: 10px;
            justify-content: center;
            margin: 16px 0 8px;
        }
        .otp-box {
            width: 46px;
            height: 54px;
            text-align: center;
            font-size: 22px;
            font-weight: 700;
            border-radius: 8px;
            border: 1px solid #444;
            background: #2a2a2a;
            color: white;
            outline: none;
        }
        .otp-box:focus {
            border-color: #007bff;
            box-shadow: 0 0 0 2px rgba(0,123,255,0.2);
        }
        /* Hidden actual input */
        #otpInput { display: none; }

        button[type="submit"] {
            width: 100%;
            padding: 12px;
            background: #007bff;
            border: none;
            border-radius: 6px;
            color: white;
            margin-top: 16px;
            cursor: pointer;
            font-size: 15px;
            font-weight: 600;
        }
        button[type="submit"]:hover { opacity: 0.9; }

        .error {
            color: #ff4d4d;
            text-align: center;
            margin-bottom: 10px;
            font-size: 13px;
            background: rgba(255,77,77,0.1);
            padding: 8px;
            border-radius: 6px;
        }
        .resend-row {
            text-align: center;
            margin-top: 18px;
            color: #aaa;
            font-size: 13px;
        }
        .resend-row form { display: inline; }
        .resend-btn {
            background: none;
            border: none;
            color: #28a745;
            cursor: pointer;
            font-size: 13px;
            padding: 0;
            width: auto;
            margin: 0;
        }
        .resend-btn:hover { text-decoration: underline; }
        .timer {
            color: #888;
            font-size: 12px;
            text-align: center;
            margin-top: 8px;
        }
        .back-link {
            text-align: center;
            margin-top: 12px;
            font-size: 13px;
        }
        .back-link a { color: #aaa; text-decoration: none; }
        .back-link a:hover { color: white; }
    </style>
</head>
<body>
    <div class="auth-container">
        <div class="auth-card">
            <div class="step-label">Step 2 of 3</div>
            <h2>Verify Phone</h2>
            <p class="desc">
                We sent a 6-digit OTP to<br/>
                <span class="phone-highlight">+91 @ViewBag.Phone</span>
            </p>

            <div class="steps">
                <div class="step-dot done"></div>
                <div class="step-dot active"></div>
                <div class="step-dot"></div>
            </div>

            @if (ViewBag.Error != null)
            {
                <div class="error">@ViewBag.Error</div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="error">@TempData["Error"]</div>
            }

            <form method="post" id="otpForm">
                <!-- Visual OTP boxes -->
                <div class="otp-row">
                    <input class="otp-box" maxlength="1" type="text" inputmode="numeric" id="b1" />
                    <input class="otp-box" maxlength="1" type="text" inputmode="numeric" id="b2" />
                    <input class="otp-box" maxlength="1" type="text" inputmode="numeric" id="b3" />
                    <input class="otp-box" maxlength="1" type="text" inputmode="numeric" id="b4" />
                    <input class="otp-box" maxlength="1" type="text" inputmode="numeric" id="b5" />
                    <input class="otp-box" maxlength="1" type="text" inputmode="numeric" id="b6" />
                </div>
                <!-- Hidden input that gets submitted -->
                <input type="hidden" name="otp" id="otpInput" />

                <button type="submit">Verify OTP</button>
            </form>

            <div class="timer" id="timerText">OTP expires in <span id="countdown">10:00</span></div>

            <div class="resend-row">
                Didn't receive it?
                <form method="post" action="/Auth/ResendOtp">
                    <button type="submit" class="resend-btn">Resend OTP</button>
                </form>
            </div>

            <div class="back-link">
                <a href="/Auth/Signup">← Change phone number</a>
            </div>
        </div>
    </div>

    <script>
        // Auto-focus and move between boxes
        const boxes = [
            document.getElementById('b1'),
            document.getElementById('b2'),
            document.getElementById('b3'),
            document.getElementById('b4'),
            document.getElementById('b5'),
            document.getElementById('b6')
        ];

        boxes.forEach((box, i) => {
            box.addEventListener('input', () => {
                box.value = box.value.replace(/\D/g, '');
                if (box.value && i < 5) boxes[i + 1].focus();
            });
            box.addEventListener('keydown', (e) => {
                if (e.key === 'Backspace' && !box.value && i > 0) boxes[i - 1].focus();
            });
        });

        boxes[0].focus();

        // On submit, combine boxes into hidden input
        document.getElementById('otpForm').addEventListener('submit', function () {
            const otp = boxes.map(b => b.value).join('');
            document.getElementById('otpInput').value = otp;
        });

        // Countdown timer
        let seconds = 600;
        const countdown = document.getElementById('countdown');
        const timer = setInterval(() => {
            seconds--;
            const m = Math.floor(seconds / 60).toString().padStart(2, '0');
            const s = (seconds % 60).toString().padStart(2, '0');
            countdown.textContent = `${m}:${s}`;
            if (seconds <= 0) {
                clearInterval(timer);
                document.getElementById('timerText').textContent = 'OTP has expired. Please resend.';
            }
        }, 1000);
    </script>
</body>
</html>
