@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>Create Account — SmartSlot</title>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@600;700;800&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
    <style>
        *,*::before,*::after{margin:0;padding:0;box-sizing:border-box;}
        :root{
            --primary:#2563EB;--green:#10b981;--green-dim:#059669;
            --dark:#0F172A;--border:rgba(255,255,255,0.08);
            --text:#f1f5f9;--text-dim:rgba(241,245,249,0.45);
        }
        html,body{height:100%;}
        body{
            font-family:'Inter',sans-serif;
            background:linear-gradient(135deg,#0F172A 0%,#111827 55%,#0f2820 100%);
            background-attachment:fixed;
            color:var(--text);
            display:flex;align-items:center;justify-content:center;
            min-height:100vh;padding:20px;position:relative;overflow:hidden;
        }
        body::before{
            content:'';position:fixed;inset:0;z-index:0;pointer-events:none;opacity:0.025;
            background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)'/%3E%3C/svg%3E");
            background-size:128px 128px;
        }
        .orb1{position:fixed;width:600px;height:600px;border-radius:50%;z-index:0;pointer-events:none;background:radial-gradient(circle,rgba(16,185,129,0.08) 0%,transparent 65%);bottom:-150px;left:-100px;}
        .orb2{position:fixed;width:500px;height:500px;border-radius:50%;z-index:0;pointer-events:none;background:radial-gradient(circle,rgba(37,99,235,0.06) 0%,transparent 65%);top:-100px;right:-80px;}
        .card{
            position:relative;z-index:1;width:100%;max-width:400px;
            background:rgba(30,41,59,0.65);
            backdrop-filter:blur(20px);-webkit-backdrop-filter:blur(20px);
            border:1px solid rgba(255,255,255,0.09);
            border-radius:24px;padding:44px 40px;
            box-shadow:0 24px 80px rgba(0,0,0,0.4),inset 0 1px 0 rgba(255,255,255,0.08);
            animation:cardIn 0.6s cubic-bezier(0.34,1.56,0.64,1) both;
        }
        @@keyframes cardIn{from{opacity:0;transform:translateY(24px) scale(0.97);}to{opacity:1;transform:translateY(0) scale(1);}}
        .logo{display:flex;align-items:center;gap:10px;margin-bottom:28px;justify-content:center;}
        .logo-mark{width:38px;height:38px;background:linear-gradient(135deg,#10b981,#059669);color:#fff;font-family:'Poppins',sans-serif;font-weight:700;font-size:19px;border-radius:11px;display:flex;align-items:center;justify-content:center;box-shadow:0 6px 18px rgba(16,185,129,0.35);filter:drop-shadow(0 0 6px rgba(16,185,129,0.4));}
        .logo-text{font-family:'Poppins',sans-serif;font-size:22px;font-weight:800;}
        .logo-text span{color:var(--green);}
        h2{font-family:'Poppins',sans-serif;font-size:26px;font-weight:700;margin-bottom:6px;text-align:center;}
        .subtitle{font-size:13px;color:var(--text-dim);text-align:center;margin-bottom:22px;}
        .steps{display:flex;align-items:center;justify-content:center;gap:8px;margin-bottom:6px;}
        .step-dot{width:32px;height:4px;border-radius:2px;background:var(--border);transition:background 0.3s;}
        .step-dot.active{background:var(--green);}
        .step-dot.done{background:rgba(16,185,129,0.35);}
        .step-label{display:flex;justify-content:center;font-size:11px;font-weight:600;letter-spacing:0.8px;text-transform:uppercase;color:var(--text-dim);margin-bottom:22px;}
        .step-label span{color:var(--green);}
        .alert-error{padding:11px 14px;border-radius:10px;font-size:13px;margin-bottom:16px;background:rgba(239,68,68,0.08);border:1px solid rgba(239,68,68,0.2);color:#fca5a5;}
        .field{margin-bottom:16px;}
        .field label{display:block;font-size:10px;font-weight:600;color:var(--text-dim);letter-spacing:1px;text-transform:uppercase;margin-bottom:7px;}

        /* Regular input */
        .field input[type="tel"]{
            width:100%;padding:13px 15px;
            background:#1F2937;border:1px solid rgba(255,255,255,0.06);
            border-radius:10px;color:var(--text);
            font-family:'Inter',sans-serif;font-size:14px;
            transition:border-color 0.2s,box-shadow 0.2s;outline:none;
        }
        .field input[type="tel"]:focus{border-color:var(--green);box-shadow:0 0 0 3px rgba(16,185,129,0.2);}
        .field input[type="tel"]::placeholder{color:var(--text-dim);}

        /* Password wrap with toggle */
        .pw-wrap{position:relative;display:flex;align-items:center;}
        .pw-wrap input{
            width:100%;padding:13px 44px 13px 15px;
            background:#1F2937;border:1px solid rgba(255,255,255,0.06);
            border-radius:10px;color:var(--text);
            font-family:'Inter',sans-serif;font-size:14px;
            transition:border-color 0.2s,box-shadow 0.2s;outline:none;
        }
        .pw-wrap input:focus{border-color:var(--green);box-shadow:0 0 0 3px rgba(16,185,129,0.2);}
        .pw-wrap input::placeholder{color:var(--text-dim);}
        .pw-toggle{
            position:absolute;right:12px;
            background:none;border:none;cursor:pointer;
            color:var(--text-dim);padding:4px;
            display:flex;align-items:center;justify-content:center;
            transition:color 0.2s;
        }
        .pw-toggle:hover{color:var(--text);}
        .pw-toggle svg{width:18px;height:18px;pointer-events:none;}

        .hint{font-size:12px;color:var(--text-dim);margin-top:6px;line-height:1.5;}
        .btn-submit{width:100%;padding:14px;margin-top:10px;background:linear-gradient(90deg,#10b981,#059669);color:#fff;border:none;border-radius:12px;font-family:'Inter',sans-serif;font-size:15px;font-weight:600;cursor:pointer;transition:all 0.2s;box-shadow:0 6px 20px rgba(16,185,129,0.3);}
        .btn-submit:hover{transform:translateY(-2px);box-shadow:0 12px 32px rgba(16,185,129,0.4);}
        .btn-submit:active{transform:translateY(0);}
        .divider{height:1px;background:var(--border);margin:22px 0;}
        .switch{text-align:center;font-size:13px;color:var(--text-dim);}
        .switch a{color:var(--primary);text-decoration:none;font-weight:500;}
        .switch a:hover{text-decoration:underline;}
    </style>
</head>
<body>
<div class="orb1"></div>
<div class="orb2"></div>
<div class="card">
    <div class="logo">
        <div class="logo-mark">P</div>
        <div class="logo-text">Smart<span>Slot</span></div>
    </div>
    <h2>Create Account</h2>
    <p class="subtitle">Enter your phone number to get started</p>
    <div class="step-label">Step <span>&nbsp;1&nbsp;</span> of 3</div>
    <div class="steps">
        <div class="step-dot active"></div>
        <div class="step-dot"></div>
        <div class="step-dot"></div>
    </div>
    @if(ViewBag.Error!=null){<div class="alert-error">&#9888; @ViewBag.Error</div>}
    <form method="post">
        <div class="field">
            <label>Phone Number</label>
            <input type="tel" name="phone" placeholder="10-digit mobile number" required pattern="[0-9]{10}" maxlength="10" autocomplete="tel"/>
        </div>
        @* If your signup also has a password field at this step, it will get the toggle below.
           Add more password fields as needed using the pw-wrap pattern. *@
        @if(ViewBag.ShowPassword == true)
        {
            <div class="field">
                <label>Password</label>
                <div class="pw-wrap">
                    <input type="password" name="password" id="signupPassword" placeholder="Create a password" required autocomplete="new-password"/>
                    <button type="button" class="pw-toggle" onclick="togglePw('signupPassword', this)" title="Show password">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
                            <circle cx="12" cy="12" r="3"/>
                        </svg>
                    </button>
                </div>
            </div>
        }
        <p class="hint">We'll send a verification code to this number.</p>
        <button type="submit" class="btn-submit">Send OTP &#8594;</button>
    </form>
    <div class="divider"></div>
    <div class="switch">Already have an account? <a href="/Auth/Signin">Sign In</a></div>
</div>
<script>
function togglePw(inputId, btn) {
    var input = document.getElementById(inputId);
    var isHidden = input.type === 'password';
    input.type = isHidden ? 'text' : 'password';
    btn.querySelector('svg').innerHTML = isHidden
        ? '<path d="M17.94 17.94A10.07 10.07 0 0112 20c-7 0-11-8-11-8a18.45 18.45 0 015.06-5.94"/><path d="M9.9 4.24A9.12 9.12 0 0112 4c7 0 11 8 11 8a18.5 18.5 0 01-2.16 3.19"/><line x1="1" y1="1" x2="23" y2="23"/>'
        : '<path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/>';
    btn.title = isHidden ? 'Hide password' : 'Show password';
    btn.style.color = isHidden ? 'var(--text)' : 'var(--text-dim)';
}
</script>
</body>
</html>
