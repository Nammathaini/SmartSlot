@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <title>Sign In - SmartSlot</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <style>
        * { box-sizing: border-box; }
        body {
            margin: 0;
            font-family: 'Segoe UI', sans-serif;
            background-image: url('https://i.pinimg.com/1200x/ea/3f/92/ea3f92fcdab7799f742c813cdb651463.jpg');
            background-size: cover;
            background-position: center;
            background-attachment: fixed;
        }
        body::before {
            content: '';
            position: fixed;
            width: 100%; height: 100%;
            background: rgba(0,0,0,0.75);
            z-index: 0;
        }
        .auth-container {
            position: relative; z-index: 1;
            height: 100vh;
            display: flex; justify-content: center; align-items: center;
        }
        .auth-card {
            background: rgba(26,26,26,0.95);
            padding: 35px; width: 350px;
            border-radius: 12px; border: 1px solid #333;
        }
        h2 { color: white; text-align: center; margin-bottom: 20px; }
        input {
            width: 100%; padding: 10px; margin: 8px 0;
            border-radius: 6px; border: 1px solid #444;
            background: #2a2a2a; color: white;
        }
        button {
            width: 100%; padding: 10px; background: #007bff;
            border: none; border-radius: 6px; color: white;
            margin-top: 10px; cursor: pointer; font-size: 15px;
        }
        button:hover { opacity: 0.9; }
        .error {
            color: #ff4d4d; text-align: center;
            margin-bottom: 10px; background: rgba(255,77,77,0.1);
            padding: 8px; border-radius: 6px; font-size: 13px;
        }
        .success {
            color: #4ade80; text-align: center;
            margin-bottom: 10px; background: rgba(74,222,128,0.1);
            padding: 8px; border-radius: 6px; font-size: 13px;
        }
        .switch { text-align: center; margin-top: 15px; color: white; font-size: 14px; }
        .switch a { color: #28a745; text-decoration: none; }
        .forgot { text-align: right; margin-top: 4px; }
        .forgot a { color: #aaa; font-size: 12px; text-decoration: none; }
        .forgot a:hover { color: #3b82f6; }
    </style>
</head>
<body>
    <div class="auth-container">
        <div class="auth-card">
            <h2>Sign In</h2>

            @if (ViewBag.Error != null)
            {
                <div class="error">@ViewBag.Error</div>
            }
            @if (TempData["Success"] != null)
            {
                <div class="success">✅ @TempData["Success"]</div>
            }

            <form method="post">
                <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
                <input type="text" name="username" placeholder="Username" required />
                <input type="password" name="password" placeholder="Password" required />
                <div class="forgot">
                    <a href="/Auth/ForgotPassword">Forgot password?</a>
                </div>
                <button type="submit">Sign In</button>
            </form>

            <div class="switch">
                Don't have account? <a href="/Auth/Signup">Sign Up</a>
            </div>
        </div>
    </div>
</body>
</html>
