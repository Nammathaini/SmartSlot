@{
    ViewData["Title"] = "Booked Parking Slots";
    var lat = ViewBag.Lat;
    var lon = ViewBag.Lon;
    var radius = ViewBag.Radius;
    var fromTime = ViewBag.FromTime as string;
    var toTime = ViewBag.ToTime as string;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>Booked Slots — SmartSlot</title>
    <link href="https://fonts.googleapis.com/css2?family=Syne:wght@600;700;800&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet">
    <style>
        *,*::before,*::after{margin:0;padding:0;box-sizing:border-box;}
        :root{
            --red:#ff5252;--amber:#ffab40;--green:#00e676;
            --dark:#080c10;--surface:#0d1117;
            --border:rgba(255,255,255,0.08);
        }
        body{font-family:'DM Sans',sans-serif;background:var(--dark);color:white;min-height:100vh;}

        .topbar{
            position:sticky;top:0;z-index:10;
            background:rgba(8,12,16,0.95);backdrop-filter:blur(12px);
            border-bottom:1px solid var(--border);
            padding:16px 20px;display:flex;align-items:center;gap:14px;
        }
        .back-btn{
            width:38px;height:38px;background:rgba(255,255,255,0.04);
            border:1px solid var(--border);border-radius:10px;
            color:white;font-size:18px;display:flex;align-items:center;justify-content:center;
            text-decoration:none;transition:all 0.2s;flex-shrink:0;
        }
        .back-btn:hover{background:rgba(255,255,255,0.1);color:white;}
        .topbar-title{font-family:'Syne',sans-serif;font-size:18px;font-weight:700;}
        .topbar-count{
            margin-left:auto;font-size:12px;color:rgba(255,255,255,0.4);
            background:rgba(255,255,255,0.04);border:1px solid var(--border);
            padding:4px 10px;border-radius:100px;
        }

        .toolbar{max-width:800px;margin:0 auto;padding:14px 20px;display:flex;gap:10px;flex-wrap:wrap;}
        .sort-select{
            background:var(--surface);border:1px solid var(--border);
            border-radius:10px;color:white;font-size:13px;padding:8px 14px;
            cursor:pointer;outline:none;
        }
        .filter-pill{
            display:flex;align-items:center;gap:6px;
            background:rgba(255,171,64,0.08);border:1px solid rgba(255,171,64,0.2);
            padding:6px 12px;border-radius:100px;font-size:12px;color:#ffab40;
        }

        .page{max-width:800px;margin:0 auto;padding:0 20px 60px;}
        .slots-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(340px,1fr));gap:14px;}

        /* Card */
        .slot-card{
            background:var(--surface);border:1px solid var(--border);
            border-radius:16px;padding:20px;
            animation:fadeUp 0.4s ease both;transition:all 0.25s;
        }
        .slot-card:hover{border-color:rgba(255,82,82,0.2);transform:translateY(-2px);}

        .card-header{display:flex;justify-content:space-between;align-items:flex-start;gap:10px;margin-bottom:14px;}
        .card-owner{font-family:'Syne',sans-serif;font-size:15px;font-weight:700;}
        .card-vehicle{font-size:12px;color:rgba(255,255,255,0.4);margin-top:3px;}
        .card-price{font-family:'Syne',sans-serif;font-size:18px;font-weight:800;color:var(--red);white-space:nowrap;}
        .card-price span{font-size:12px;font-weight:400;color:rgba(255,255,255,0.4);}

        .meta-grid{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-bottom:14px;}
        .meta-item{background:rgba(255,255,255,0.03);border:1px solid var(--border);border-radius:10px;padding:10px 12px;}
        .meta-lbl{font-size:10px;color:rgba(255,255,255,0.35);text-transform:uppercase;letter-spacing:0.5px;}
        .meta-val{font-size:12px;font-weight:500;margin-top:3px;}
        .meta-val.red{color:var(--red);}
        .meta-val.amber{color:var(--amber);}

        /* Countdown */
        .countdown-box{
            background:rgba(255,82,82,0.06);border:1px solid rgba(255,82,82,0.15);
            border-radius:10px;padding:10px 14px;
            display:flex;align-items:center;justify-content:space-between;
            margin-bottom:14px;
        }
        .countdown-lbl{font-size:11px;color:rgba(255,255,255,0.4);}
        .countdown-val{
            font-family:'Syne',sans-serif;font-size:15px;font-weight:700;
            color:var(--red);
        }
        .countdown-val.amber{color:var(--amber);}

        .card-footer{display:flex;align-items:center;justify-content:space-between;gap:10px;}
        .card-rating{font-size:13px;color:rgba(255,255,255,0.4);}

        .copy-btn{
            display:flex;align-items:center;gap:5px;
            padding:7px 12px;background:rgba(255,255,255,0.04);
            border:1px solid var(--border);border-radius:8px;
            color:rgba(255,255,255,0.5);font-size:12px;cursor:pointer;
            transition:all 0.15s;
        }
        .copy-btn:hover{background:rgba(255,255,255,0.08);color:white;}
        .copy-btn.copied{background:rgba(0,230,118,0.08);border-color:rgba(0,230,118,0.2);color:var(--green);}

        .notify-btn{
            display:flex;align-items:center;gap:6px;
            padding:9px 14px;
            background:rgba(255,171,64,0.08);border:1px solid rgba(255,171,64,0.2);
            color:var(--amber);font-size:12px;font-weight:600;
            border-radius:10px;cursor:pointer;transition:all 0.2s;
        }
        .notify-btn:hover{background:rgba(255,171,64,0.14);}
        .notify-btn.done{background:rgba(0,230,118,0.08);border-color:rgba(0,230,118,0.2);color:var(--green);cursor:default;}
        .notify-btn:disabled{opacity:0.5;cursor:not-allowed;}

        /* Skeleton */
        .skeleton-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(340px,1fr));gap:14px;}
        .skel-card{background:var(--surface);border:1px solid var(--border);border-radius:16px;padding:20px;}
        .skel{
            background:linear-gradient(90deg,rgba(255,255,255,0.04) 25%,rgba(255,255,255,0.08) 50%,rgba(255,255,255,0.04) 75%);
            background-size:200% 100%;animation:shimmer 1.5s infinite;border-radius:8px;
        }
        @@keyframes shimmer{0%{background-position:200% 0;}100%{background-position:-200% 0;}}

        .empty-state{
            grid-column:1/-1;text-align:center;padding:60px 20px;
            background:var(--surface);border:1px dashed var(--border);border-radius:16px;
        }
        .empty-icon{font-size:48px;margin-bottom:12px;opacity:0.4;}
        .empty-title{font-family:'Syne',sans-serif;font-size:18px;font-weight:700;margin-bottom:8px;}
        .empty-sub{font-size:14px;color:rgba(255,255,255,0.3);}

        /* Toast */
        .toast{
            position:fixed;bottom:24px;left:50%;
            transform:translateX(-50%) translateY(20px);
            background:var(--surface);border:1px solid var(--border);
            color:white;padding:12px 20px;border-radius:12px;
            font-size:14px;z-index:9999;opacity:0;transition:all 0.3s;
            pointer-events:none;white-space:nowrap;
        }
        .toast.show{opacity:1;transform:translateX(-50%) translateY(0);}

        @@keyframes fadeUp{from{opacity:0;transform:translateY(14px);}to{opacity:1;transform:translateY(0);}}
        @@media(max-width:500px){.slots-grid,.skeleton-grid{grid-template-columns:1fr;}}
    </style>
</head>
<body>

<div class="topbar">
    <a href="/Parking/Search" class="back-btn">←</a>
    <span class="topbar-title">🔴 Booked Slots</span>
    <span class="topbar-count" id="slotCount">Loading...</span>
</div>

<div class="toolbar">
    <select class="sort-select" id="sortOption" onchange="applySort()">
        <option value="">Sort By</option>
        <option value="price">Price: Low → High</option>
        <option value="distance">Distance: Near → Far</option>
        <option value="endtime">Ends Soonest</option>
    </select>
    @if (!string.IsNullOrEmpty(fromTime) && !string.IsNullOrEmpty(toTime))
    {
        <div class="filter-pill">📅 @DateTime.Parse(fromTime).ToString("dd MMM, hh:mm tt") → @DateTime.Parse(toTime).ToString("hh:mm tt")</div>
    }
</div>

<div class="page">
    <div class="skeleton-grid" id="skeletonGrid">
        @for (int i = 0; i < 3; i++)
        {
            <div class="skel-card">
                <div style="display:flex;justify-content:space-between;margin-bottom:14px;">
                    <div><div class="skel" style="height:18px;width:140px;"></div><div class="skel" style="height:12px;width:80px;margin-top:6px;"></div></div>
                    <div class="skel" style="height:24px;width:70px;border-radius:8px;"></div>
                </div>
                <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-bottom:14px;">
                    <div class="skel" style="height:52px;border-radius:10px;"></div>
                    <div class="skel" style="height:52px;border-radius:10px;"></div>
                    <div class="skel" style="height:52px;border-radius:10px;"></div>
                    <div class="skel" style="height:52px;border-radius:10px;"></div>
                </div>
                <div class="skel" style="height:38px;border-radius:10px;margin-bottom:14px;"></div>
                <div style="display:flex;justify-content:space-between;">
                    <div class="skel" style="height:14px;width:80px;"></div>
                    <div class="skel" style="height:32px;width:100px;border-radius:10px;"></div>
                </div>
            </div>
        }
    </div>
    <div class="slots-grid" id="slotsGrid" style="display:none;"></div>
</div>

<div class="toast" id="toast"></div>

<script>
var allSlots = [];
var notifiedSlots = {};
var fromTime = "@fromTime";
var toTime = "@toTime";

function getDistanceKm(lat1,lon1,lat2,lon2){
    var R=6371,dLat=(lat2-lat1)*Math.PI/180,dLon=(lon2-lon1)*Math.PI/180;
    var a=Math.sin(dLat/2)*Math.sin(dLat/2)+Math.cos(lat1*Math.PI/180)*Math.cos(lat2*Math.PI/180)*Math.sin(dLon/2)*Math.sin(dLon/2);
    return R*2*Math.atan2(Math.sqrt(a),Math.sqrt(1-a));
}

function showToast(msg,type){
    var t=document.getElementById('toast');
    t.textContent=msg;t.className='toast show';
    if(type==='success')t.style.borderColor='rgba(0,230,118,0.3)';
    else if(type==='error')t.style.borderColor='rgba(255,82,82,0.3)';
    else t.style.borderColor='rgba(255,255,255,0.08)';
    clearTimeout(window._toast);
    window._toast=setTimeout(function(){t.className='toast';},3500);
}

function copyPhone(phone,btn){
    navigator.clipboard.writeText(phone).then(function(){
        btn.className='copy-btn copied';
        btn.innerHTML='✓ Copied';
        setTimeout(function(){
            btn.className='copy-btn';
            btn.innerHTML='📋 '+phone;
        },2000);
    });
}

function notifyMe(slotId,bookingId,btn){
    btn.disabled=true;btn.textContent='Registering...';
    fetch('/Parking/NotifyMe',{
        method:'POST',
        headers:{'Content-Type':'application/json'},
        body:JSON.stringify({slotId:slotId,bookingId:bookingId})
    })
    .then(r=>r.json())
    .then(function(d){
        if(d.success){
            btn.className='notify-btn done';btn.innerHTML='✓ Will Notify';
            notifiedSlots[slotId]=true;
            showToast('✅ We will email you when this slot is free!','success');
        } else {
            btn.disabled=false;btn.innerHTML='🔔 Notify Me';
            showToast('❌ '+(d.message||'Failed'),'error');
        }
    })
    .catch(function(){btn.disabled=false;btn.innerHTML='🔔 Notify Me';showToast('❌ Something went wrong.','error');});
}

function formatCountdown(endTimeStr){
    var diff=new Date(endTimeStr)-new Date();
    if(diff<=0)return{text:'Expired',cls:''};
    var h=Math.floor(diff/3600000),m=Math.floor((diff%3600000)/60000),s=Math.floor((diff%60000)/1000);
    var cls=h<1?'amber':'';
    return{text:h+'h '+m+'m '+s+'s',cls:cls};
}

function renderSlots(slots){
    document.getElementById('skeletonGrid').style.display='none';
    var grid=document.getElementById('slotsGrid');
    grid.style.display='grid';grid.innerHTML='';
    document.getElementById('slotCount').textContent=slots.length+' slot'+(slots.length!==1?'s':'');

    if(slots.length===0){
        grid.innerHTML='<div class="empty-state"><div class="empty-icon">🅿️</div><div class="empty-title">No booked slots here</div><div class="empty-sub">All parking slots in this area are currently available.</div></div>';
        return;
    }

    slots.forEach(function(slot,i){
        var dist=slot._distanceValue;
        var alreadyNotified=notifiedSlots[slot.id]||false;
        var notifyHtml=alreadyNotified
            ?'<button class="notify-btn done" disabled>✓ Will Notify</button>'
            :'<button class="notify-btn" onclick="notifyMe('+slot.id+','+(slot.bookingId||0)+',this)">🔔 Notify Me</button>';

        var cd=slot.bookingTo?formatCountdown(slot.bookingTo):{text:'—',cls:''};

        var card=document.createElement('div');
        card.className='slot-card';
        card.style.animationDelay=(i*0.05)+'s';
        card.innerHTML=`
        <div class="card-header">
            <div>
                <div class="card-owner">${slot.ownerName}</div>
                <div class="card-vehicle">🚗 ${slot.vehicleType}</div>
            </div>
            <div class="card-price">₹${slot.pricePerHour}<span>/hr</span></div>
        </div>
        <div class="meta-grid">
            <div class="meta-item">
                <div class="meta-lbl">Distance</div>
                <div class="meta-val">📍 ${dist.toFixed(2)} km</div>
            </div>
            <div class="meta-item">
                <div class="meta-lbl">Rating</div>
                <div class="meta-val">${slot.averageRating?'⭐ '+slot.averageRating.toFixed(1):'No reviews'}</div>
            </div>
            <div class="meta-item">
                <div class="meta-lbl">Booked From</div>
                <div class="meta-val">${slot.bookingFrom?new Date(slot.bookingFrom).toLocaleString('en-IN',{hour:'2-digit',minute:'2-digit',day:'2-digit',month:'short'}):'—'}</div>
            </div>
            <div class="meta-item">
                <div class="meta-lbl">Booked To</div>
                <div class="meta-val red">${slot.bookingTo?new Date(slot.bookingTo).toLocaleString('en-IN',{hour:'2-digit',minute:'2-digit',day:'2-digit',month:'short'}):'—'}</div>
            </div>
        </div>
        <div class="countdown-box">
            <div class="countdown-lbl">⏱ Time Remaining</div>
            <div class="countdown-val ${cd.cls}" data-end="${slot.bookingTo}">${cd.text}</div>
        </div>
        <div class="card-footer">
            ${slot.ownerPhone?`<button class="copy-btn" onclick="copyPhone('${slot.ownerPhone}',this)">📋 ${slot.ownerPhone}</button>`:'<span></span>'}
            ${notifyHtml}
        </div>`;
        grid.appendChild(card);
    });

    startCountdowns();
}

function startCountdowns(){
    function tick(){
        document.querySelectorAll('.countdown-val[data-end]').forEach(function(el){
            var cd=formatCountdown(el.getAttribute('data-end'));
            el.textContent=cd.text;
            el.className='countdown-val'+(cd.cls?' '+cd.cls:'');
        });
    }
    tick();
    clearInterval(window._cdTimer);
    window._cdTimer=setInterval(tick,1000);
}

function applySort(){
    var opt=document.getElementById('sortOption').value;
    var sorted=[...allSlots];
    if(opt==='price')sorted.sort((a,b)=>a.pricePerHour-b.pricePerHour);
    if(opt==='distance')sorted.sort((a,b)=>a._distanceValue-b._distanceValue);
    if(opt==='endtime')sorted.sort((a,b)=>new Date(a.bookingTo)-new Date(b.bookingTo));
    renderSlots(sorted);
}

function loadData(){
    var url="/Parking/NearbySlots?lat=@lat&lon=@lon&radius=@radius";
    if(fromTime&&toTime)url+="&fromTime="+encodeURIComponent(fromTime)+"&toTime="+encodeURIComponent(toTime);
    fetch(url).then(r=>r.json()).then(function(data){
        var booked=data.filter(s=>s.isBooked);
        allSlots=booked.map(function(s){s._distanceValue=getDistanceKm(@lat,@lon,s.latitude,s.longitude);return s;});
        renderSlots(allSlots);
    }).catch(function(){showToast('⚠️ Failed to load','error');});
}

loadData();
setInterval(loadData,30000);
</script>
</body>
</html>
