@{
    ViewData["Title"] = "Add Parking Slot";
}

<style>
    body {
        background-image: url('https://i.pinimg.com/1200x/ea/3f/92/ea3f92fcdab7799f742c813cdb651463.jpg');
        background-size: cover;
        background-position: center;
        background-attachment: fixed;
        background-color: #000 !important;
        color: white !important;
        margin: 0;
        padding: 0;
    }

    body::before {
        content: '';
        position: fixed;
        top: 0; left: 0;
        width: 100%; height: 100%;
        background: rgba(0, 0, 0, 0.78);
        z-index: 0;
    }

    .navbar {
        background-color: #111 !important;
        position: relative;
        z-index: 2;
    }

    .navbar-brand { color: white !important; }

    .page-wrapper {
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 40px 20px;
        position: relative;
        z-index: 1;
    }

    h2 {
        color: white;
        text-align: center;
        margin-bottom: 30px;
        font-size: 2rem;
        letter-spacing: 1px;
    }

    .form-card {
        background-color: rgba(26, 26, 26, 0.9);
        border: 1px solid #333;
        border-radius: 12px;
        padding: 40px;
        width: 100%;
        max-width: 480px;
        position: relative;
        z-index: 1;
    }

    .form-card label {
        color: #ccc;
        display: block;
        margin-top: 15px;
        margin-bottom: 5px;
        font-size: 0.9rem;
    }

    .form-card input,
    .form-card select {
        width: 100%;
        padding: 10px;
        border-radius: 6px;
        border: 1px solid #444;
        background-color: #2a2a2a;
        color: white;
        font-size: 1rem;
        box-sizing: border-box;
    }

    .location-section {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 10px;
        margin-bottom: 20px;
        width: 100%;
        max-width: 480px;
        position: relative;
        z-index: 1;
    }

    .btn-location {
        padding: 10px 20px;
        background-color: #28a745;
        color: white;
        border: none;
        border-radius: 6px;
        cursor: pointer;
        font-size: 1rem;
        width: 100%;
    }

    .search-row {
        display: flex;
        gap: 8px;
        width: 100%;
    }

    .search-row input {
        flex: 1;
        padding: 10px;
        border-radius: 6px;
        border: 1px solid #444;
        background-color: #2a2a2a;
        color: white;
        font-size: 1rem;
    }

    .search-row button {
        padding: 10px 15px;
        background-color: #007bff;
        color: white;
        border: none;
        border-radius: 6px;
        cursor: pointer;
        font-size: 1rem;
    }

    .status-text {
        color: #aaa;
        font-size: 0.85rem;
        text-align: center;
    }

    .btn-submit {
        width: 100%;
        padding: 12px;
        margin-top: 25px;
        background-color: #28a745;
        color: white;
        border: none;
        border-radius: 6px;
        font-size: 1.1rem;
        cursor: pointer;
        font-weight: bold;
    }

    .btn-submit:hover { background-color: #218838; }

    .upload-box {
        border: 2px dashed #444;
        border-radius: 8px;
        padding: 15px;
        text-align: center;
        margin-top: 15px;
        background: rgba(0,0,0,0.3);
        cursor: pointer;
    }

    .upload-box:hover { border-color: #28a745; }

    .upload-box p {
        color: #aaa;
        font-size: 0.8rem;
        margin: 5px 0 0 0;
    }

    .ai-score-box {
        display: none;
        margin-top: 15px;
        padding: 15px;
        border-radius: 8px;
        text-align: center;
        border: 1px solid #444;
        background: rgba(0,0,0,0.4);
    }

    .badge-pill {
        display: inline-block;
        padding: 10px 28px;
        border-radius: 30px;
        font-size: 1.3rem;
        font-weight: bold;
        margin-bottom: 12px;
        letter-spacing: 1px;
    }

    .analyzing-box {
        display: none;
        text-align: center;
        padding: 15px;
        color: #aaa;
        font-size: 0.9rem;
    }

    .score-row {
        background: rgba(255,255,255,0.05);
        border-radius: 6px;
        padding: 10px 14px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 8px;
    }

    .score-label { color: white; font-size: 0.9rem; }
    .score-value { font-weight: bold; font-size: 0.9rem; }
</style>

<div class="page-wrapper">
    <h2>🅿️ Add Your Parking Slot</h2>

    <div class="location-section">
        <button type="button" class="btn-location" onclick="getLocation()">📍 Use My Live Location</button>
        <p id="locationStatus" class="status-text">Please fetch your location using one of the options below.</p>

        <div class="search-row">
            <input type="text" id="addressInput" placeholder="Search your area / address" />
            <button type="button" onclick="searchAddress()">🔍</button>
        </div>
        <p id="addressStatus" class="status-text"></p>
    </div>

    <div class="form-card">
        <form method="post" action="/Parking/AddSlot" id="slotForm" enctype="multipart/form-data">
            <input type="hidden" name="Latitude" id="latField" />
            <input type="hidden" name="Longitude" id="lonField" />
            <input type="hidden" name="ParkingScore" id="parkingScoreField" value="0" />
            <input type="hidden" name="ParkingBadge" id="parkingBadgeField" value="" />
            <input type="hidden" name="ParkingScoreDetails" id="parkingDetailsField" value="" />

            <label>Owner Name</label>
            <input type="text" name="OwnerName" required />

            <label>📞 Phone Number</label>
            <input type="tel" name="OwnerPhone"
                   placeholder="Enter your phone number"
                   maxlength="10"
                   pattern="[0-9]{10}"
                   title="Enter 10 digit phone number"
                   required />

            <label>Price Per Hour (₹)</label>
            <input type="number" name="PricePerHour" required />

            <label>Available From</label>
            <input type="datetime-local" name="AvailableFrom" required />

            <label>Available To</label>
            <input type="datetime-local" name="AvailableTo" required />

            <label>Vehicle Type</label>
            <select name="VehicleType">
                <option>Bike</option>
                <option>Car</option>
                <option>Both</option>
            </select>

            <label>Payment Preference</label>
            <select name="PaymentMode" id="paymentMode" onchange="toggleUpi()">
                <option value="Cash">cash payment only </option>
                <option value="UPI">UPI</option>
            </select>

            <div id="upiSection" style="display:none;">
                <label>Your UPI ID</label>
                <input type="text" name="OwnerUpiId" id="ownerUpiId" placeholder="example@upi" />
                <p id="upiStatus" class="status-text"></p>
            </div>

            <label>📸 Parking Slot Photo</label>
            <div class="upload-box" onclick="document.getElementById('parkingImage').click()">
                <p style="font-size:2rem;">📷</p>
                <p>Click to upload your parking slot photo</p>
                <p>Our AI will analyze and score your parking!</p>
                <input type="file" id="parkingImage" name="parkingImage"
                       accept="image/*" style="display:none;"
                       onchange="analyzeParking(this)" />
            </div>

            <div class="analyzing-box" id="analyzingBox">
                <p>🤖 AI is analyzing your parking slot...</p>
                <p>Please wait...</p>
            </div>

            <!-- AI Score Result -->
            <div class="ai-score-box" id="aiScoreBox">

                <!-- Badge Pill -->
                <div class="badge-pill" id="badgePill"></div>

                <!-- Sub label -->
                <div id="badgeSubText"
                     style="font-size:0.85rem; color:#aaa; margin-bottom:15px;">
                </div>

                <!-- Score Breakdown -->
                <div id="scoreBreakdown" style="width:100%; text-align:left;"></div>

                <!-- Preview Image -->
                <img id="previewImage" src="" alt="Parking Preview"
                     style="width:100%; border-radius:8px; margin-top:12px; display:none;" />
            </div>

            <button type="submit" class="btn-submit" onclick="return validateLocation()">
                ➕ Add Slot
            </button>
        </form>
    </div>
</div>

<script>
    function getLocation() {
        if (navigator.geolocation) {
            document.getElementById("locationStatus").innerText = "Fetching location...";
            navigator.geolocation.getCurrentPosition(
                function (position) {
                    setLocation(position.coords.latitude, position.coords.longitude);
                    document.getElementById("locationStatus").innerText = "✅ Live location fetched!";
                },
                function () {
                    document.getElementById("locationStatus").innerText = "❌ Permission denied.";
                }
            );
        }
    }

    function searchAddress() {
        var address = document.getElementById("addressInput").value.trim();
        if (!address) {
            document.getElementById("addressStatus").innerText = "⚠️ Please enter an address.";
            return;
        }
        document.getElementById("addressStatus").innerText = "Searching...";
        fetch(`https://nominatim.openstreetmap.org/search?q=${encodeURIComponent(address)}&format=json&limit=1`)
            .then(response => response.json())
            .then(data => {
                if (data.length === 0) {
                    document.getElementById("addressStatus").innerText = "❌ No related area found.";
                    setLocation("", "");
                } else {
                    setLocation(data[0].lat, data[0].lon);
                    document.getElementById("addressStatus").innerText = `✅ Found: ${data[0].display_name}`;
                }
            })
            .catch(() => {
                document.getElementById("addressStatus").innerText = "❌ Error searching. Try again.";
            });
    }

    function setLocation(lat, lon) {
        document.getElementById("latField").value = lat;
        document.getElementById("lonField").value = lon;
    }

    function getBadgeInfo(score) {
        if (score >= 80) return { label: "🥇 Premium", color: "#FFD700", sub: "Excellent parking slot!" };
        if (score >= 70) return { label: "🥈 Gold",    color: "#C0C0C0", sub: "Very good parking slot!" };
        if (score >= 50) return { label: "🥉 Silver",  color: "#CD7F32", sub: "Good parking slot" };
        if (score >= 30) return { label: "🏠 Basic",   color: "#28a745", sub: "Basic parking slot" };
        return              { label: "❌ Poor",        color: "#dc3545", sub: "Not recommended" };
    }

    function validateLocation() {
        var lat = document.getElementById("latField").value;
        if (!lat) {
            alert("⚠️ Please use live location or enter a valid address first!");
            return false;
        }

        var imageSelected = document.getElementById("parkingImage").files.length > 0;
        if (!imageSelected) {
            alert("⚠️ Please upload a parking slot photo first!");
            return false;
        }

        var score = parseInt(document.getElementById("parkingScoreField").value);
        if (score < 40) {
            alert("❌ Your parking slot score is too low to list! Please upload a better quality parking photo.");
            return false;
        }

        return true;
    }

    function toggleUpi() {
        var mode = document.getElementById("paymentMode").value;
        if (mode === "UPI") {
            document.getElementById("upiSection").style.display = "block";
        } else {
            document.getElementById("upiSection").style.display = "none";
            document.getElementById("ownerUpiId").value = "";
        }
    }

    function analyzeParking(input) {
        var file = input.files[0];
        if (!file) return;

        var reader = new FileReader();
        reader.onload = function(e) {
            document.getElementById("previewImage").src = e.target.result;
            document.getElementById("previewImage").style.display = "block";
        };
        reader.readAsDataURL(file);

        document.getElementById("analyzingBox").style.display = "block";
        document.getElementById("aiScoreBox").style.display = "none";

        var formData = new FormData();
        formData.append("image", file);

        fetch("/Parking/AnalyzeParking", {
            method: "POST",
            body: formData
        })
        .then(response => response.json())
        .then(data => {
            document.getElementById("analyzingBox").style.display = "none";
            document.getElementById("aiScoreBox").style.display = "block";

            var score = data.score;
            var badge = data.badge;
            var details = data.details;

            var info = getBadgeInfo(score);

            // Show badge pill
            document.getElementById("badgePill").innerText = info.label;
            document.getElementById("badgePill").style.background = info.color;
            document.getElementById("badgePill").style.color =
                score >= 70 ? "#000" : "white";

            // Sub text
            document.getElementById("badgeSubText").innerText = info.sub;

            // Update ai score box border color
            document.getElementById("aiScoreBox").style.borderColor = info.color;

            // Build breakdown boxes
            var lines = details.split("|").filter(l => l.trim() !== "");
            var breakdownHtml = "";

            lines.forEach(function(line) {
                var parts = line.split(":");
                var labelPart = parts[0].trim();
                var percent = parts[1] ? parts[1].trim() : "";

                var boxColor = "#28a745";
                if (labelPart.includes("Outdoor")) boxColor = "#ffc107";
                if (labelPart.includes("Basic"))   boxColor = "#17a2b8";
                if (labelPart.includes("❌"))       boxColor = "#dc3545";

                breakdownHtml += `
                <div class="score-row" style="border-left:4px solid ${boxColor};">
                    <span class="score-label">${labelPart}</span>
                    <span class="score-value" style="color:${boxColor};">${percent}</span>
                </div>`;
            });

            document.getElementById("scoreBreakdown").innerHTML = breakdownHtml;

            document.getElementById("parkingScoreField").value = score;
            document.getElementById("parkingBadgeField").value = badge;
            document.getElementById("parkingDetailsField").value = details;
        })
        .catch(() => {
            document.getElementById("analyzingBox").style.display = "none";
            document.getElementById("aiScoreBox").style.display = "block";
            document.getElementById("badgePill").innerText = "❌ Failed";
            document.getElementById("badgePill").style.background = "#dc3545";
            document.getElementById("badgePill").style.color = "white";
            document.getElementById("badgeSubText").innerText = "Could not analyze image";
            document.getElementById("scoreBreakdown").innerHTML =
                '<div class="score-row" style="border-left:4px solid #dc3545;"><span class="score-label">Please try again</span></div>';
        });
    }
</script>