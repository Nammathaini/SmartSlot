@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>SmartSlot</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; font-family: 'Segoe UI', sans-serif; }

        body {
            height: 100vh;
            background: url('/images/parking-bg.jpg') no-repeat center center fixed;
            background-size: cover;
        }

        .overlay {
            height: 100vh;
            width: 100%;
            background: rgba(0,0,0,0.6);
            display: flex;
            justify-content: center;
            align-items: center;
            position: relative;
        }

        .content { text-align: center; color: white; }

        .logo { font-size: 60px; font-weight: bold; margin-bottom: 15px; }
        .logo span { background: #4da6ff; padding: 8px 16px; border-radius: 10px; margin-right: 10px; }
        .subtitle { font-size: 20px; margin-bottom: 40px; opacity: 0.9; }

        .btn {
            display: block; width: 280px; margin: 15px auto; padding: 15px;
            border-radius: 10px; text-decoration: none; font-size: 18px;
            font-weight: 600; color: white; transition: 0.3s;
        }
        .green { background: #16a34a; }
        .green:hover { background: #15803d; }
        .blue { background: #2563eb; }
        .blue:hover { background: #1d4ed8; }

        /* Account Button */
        .account-btn {
            position: fixed; top: 20px; left: 20px; z-index: 1000;
            background: rgba(255,255,255,0.15); backdrop-filter: blur(10px);
            border: 1px solid rgba(255,255,255,0.3); border-radius: 50%;
            width: 48px; height: 48px; display: flex; align-items: center;
            justify-content: center; cursor: pointer; transition: background 0.2s;
        }
        .account-btn:hover { background: rgba(255,255,255,0.25); }
        .account-btn svg { width: 26px; height: 26px; fill: white; }

        /* Drawer Overlay */
        .drawer-overlay {
            display: none; position: fixed; inset: 0;
            background: rgba(0,0,0,0.5); z-index: 998;
        }
        .drawer-overlay.open { display: block; }

        /* Drawer */
        .drawer {
            position: fixed; top: 0; left: -300px; width: 270px;
            height: 100vh; background: #111; z-index: 999;
            transition: left 0.3s ease; display: flex; flex-direction: column;
        }
        .drawer.open { left: 0; }

        .drawer-header {
            background: linear-gradient(135deg, #1a1a2e, #16213e);
            padding: 40px 24px 24px; display: flex; align-items: center;
            gap: 14px; border-bottom: 1px solid #222;
        }
        .drawer-avatar {
            width: 52px; height: 52px; background: #2563eb; border-radius: 50%;
            display: flex; align-items: center; justify-content: center;
            font-size: 22px; font-weight: 700; color: white; flex-shrink: 0;
        }
        .drawer-username { color: white; font-size: 17px; font-weight: 600; }
        .drawer-subtitle { color: #aaa; font-size: 12px; margin-top: 2px; }

        .drawer-menu { flex: 1; padding: 16px 0; }

        .drawer-item {
            display: flex; align-items: center; gap: 16px; padding: 16px 24px;
            color: #ddd; text-decoration: none; font-size: 16px; font-weight: 500;
            transition: background 0.2s, color 0.2s; cursor: pointer;
            border: none; background: none; width: 100%; text-align: left;
        }
        .drawer-item:hover { background: rgba(255,255,255,0.07); color: white; }

        .drawer-item .icon {
            width: 36px; height: 36px; border-radius: 10px;
            display: flex; align-items: center; justify-content: center;
            font-size: 18px; flex-shrink: 0;
        }
        .icon-dashboard { background: rgba(37,99,235,0.25); }
        .icon-profile   { background: rgba(16,163,74,0.25); }
        .icon-settings  { background: rgba(156,163,175,0.2); }

        .drawer-divider { height: 1px; background: #222; margin: 8px 24px; }

        .drawer-footer { padding: 20px 24px; border-top: 1px solid #222; }

        .logout-btn {
            display: flex; align-items: center; gap: 16px; padding: 14px 0;
            color: #f87171; text-decoration: none; font-size: 15px; font-weight: 500;
            background: none; border: none; width: 100%; cursor: pointer;
        }
        .logout-btn .icon {
            width: 36px; height: 36px; border-radius: 10px;
            display: flex; align-items: center; justify-content: center;
            font-size: 18px; background: rgba(220,38,38,0.2);
        }

        /* Settings Panel */
        .settings-panel {
            position: fixed; top: 0; left: -320px; width: 270px;
            height: 100vh; background: #111; z-index: 1000;
            transition: left 0.3s ease; display: flex; flex-direction: column;
        }
        .settings-panel.open { left: 0; }

        .settings-header {
            background: linear-gradient(135deg, #1a1a2e, #16213e);
            padding: 40px 24px 20px; display: flex; align-items: center;
            gap: 12px; border-bottom: 1px solid #222;
        }
        .back-btn {
            background: rgba(255,255,255,0.1); border: none; color: white;
            width: 34px; height: 34px; border-radius: 8px; font-size: 16px;
            cursor: pointer; display: flex; align-items: center; justify-content: center;
        }
        .back-btn:hover { background: rgba(255,255,255,0.2); }
        .settings-title { color: white; font-size: 18px; font-weight: 700; }

        .settings-body { flex: 1; padding: 20px 0; }

        .settings-item {
            display: flex; align-items: center; gap: 16px; padding: 18px 24px;
            color: #ddd; font-size: 15px; font-weight: 500; cursor: pointer;
            border: none; background: none; width: 100%; text-align: left;
            transition: background 0.2s; text-decoration: none;
        }
        .settings-item:hover { background: rgba(255,255,255,0.07); color: white; }
        .settings-item.danger { color: #f87171; }
        .settings-item.danger:hover { background: rgba(220,38,38,0.08); }

        .settings-item .icon {
            width: 36px; height: 36px; border-radius: 10px;
            display: flex; align-items: center; justify-content: center; font-size: 18px;
        }
        .icon-reset  { background: rgba(59,130,246,0.2); }
        .icon-delete { background: rgba(220,38,38,0.2); }

        /* Delete Confirm Modal */
        .modal-bg {
            display: none; position: fixed; inset: 0;
            background: rgba(0,0,0,0.75); z-index: 2000;
            justify-content: center; align-items: center;
        }
        .modal-bg.open { display: flex; }

        .modal {
            background: #1a1a1a; border: 1px solid #333; border-radius: 14px;
            padding: 32px 28px; width: 300px; text-align: center;
        }
        .modal-icon { font-size: 40px; margin-bottom: 14px; }
        .modal h3 { color: white; font-size: 18px; margin-bottom: 10px; }
        .modal p { color: #aaa; font-size: 13px; line-height: 1.5; margin-bottom: 24px; }
        .modal-btns { display: flex; gap: 10px; }

        .modal-cancel {
            flex: 1; padding: 11px; background: #2a2a2a; border: 1px solid #444;
            border-radius: 8px; color: #ddd; font-size: 14px; cursor: pointer;
        }
        .modal-cancel:hover { background: #333; }

        .modal-confirm {
            flex: 1; padding: 11px; background: #dc2626; border: none;
            border-radius: 8px; color: white; font-size: 14px; font-weight: 600; cursor: pointer;
        }
        .modal-confirm:hover { background: #b91c1c; }
    </style>
</head>

<body>
    <!-- Account Icon -->
    <button class="account-btn" onclick="openDrawer()" title="Account">
        <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path d="M12 12c2.7 0 4.8-2.1 4.8-4.8S14.7 2.4 12 2.4 7.2 4.5 7.2 7.2 9.3 12 12 12zm0 2.4c-3.2 0-9.6 1.6-9.6 4.8v2.4h19.2v-2.4c0-3.2-6.4-4.8-9.6-4.8z"/>
        </svg>
    </button>

    <!-- Drawer Overlay -->
    <div class="drawer-overlay" id="drawerOverlay" onclick="closeAll()"></div>

    <!-- Main Drawer -->
    <div class="drawer" id="drawer">
        <div class="drawer-header">
            <div class="drawer-avatar">@(ViewBag.Username != null ? ViewBag.Username.ToString().Substring(0,1).ToUpper() : "?")</div>
            <div>
                <div class="drawer-username">@(ViewBag.Username ?? "Guest")</div>
                <div class="drawer-subtitle">SmartSlot Member</div>
            </div>
        </div>

        <div class="drawer-menu">
            <a href="/Parking/Dashboard" class="drawer-item">
                <span class="icon icon-dashboard">📊</span>
                Dashboard
            </a>
            <a href="/Parking/Profile" class="drawer-item">
                <span class="icon icon-profile">👤</span>
                Profile
            </a>
            <button class="drawer-item" onclick="openSettings()">
                <span class="icon icon-settings">⚙️</span>
                Settings
            </button>
        </div>

        <div class="drawer-footer">
            <a href="/Auth/Logout" class="logout-btn">
                <span class="icon">🚪</span>
                Sign Out
            </a>
        </div>
    </div>

    <!-- Settings Panel (slides over drawer) -->
    <div class="settings-panel" id="settingsPanel">
        <div class="settings-header">
            <button class="back-btn" onclick="closeSettings()">←</button>
            <span class="settings-title">⚙️ Settings</span>
        </div>
        <div class="settings-body">
            <a href="/Auth/ResetPassword" class="settings-item">
                <span class="icon icon-reset">🔑</span>
                Reset Password
            </a>
            <div class="drawer-divider"></div>
            <button class="settings-item danger" onclick="showDeleteModal()">
                <span class="icon icon-delete">🗑️</span>
                Delete Account
            </button>
        </div>
    </div>

    <!-- Delete Confirm Modal -->
    <div class="modal-bg" id="deleteModal">
        <div class="modal">
            <div class="modal-icon">⚠️</div>
            <h3>Delete Account?</h3>
            <p>This will permanently delete your account and all data. This cannot be undone.</p>
            <div class="modal-btns">
                <button class="modal-cancel" onclick="hideDeleteModal()">Cancel</button>
                <form method="post" action="/Auth/DeleteAccount" style="flex:1">
                    <button type="submit" class="modal-confirm" style="width:100%">Delete</button>
                </form>
            </div>
        </div>
    </div>

    <!-- Main Landing -->
    <div class="overlay">
        <div class="content">
            <div class="logo"><span>P</span> SmartSlot</div>
            <div class="subtitle">Find & Rent Residential Parking Slots Near You</div>
            <a href="/Parking/AddSlot" class="btn green">🏠 Add Your Parking Slot</a>
            <a href="/Parking/Search" class="btn blue">🔍 Find Parking Near Me</a>
        </div>
    </div>

    <script>
        function openDrawer() {
            document.getElementById('drawer').classList.add('open');
            document.getElementById('drawerOverlay').classList.add('open');
        }
        function closeAll() {
            document.getElementById('drawer').classList.remove('open');
            document.getElementById('drawerOverlay').classList.remove('open');
            document.getElementById('settingsPanel').classList.remove('open');
        }
        function openSettings() {
            document.getElementById('settingsPanel').classList.add('open');
        }
        function closeSettings() {
            document.getElementById('settingsPanel').classList.remove('open');
        }
        function showDeleteModal() {
            document.getElementById('deleteModal').classList.add('open');
        }
        function hideDeleteModal() {
            document.getElementById('deleteModal').classList.remove('open');
        }
    </script>
</body>
</html>
