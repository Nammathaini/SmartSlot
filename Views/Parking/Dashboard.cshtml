@{
    ViewData["Title"] = "Dashboard";
    Layout = "_Layout";
    var slots = ViewBag.MySlots as List<SmartSlot.Models.ParkingSlot> ?? new List<SmartSlot.Models.ParkingSlot>();
    var bookings = (ViewBag.MyBookings as System.Collections.IEnumerable)?.Cast<dynamic>().ToList() ?? new List<dynamic>();
    var istNow = DateTime.UtcNow.AddHours(5.5);
    var utcNow = DateTime.UtcNow;
    var activeBookings = bookings.Where(b => ((DateTime)b.BookingTo) > utcNow && !(bool)b.ExitConfirmed && !(bool)b.IsCancelled).ToList();
    var totalBooked = bookings.Count;

    // Penalty: bookings where overdue > 15 mins and not yet exit confirmed
    var penaltyBookings = bookings.Where(b =>
        !(bool)b.ExitConfirmed &&
        !(bool)b.IsCancelled &&
        ((DateTime)b.BookingTo).AddMinutes(15) < utcNow
    ).ToList();
}

<script src="https://cdn.jsdelivr.net/npm/qrcodejs@1.0.0/qrcode.min.js"></script>

<style>
    *,*::before,*::after{margin:0;padding:0;box-sizing:border-box;}
    :root{
        --primary:#2563EB;--green:#10b981;--red:#ef4444;--amber:#f59e0b;
        --surface:rgba(30,41,59,0.65);--border:rgba(255,255,255,0.08);
        --text:#f1f5f9;--text-dim:rgba(241,245,249,0.45);
    }
    .topbar{position:sticky;top:0;z-index:10;background:rgba(15,23,42,0.85);backdrop-filter:blur(20px);border-bottom:1px solid var(--border);padding:15px 24px;display:flex;align-items:center;gap:14px;}
    .back-btn{width:38px;height:38px;background:rgba(255,255,255,0.04);border:1px solid var(--border);border-radius:10px;color:var(--text);font-size:16px;display:flex;align-items:center;justify-content:center;text-decoration:none;transition:all 0.2s;}
    .back-btn:hover{background:rgba(255,255,255,0.09);color:var(--text);}
    .topbar-title{font-family:'Poppins',sans-serif;font-size:18px;font-weight:700;}
    .topbar-user{margin-left:auto;font-size:13px;color:var(--text-dim);background:rgba(255,255,255,0.04);border:1px solid var(--border);padding:5px 12px;border-radius:100px;}
    .page{position:relative;z-index:1;max-width:680px;margin:0 auto;padding:28px 20px 60px;}
    .section-label{font-size:10px;font-weight:600;letter-spacing:1.5px;text-transform:uppercase;color:var(--text-dim);margin-bottom:14px;margin-top:32px;}
    .stats-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;}
    .stat-card{background:var(--surface);backdrop-filter:blur(14px);border:1px solid var(--border);border-radius:18px;padding:22px 16px;text-align:center;transition:all 0.2s;cursor:pointer;}
    .stat-card:hover{border-color:rgba(255,255,255,0.22);transform:translateY(-3px);box-shadow:0 12px 32px rgba(0,0,0,0.3);}
    .stat-card:hover .stat-hint{opacity:1;}
    .stat-num{font-family:'Poppins',sans-serif;font-size:38px;font-weight:800;line-height:1;}
    .stat-num.blue{color:var(--primary);}.stat-num.green{color:var(--green);}.stat-num.amber{color:var(--amber);}.stat-num.red{color:var(--red);}
    .stat-lbl{font-size:11px;color:var(--text-dim);margin-top:6px;font-weight:500;}
    .stat-hint{font-size:10px;color:rgba(255,255,255,0.25);margin-top:6px;opacity:0;transition:opacity 0.2s;}
    /* ✅ Penalty card — prominent red pulsing border */
    .penalty-card{background:rgba(239,68,68,0.08);border:1px solid rgba(239,68,68,0.35);border-radius:18px;padding:20px 18px;margin-top:14px;cursor:pointer;transition:all 0.2s;animation:penaltyPulse 2s ease infinite;}
    .penalty-card:hover{background:rgba(239,68,68,0.14);transform:translateY(-2px);box-shadow:0 8px 28px rgba(239,68,68,0.2);}
    @@keyframes penaltyPulse{0%,100%{border-color:rgba(239,68,68,0.35);}50%{border-color:rgba(239,68,68,0.7);}}
    .penalty-header{display:flex;align-items:center;gap:10px;margin-bottom:12px;}
    .penalty-icon{width:36px;height:36px;background:rgba(239,68,68,0.15);border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:18px;flex-shrink:0;}
    .penalty-title{font-family:'Poppins',sans-serif;font-size:14px;font-weight:700;color:#fca5a5;}
    .penalty-sub{font-size:11px;color:rgba(252,165,165,0.6);margin-top:2px;}
    .penalty-items{display:flex;flex-direction:column;gap:8px;}
    .penalty-item{background:rgba(239,68,68,0.06);border:1px solid rgba(239,68,68,0.18);border-radius:10px;padding:12px 14px;display:flex;align-items:center;justify-content:space-between;gap:10px;}
    .penalty-item-left{flex:1;min-width:0;}
    .penalty-item-slot{font-size:12px;font-weight:600;color:var(--text);}
    .penalty-item-meta{font-size:10px;color:var(--text-dim);margin-top:2px;}
    .penalty-timer{font-family:'Poppins',sans-serif;font-size:13px;font-weight:800;color:#ef4444;white-space:nowrap;}
    .penalty-amount{font-family:'Poppins',sans-serif;font-size:15px;font-weight:800;color:#ef4444;white-space:nowrap;}
    .quick-actions{display:grid;grid-template-columns:1fr 1fr;gap:10px;}
    .action-btn{display:flex;align-items:center;gap:11px;padding:15px 16px;background:var(--surface);backdrop-filter:blur(14px);border:1px solid var(--border);border-radius:14px;color:var(--text);text-decoration:none;font-size:13px;font-weight:500;transition:all 0.2s;}
    .action-btn:hover{background:rgba(255,255,255,0.07);border-color:rgba(255,255,255,0.14);color:var(--text);transform:translateY(-1px);}
    .action-icon{width:36px;height:36px;border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:17px;flex-shrink:0;}
    .modal-overlay{position:fixed;inset:0;z-index:200;background:rgba(0,0,0,0.7);backdrop-filter:blur(6px);display:flex;align-items:flex-end;justify-content:center;opacity:0;pointer-events:none;transition:opacity 0.25s;}
    .modal-overlay.open{opacity:1;pointer-events:all;}
    .modal-sheet{background:#1e293b;border:1px solid var(--border);border-radius:24px 24px 0 0;width:100%;max-width:680px;max-height:80vh;overflow-y:auto;padding:28px 24px 40px;transform:translateY(40px);transition:transform 0.3s cubic-bezier(0.34,1.56,0.64,1);}
    .modal-overlay.open .modal-sheet{transform:translateY(0);}
    .modal-handle{width:40px;height:4px;background:rgba(255,255,255,0.15);border-radius:4px;margin:0 auto 20px;}
    .modal-title{font-family:'Poppins',sans-serif;font-size:17px;font-weight:700;margin-bottom:20px;}
    .modal-close{float:right;background:rgba(255,255,255,0.06);border:1px solid var(--border);color:var(--text-dim);padding:4px 12px;border-radius:8px;font-size:12px;cursor:pointer;margin-top:-4px;}
    .modal-close:hover{background:rgba(255,255,255,0.12);color:var(--text);}
    .detail-card{background:rgba(15,23,42,0.6);border:1px solid var(--border);border-radius:14px;padding:16px 18px;margin-bottom:10px;}
    .dc-top{display:flex;align-items:center;gap:12px;}
    .dc-icon{width:40px;height:40px;border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:18px;flex-shrink:0;}
    .dc-body{flex:1;min-width:0;}
    .dc-title{font-size:13px;font-weight:600;}
    .dc-meta{font-size:11px;color:var(--text-dim);margin-top:3px;}
    .badge{font-size:11px;font-weight:600;padding:4px 10px;border-radius:100px;flex-shrink:0;}
    .badge-green{background:rgba(16,185,129,0.12);color:var(--green);}
    .badge-blue{background:rgba(37,99,235,0.12);color:#93c5fd;}
    .badge-red{background:rgba(239,68,68,0.12);color:var(--red);}
    .badge-amber{background:rgba(245,158,11,0.12);color:var(--amber);}
    .badge-qr{background:rgba(139,92,246,0.12);color:#a78bfa;font-size:10px;padding:3px 8px;border-radius:100px;font-weight:600;margin-left:6px;}
    .qr-section{margin-top:12px;padding-top:12px;border-top:1px solid rgba(255,255,255,0.06);display:flex;align-items:center;gap:14px;}
    .qr-box{background:white;border-radius:10px;padding:7px;flex-shrink:0;width:84px;height:84px;display:flex;align-items:center;justify-content:center;box-shadow:0 4px 14px rgba(0,0,0,0.3);}
    .qr-box canvas,.qr-box img{width:70px!important;height:70px!important;}
    .qr-info-title{font-size:11px;font-weight:600;color:#a78bfa;margin-bottom:3px;}
    .qr-info-sub{font-size:10px;color:var(--text-dim);line-height:1.5;}
    .qr-penalty-note{margin-top:7px;padding:7px 10px;background:rgba(239,68,68,0.08);border:1px solid rgba(239,68,68,0.2);border-radius:7px;font-size:10px;color:#fca5a5;}
    .btn-dl-qr{display:inline-flex;align-items:center;gap:6px;margin-top:10px;padding:8px 14px;background:rgba(139,92,246,0.15);border:1px solid rgba(139,92,246,0.35);border-radius:9px;color:#a78bfa;font-size:11px;font-weight:600;cursor:pointer;transition:all 0.2s;}
    .btn-dl-qr:hover{background:rgba(139,92,246,0.28);transform:translateY(-1px);}
    .empty-state{background:var(--surface);border:1px dashed var(--border);border-radius:14px;padding:32px 20px;text-align:center;}
    .empty-icon{font-size:36px;margin-bottom:8px;opacity:0.35;}
    .empty-text{font-size:13px;color:var(--text-dim);}
    .slot-photo{width:44px;height:44px;object-fit:cover;border-radius:8px;border:1px solid var(--border);}
    .slot-photo-placeholder{width:44px;height:44px;border-radius:8px;border:1px dashed rgba(255,255,255,0.1);display:flex;align-items:center;justify-content:center;font-size:18px;flex-shrink:0;}
    /* Penalty modal detail card */
    .penalty-detail-card{background:rgba(239,68,68,0.06);border:1px solid rgba(239,68,68,0.2);border-radius:14px;padding:16px 18px;margin-bottom:12px;}
    .penalty-role-badge{display:inline-flex;align-items:center;gap:5px;padding:3px 9px;border-radius:100px;font-size:10px;font-weight:700;}
    .role-customer{background:rgba(239,68,68,0.15);color:#fca5a5;}
    .role-owner{background:rgba(245,158,11,0.15);color:#fcd34d;}
    .live-timer{font-family:'Poppins',sans-serif;font-size:22px;font-weight:800;color:#ef4444;letter-spacing:1px;}
    .live-amount{font-family:'Poppins',sans-serif;font-size:20px;font-weight:800;color:#ef4444;}
</style>

<div class="topbar">
    <a href="/Parking/Index" class="back-btn">&#8592;</a>
    <span class="topbar-title">Dashboard</span>
    <span class="topbar-user">@(ViewBag.Username ?? "")</span>
</div>

<div class="page">
    <div class="section-label">Overview</div>
    <div class="stats-grid">
        <div class="stat-card" onclick="openModal('slots')">
            <div class="stat-num green">@slots.Count</div>
            <div class="stat-lbl">Slots Listed</div>
            <div class="stat-hint">tap to view</div>
        </div>
        <div class="stat-card" onclick="openModal('bookings')">
            <div class="stat-num blue">@totalBooked</div>
            <div class="stat-lbl">Total Booked</div>
            <div class="stat-hint">tap to view</div>
        </div>
        <div class="stat-card" onclick="openModal('active')">
            <div class="stat-num amber">@activeBookings.Count</div>
            <div class="stat-lbl">Active Now</div>
            <div class="stat-hint">tap to view</div>
        </div>
    </div>

    @* ✅ Penalty Box — shown only if there are overdue bookings *@
    @if (penaltyBookings.Any())
    {
        <div class="penalty-card" onclick="openModal('penalty')">
            <div class="penalty-header">
                <div class="penalty-icon">⚠️</div>
                <div>
                    <div class="penalty-title">⚠️ Penalty Running — @penaltyBookings.Count Overdue Booking(s)</div>
                    <div class="penalty-sub">Tap to view Owner &amp; Customer penalty timers</div>
                </div>
            </div>
            <div class="penalty-items">
                @foreach (var b in penaltyBookings)
                {
                    var slot = slots.FirstOrDefault(s => s.Id == (int)b.ParkingSlotId);
                    var pricePerHour = slot?.PricePerHour ?? 0;
                    var penaltyRate = pricePerHour * 2.0;
                    var overdueMinutes = (istNow - ((DateTime)b.BookingTo).AddHours(5.5)).TotalMinutes - 15;
                    if (overdueMinutes < 0) overdueMinutes = 0;
                    var penaltyAmount = Math.Round((overdueMinutes / 60.0) * penaltyRate, 2);
                    <div class="penalty-item">
                        <div class="penalty-item-left">
                            <div class="penalty-item-slot">Slot #@((int)b.ParkingSlotId) · @((string)b.VehicleNumber)</div>
                            <div class="penalty-item-meta">Ended: @((DateTime)b.BookingTo).AddHours(5.5).ToString("dd MMM, hh:mm tt")</div>
                        </div>
                        <div style="text-align:right;">
                            <div class="penalty-amount">₹@penaltyAmount.ToString("F0")</div>
                            <div style="font-size:10px;color:rgba(252,165,165,0.6);">&#64; ₹@penaltyRate/hr</div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }

    <div class="section-label">Quick Actions</div>
    <div class="quick-actions">
        <a href="/Parking/AddSlot" class="action-btn">
            <span class="action-icon" style="background:rgba(16,185,129,0.1)">&#10133;</span>Add Slot
        </a>
        <a href="#" class="action-btn" onclick="openModal('transactions');return false;">
            <span class="action-icon" style="background:rgba(139,92,246,0.1)">&#128179;</span>Transactions
        </a>
        <a href="/Parking/Search" class="action-btn">
            <span class="action-icon" style="background:rgba(37,99,235,0.1)">&#128269;</span>Find Parking
        </a>
        <a href="/Parking/Profile" class="action-btn">
            <span class="action-icon" style="background:rgba(245,158,11,0.1)">&#128100;</span>My Profile
        </a>
        <a href="/Auth/ResetPassword" class="action-btn">
            <span class="action-icon" style="background:rgba(239,68,68,0.1)">&#128273;</span>Reset Password
        </a>
    </div>
</div>

<div class="modal-overlay" id="modalOverlay" onclick="closeModalOnBg(event)">
    <div class="modal-sheet">
        <div class="modal-handle"></div>
        <div class="modal-title" id="modalTitle">
            Details
            <button class="modal-close" onclick="closeModal()">Close</button>
        </div>
        <div id="modalBody"></div>
    </div>
</div>

<script>
var slotsData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(slots.Select(s => new {
    id            = s.Id,
    ownerName     = s.OwnerName,
    vehicleType   = s.VehicleType,
    pricePerHour  = s.PricePerHour,
    paymentMode   = s.PaymentMode,
    exitMethod    = s.ExitMethod,
    isBooked      = s.IsBooked,
    qrToken       = s.QrToken ?? "",
    availableFrom = s.AvailableFrom.ToString("dd MMM, hh:mm tt"),
    availableTo   = s.AvailableTo.ToString("dd MMM, hh:mm tt"),
    imageBase64   = s.ParkingImageBase64 ?? ""
})));

var bookingsData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(bookings.Select(b => new {
    id              = (int)b.Id,
    parkingSlotId   = (int)b.ParkingSlotId,
    vehicleNumber   = (string)b.VehicleNumber,
    customerName    = (string)b.CustomerName,
    bookingFrom     = ((DateTime)b.BookingFrom).AddHours(5.5).ToString("dd MMM, hh:mm tt"),
    bookingTo       = ((DateTime)b.BookingTo).AddHours(5.5).ToString("dd MMM, hh:mm tt"),
    // Raw UTC ms for JS penalty timer
    bookingToUtcMs  = (long)(((DateTime)b.BookingTo) - new DateTime(1970,1,1,0,0,0,DateTimeKind.Utc)).TotalMilliseconds,
    isActive        = ((DateTime)b.BookingTo) > DateTime.UtcNow && !(bool)b.ExitConfirmed && !(bool)b.IsCancelled,
    exitConfirmed   = (bool)b.ExitConfirmed,
    isCancelled     = (bool)b.IsCancelled,
    penaltyApplied  = (bool)b.PenaltyApplied,
    penaltyAmount   = (decimal)(b.PenaltyAmount ?? 0),
    totalAmount     = (double)(Math.Ceiling(((DateTime)b.BookingTo - (DateTime)b.BookingFrom).TotalHours
                      * (ViewBag.MySlots as List<SmartSlot.Models.ParkingSlot> ?? new List<SmartSlot.Models.ParkingSlot>())
                      .Where(s => s.Id == (int)b.ParkingSlotId).Select(s=>s.PricePerHour).FirstOrDefault())),
    // ✅ Price of the booked slot — for customer-side penalty calculation
    slotPricePerHour = (ViewBag.AllSlotPrices as System.Collections.Generic.Dictionary<int,double> != null &&
                        (ViewBag.AllSlotPrices as System.Collections.Generic.Dictionary<int,double>).ContainsKey((int)b.ParkingSlotId))
                       ? (ViewBag.AllSlotPrices as System.Collections.Generic.Dictionary<int,double>)[(int)b.ParkingSlotId]
                       : 0.0
})));

var activeData = bookingsData.filter(function(b){ return b.isActive; });

// Build penalty rate map from slotsData (owner slots)
var slotPriceMap = {};
slotsData.forEach(function(s){ slotPriceMap[s.id] = s.pricePerHour; });
var mySlotIds = slotsData.map(function(s){ return s.id; });

// ✅ Owner-side: bookings on MY slots made by customers
var slotBookingsData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
    ((ViewBag.MySlotBookings as List<SmartSlot.Models.Booking>) ?? new List<SmartSlot.Models.Booking>())
    .Select(b => new {
        id             = b.Id,
        parkingSlotId  = b.ParkingSlotId,
        vehicleNumber  = b.VehicleNumber ?? "",
        customerName   = b.CustomerName ?? "",
        bookingFrom    = b.BookingFrom.AddHours(5.5).ToString("dd MMM, hh:mm tt"),
        bookingTo      = b.BookingTo.AddHours(5.5).ToString("dd MMM, hh:mm tt"),
        bookingToUtcMs = (long)(b.BookingTo - new DateTime(1970,1,1,0,0,0,DateTimeKind.Utc)).TotalMilliseconds,
        exitConfirmed  = b.ExitConfirmed,
        isCancelled    = b.IsCancelled,
        slotPricePerHour = (double)(slots.Where(s => s.Id == b.ParkingSlotId).Select(s => s.PricePerHour).FirstOrDefault())
    })));

// Customer penalty — bookings I made that are overdue
var customerPenaltyData = bookingsData.filter(function(b){
    if (b.exitConfirmed || b.isCancelled) return false;
    return Date.now() - b.bookingToUtcMs > 15 * 60 * 1000;
});

// Owner penalty — customers who booked MY slots and are overdue
var ownerPenaltyData = slotBookingsData.filter(function(b){
    if (b.exitConfirmed || b.isCancelled) return false;
    return Date.now() - b.bookingToUtcMs > 15 * 60 * 1000;
});

// Combined for penalty card count
var penaltyData = ownerPenaltyData.concat(customerPenaltyData);

function calcPenalty(b) {
    // Use slotPricePerHour if present (slotBookingsData), else slotPriceMap (slotsData)
    var pricePerHour = (b.slotPricePerHour > 0)
        ? b.slotPricePerHour
        : (slotPriceMap[b.parkingSlotId] || 0);
    var penaltyRate = pricePerHour * 2;
    var overdueMs = Date.now() - b.bookingToUtcMs - (15 * 60 * 1000);
    if (overdueMs < 0) overdueMs = 0;
    var overdueHours = overdueMs / 3600000;
    return { amount: Math.round(overdueHours * penaltyRate * 100) / 100, rate: penaltyRate, pricePerHour: pricePerHour };
}

function formatOverdue(ms) {
    if (ms <= 0) return '00:00:00';
    var totalSecs = Math.floor(ms / 1000);
    var hrs  = Math.floor(totalSecs / 3600);
    var mins = Math.floor((totalSecs % 3600) / 60);
    var secs = totalSecs % 60;
    return (hrs > 0 ? String(hrs).padStart(2,'0') + ':' : '')
         + String(mins).padStart(2,'0') + ':'
         + String(secs).padStart(2,'0');
}

var penaltyTimerInterval = null;

function openModal(type) {
    if (penaltyTimerInterval) { clearInterval(penaltyTimerInterval); penaltyTimerInterval = null; }

    var title = document.getElementById('modalTitle');
    var body  = document.getElementById('modalBody');
    var html  = '';

    if (type === 'penalty') {
        title.innerHTML = '⚠️ Penalty Details <button class="modal-close" onclick="closeModal()">Close</button>';

        // ── Tab UI ──
        html = '<div style="display:flex;gap:8px;margin-bottom:18px;">'
            + '<button id="tab-owner" onclick="switchPenaltyTab(\'owner\')" style="flex:1;padding:10px;border-radius:10px;border:1px solid rgba(245,158,11,0.4);background:rgba(245,158,11,0.15);color:#fcd34d;font-weight:700;font-size:13px;cursor:pointer;">🏠 As Owner (' + ownerPenaltyData.length + ')</button>'
            + '<button id="tab-customer" onclick="switchPenaltyTab(\'customer\')" style="flex:1;padding:10px;border-radius:10px;border:1px solid rgba(239,68,68,0.3);background:rgba(239,68,68,0.08);color:#fca5a5;font-weight:700;font-size:13px;cursor:pointer;">🚗 As Customer (' + customerPenaltyData.length + ')</button>'
            + '</div>'
            + '<div id="penalty-tab-owner"></div>'
            + '<div id="penalty-tab-customer" style="display:none;"></div>';

        body.innerHTML = html;
        document.getElementById('modalOverlay').classList.add('open');

        function buildPenaltyCards(data, prefix, isOwner) {
            if (!data.length) {
                return '<div class="empty-state"><div class="empty-icon">✅</div><div class="empty-text">' + (isOwner ? 'No customer penalties on your slots.' : 'You have no penalty bookings.') + '</div></div>';
            }
            var h = '';
            data.forEach(function(b, idx) {
                var p = calcPenalty(b);
                h += '<div class="penalty-detail-card" id="' + prefix + 'pcard-' + idx + '">'
                    + '<div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:10px;">'
                    + '<div>'
                    + '<div style="font-size:13px;font-weight:600;">Slot #' + b.parkingSlotId + ' · ' + b.vehicleNumber + '</div>'
                    + '<div style="font-size:11px;color:var(--text-dim);margin-top:2px;">Booking ended: ' + b.bookingTo + '</div>'
                    + '</div>'
                    + (isOwner ? '<span class="penalty-role-badge role-owner">🏠 Owner</span>' : '<span class="penalty-role-badge role-customer">🚗 Customer</span>')
                    + '</div>'
                    + '<div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:10px;">'
                    + '<div style="background:rgba(239,68,68,0.08);border:1px solid rgba(239,68,68,0.18);border-radius:10px;padding:12px;text-align:center;">'
                    + '<div style="font-size:10px;color:rgba(252,165,165,0.6);margin-bottom:4px;text-transform:uppercase;letter-spacing:0.5px;">Overdue Time</div>'
                    + '<div class="live-timer" id="' + prefix + 'timer-' + idx + '">--:--:--</div>'
                    + '</div>'
                    + '<div style="background:rgba(239,68,68,0.08);border:1px solid rgba(239,68,68,0.18);border-radius:10px;padding:12px;text-align:center;">'
                    + '<div style="font-size:10px;color:rgba(252,165,165,0.6);margin-bottom:4px;text-transform:uppercase;letter-spacing:0.5px;">Penalty Amount</div>'
                    + '<div class="live-amount" id="' + prefix + 'amount-' + idx + '">₹' + p.amount.toFixed(2) + '</div>'
                    + '</div>'
                    + '</div>'
                    + '<div style="font-size:11px;color:rgba(252,165,165,0.55);padding:8px 10px;background:rgba(239,68,68,0.06);border-radius:8px;">'
                    + '⚠️ Rate: ₹' + p.rate + '/hr (2× slot price ₹' + p.pricePerHour + '/hr) · Grace: 15 mins'
                    + (isOwner ? '<br>💰 This penalty amount is owed to you by the customer.' : '<br>💳 Please pay this penalty to the slot owner in cash or UPI.')
                    + '</div>'
                    + '</div>';
            });
            return h;
        }

        document.getElementById('penalty-tab-owner').innerHTML    = buildPenaltyCards(ownerPenaltyData,    'own', true);
        document.getElementById('penalty-tab-customer').innerHTML = buildPenaltyCards(customerPenaltyData, 'cus', false);

        // Active tab = whichever has data, default owner
        switchPenaltyTab(customerPenaltyData.length > 0 && ownerPenaltyData.length === 0 ? 'customer' : 'owner');

        function tickPenalty() {
            // Owner timers
            ownerPenaltyData.forEach(function(b, idx) {
                var overdueMs = Math.max(0, Date.now() - b.bookingToUtcMs - 15*60*1000);
                var t = document.getElementById('owntimer-' + idx);
                var a = document.getElementById('ownamount-' + idx);
                if (t) t.textContent = formatOverdue(overdueMs);
                if (a) a.textContent = '₹' + calcPenalty(b).amount.toFixed(2);
            });
            // Customer timers
            customerPenaltyData.forEach(function(b, idx) {
                var overdueMs = Math.max(0, Date.now() - b.bookingToUtcMs - 15*60*1000);
                var t = document.getElementById('custimer-' + idx);
                var a = document.getElementById('cusamount-' + idx);
                if (t) t.textContent = formatOverdue(overdueMs);
                if (a) a.textContent = '₹' + calcPenalty(b).amount.toFixed(2);
            });
        }
        tickPenalty();
        penaltyTimerInterval = setInterval(tickPenalty, 1000);
        return;
    }

    if (type === 'slots') {
        title.innerHTML = 'Your Listed Slots <button class="modal-close" onclick="closeModal()">Close</button>';
        if (!slotsData.length) {
            html = '<div class="empty-state"><div class="empty-icon">🅿️</div><div class="empty-text">No slots listed yet. <a href="/Parking/AddSlot" style="color:#3B82F6;">Add one now!</a></div></div>';
        } else {
            slotsData.forEach(function(s) {
                var photoHtml = s.imageBase64
                    ? '<img class="slot-photo" src="' + s.imageBase64 + '" alt="Slot"/>'
                    : '<div class="slot-photo-placeholder">🅿️</div>';
                var qrHtml = '';
                if (s.qrToken) {
                    qrHtml = '<div class="qr-section">'
                        + '<div class="qr-box" id="mqr-' + s.id + '"></div>'
                        + '<div>'
                        + '<div class="qr-info-title">Exit QR Code</div>'
                        + '<div class="qr-info-sub">Display this QR at your slot. Customer scans to confirm exit.</div>'
                        + '<div class="qr-penalty-note">No scan after booking ends = penalty applies</div>'
                        + '<button class="btn-dl-qr" onclick="downloadQR(' + s.id + ', \'' + s.ownerName.replace(/'/g,"\\'") + '\')">&#11123; Download QR</button>'
                        + '</div></div>';
                }
                html += '<div class="detail-card">'
                    + '<div class="dc-top">'
                    + photoHtml
                    + '<div class="dc-body" style="margin-left:10px;">'
                    + '<div class="dc-title">' + s.ownerName + ' — ' + s.vehicleType
                    + ' <span class="badge-qr">QR Exit</span></div>'
                    + '<div class="dc-meta">Rs.' + s.pricePerHour + '/hr · ' + s.paymentMode + '</div>'
                    + '<div class="dc-meta">' + s.availableFrom + ' → ' + s.availableTo + '</div>'
                    + '</div>'
                    + (s.isBooked ? '<span class="badge badge-red">Booked</span>' : '<span class="badge badge-green">Available</span>')
                    + '</div>'
                    + qrHtml
                    + '</div>';
            });
        }

    } else if (type === 'bookings') {
        title.innerHTML = 'All Bookings <button class="modal-close" onclick="closeModal()">Close</button>';
        if (!bookingsData.length) {
            html = '<div class="empty-state"><div class="empty-icon">&#128269;</div><div class="empty-text">No bookings yet.</div></div>';
        } else {
            bookingsData.forEach(function(b) {
                var statusBadge = b.isCancelled
                    ? '<span class="badge badge-red">Cancelled</span>'
                    : b.exitConfirmed
                        ? '<span class="badge badge-green">Completed</span>'
                        : b.isActive
                            ? '<span class="badge badge-blue">Active</span>'
                            : '<span class="badge badge-red">Overdue</span>';
                var penaltyBadge = b.penaltyApplied && !b.exitConfirmed
                    ? '<div class="dc-meta" style="color:#ef4444;">⚠️ Penalty: ₹' + b.penaltyAmount.toFixed(0) + ' (last calculated)</div>'
                    : '';
                html += '<div class="detail-card">'
                    + '<div class="dc-top">'
                    + '<div class="dc-icon" style="background:rgba(37,99,235,0.1)">&#128273;</div>'
                    + '<div class="dc-body">'
                    + '<div class="dc-title">Slot #' + b.parkingSlotId + ' · ' + b.vehicleNumber + '</div>'
                    + '<div class="dc-meta">' + b.bookingFrom + ' → ' + b.bookingTo + '</div>'
                    + (b.exitConfirmed ? '<div class="dc-meta" style="color:#10b981;">&#10003; Exit Confirmed</div>' : '')
                    + penaltyBadge
                    + '</div>'
                    + statusBadge
                    + '</div></div>';
            });
        }

    } else if (type === 'active') {
        title.innerHTML = 'Active Now <button class="modal-close" onclick="closeModal()">Close</button>';
        if (!activeData.length) {
            html = '<div class="empty-state"><div class="empty-icon">&#9989;</div><div class="empty-text">No active bookings right now.</div></div>';
        } else {
            activeData.forEach(function(b) {
                html += '<div class="detail-card">'
                    + '<div class="dc-top">'
                    + '<div class="dc-icon" style="background:rgba(245,158,11,0.1)">&#9889;</div>'
                    + '<div class="dc-body">'
                    + '<div class="dc-title">Slot #' + b.parkingSlotId + ' · ' + b.vehicleNumber + '</div>'
                    + '<div class="dc-meta">' + b.bookingFrom + ' → ' + b.bookingTo + '</div>'
                    + '</div>'
                    + '<span class="badge badge-amber">Live</span>'
                    + '</div></div>';
            });
        }

    } else if (type === 'transactions') {
        title.innerHTML = 'Transaction History <button class="modal-close" onclick="closeModal()">Close</button>';
        var mySlotIds = slotsData.map(function(s){ return s.id; });
        var ownerBookings    = bookingsData.filter(function(b){ return mySlotIds.indexOf(b.parkingSlotId) !== -1; });
        var customerBookings = bookingsData.filter(function(b){ return mySlotIds.indexOf(b.parkingSlotId) === -1; });
        var totalEarned = ownerBookings.reduce(function(sum,b){ return sum+(b.totalAmount||0); }, 0);
        var totalSpent  = customerBookings.reduce(function(sum,b){ return sum+(b.totalAmount||0); }, 0);

        html += '<div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:24px;">'
            + '<div style="background:rgba(16,185,129,0.08);border:1px solid rgba(16,185,129,0.25);border-radius:14px;padding:18px;text-align:center;">'
            + '<div style="font-size:10px;color:#10b981;font-weight:700;text-transform:uppercase;letter-spacing:1px;margin-bottom:8px;">&#127968; As Owner</div>'
            + '<div style="font-family:Poppins,sans-serif;font-size:28px;font-weight:800;color:#10b981;">Rs.' + totalEarned.toFixed(0) + '</div>'
            + '<div style="font-size:11px;color:rgba(241,245,249,0.4);margin-top:6px;">Earned from ' + ownerBookings.length + ' booking(s)</div>'
            + '</div>'
            + '<div style="background:rgba(239,68,68,0.08);border:1px solid rgba(239,68,68,0.25);border-radius:14px;padding:18px;text-align:center;">'
            + '<div style="font-size:10px;color:#ef4444;font-weight:700;text-transform:uppercase;letter-spacing:1px;margin-bottom:8px;">&#128179; As Customer</div>'
            + '<div style="font-family:Poppins,sans-serif;font-size:28px;font-weight:800;color:#ef4444;">Rs.' + totalSpent.toFixed(0) + '</div>'
            + '<div style="font-size:11px;color:rgba(241,245,249,0.4);margin-top:6px;">Spent on ' + customerBookings.length + ' booking(s)</div>'
            + '</div></div>';

        if (ownerBookings.length) {
            html += '<div style="font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:1px;color:rgba(241,245,249,0.4);margin-bottom:10px;">Owner Earnings</div>';
            ownerBookings.forEach(function(b) {
                html += '<div class="detail-card" style="margin-bottom:10px;">'
                    + '<div class="dc-top">'
                    + '<div class="dc-icon" style="background:rgba(16,185,129,0.1)">&#127968;</div>'
                    + '<div class="dc-body">'
                    + '<div class="dc-title">Slot #' + b.parkingSlotId + ' — ' + b.customerName + '</div>'
                    + '<div class="dc-meta">' + b.bookingFrom + ' → ' + b.bookingTo + '</div>'
                    + '</div>'
                    + '<span style="font-family:Poppins,sans-serif;font-size:15px;font-weight:700;color:#10b981;white-space:nowrap;">+Rs.' + (b.totalAmount||0).toFixed(0) + '</span>'
                    + '</div></div>';
            });
        }
        if (customerBookings.length) {
            html += '<div style="font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:1px;color:rgba(241,245,249,0.4);margin:16px 0 10px;">Customer Spending</div>';
            customerBookings.forEach(function(b) {
                html += '<div class="detail-card" style="margin-bottom:10px;">'
                    + '<div class="dc-top">'
                    + '<div class="dc-icon" style="background:rgba(239,68,68,0.1)">&#128179;</div>'
                    + '<div class="dc-body">'
                    + '<div class="dc-title">Slot #' + b.parkingSlotId + ' — ' + b.vehicleNumber + '</div>'
                    + '<div class="dc-meta">' + b.bookingFrom + ' → ' + b.bookingTo + '</div>'
                    + '</div>'
                    + '<span style="font-family:Poppins,sans-serif;font-size:15px;font-weight:700;color:#ef4444;white-space:nowrap;">-Rs.' + (b.totalAmount||0).toFixed(0) + '</span>'
                    + '</div></div>';
            });
        }
        if (!ownerBookings.length && !customerBookings.length) {
            html += '<div class="empty-state"><div class="empty-icon">&#128179;</div><div class="empty-text">No transactions yet.</div></div>';
        }
    }

    body.innerHTML = html;
    document.getElementById('modalOverlay').classList.add('open');

    if (type === 'slots') {
        slotsData.forEach(function(s) {
            if (s.qrToken) {
                var el = document.getElementById('mqr-' + s.id);
                if (el && el.children.length === 0) {
                    new QRCode(el, {
                        text: 'https://smartslot-sc9u.onrender.com/Parking/ExitScan?token=' + s.qrToken,
                        width: 70, height: 70,
                        colorDark: "#000000", colorLight: "#ffffff",
                        correctLevel: QRCode.CorrectLevel.H
                    });
                }
            }
        });
    }
}

function downloadQR(slotId, ownerName) {
    var box = document.getElementById('mqr-' + slotId);
    if (!box) return;
    var canvas = box.querySelector('canvas');
    var img    = box.querySelector('img');
    var dataUrl = '';
    if (canvas) {
        var c = document.createElement('canvas');
        c.width = 200; c.height = 200;
        var ctx = c.getContext('2d');
        ctx.fillStyle = '#ffffff';
        ctx.fillRect(0,0,200,200);
        ctx.drawImage(canvas, 15, 15, 170, 170);
        dataUrl = c.toDataURL('image/png');
    } else if (img) {
        var c2 = document.createElement('canvas');
        c2.width = 200; c2.height = 200;
        var ctx2 = c2.getContext('2d');
        ctx2.fillStyle = '#ffffff';
        ctx2.fillRect(0,0,200,200);
        ctx2.drawImage(img, 15, 15, 170, 170);
        dataUrl = c2.toDataURL('image/png');
    }
    if (!dataUrl) return;
    var a = document.createElement('a');
    a.href = dataUrl;
    a.download = 'SmartSlot_QR_' + ownerName.replace(/\s+/g,'_') + '.png';
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
}

function switchPenaltyTab(tab) {
    var ownerTab    = document.getElementById('tab-owner');
    var customerTab = document.getElementById('tab-customer');
    var ownerPanel    = document.getElementById('penalty-tab-owner');
    var customerPanel = document.getElementById('penalty-tab-customer');
    if (!ownerTab) return;

    if (tab === 'owner') {
        ownerPanel.style.display    = 'block';
        customerPanel.style.display = 'none';
        ownerTab.style.background    = 'rgba(245,158,11,0.35)';
        ownerTab.style.borderColor   = 'rgba(245,158,11,0.8)';
        customerTab.style.background = 'rgba(239,68,68,0.08)';
        customerTab.style.borderColor= 'rgba(239,68,68,0.3)';
    } else {
        ownerPanel.style.display    = 'none';
        customerPanel.style.display = 'block';
        customerTab.style.background = 'rgba(239,68,68,0.3)';
        customerTab.style.borderColor= 'rgba(239,68,68,0.8)';
        ownerTab.style.background    = 'rgba(245,158,11,0.08)';
        ownerTab.style.borderColor   = 'rgba(245,158,11,0.3)';
    }
}

function closeModal() {
    if (penaltyTimerInterval) { clearInterval(penaltyTimerInterval); penaltyTimerInterval = null; }
    document.getElementById('modalOverlay').classList.remove('open');
}

function closeModalOnBg(e) {
    if (e.target === document.getElementById('modalOverlay')) closeModal();
}
</script>
