@{
    Layout = null;
    var slots = ViewBag.MySlots as List<SmartSlot.Models.ParkingSlot> ?? new List<SmartSlot.Models.ParkingSlot>();
    var bookings = (ViewBag.MyBookings as System.Collections.IEnumerable)?.Cast<dynamic>().ToList() ?? new List<dynamic>();
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Dashboard - SmartSlot</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; font-family: 'Segoe UI', sans-serif; }

        body {
            background: #0f0f0f;
            color: white;
            min-height: 100vh;
        }

        .topbar {
            background: #1a1a1a;
            border-bottom: 1px solid #222;
            padding: 16px 24px;
            display: flex;
            align-items: center;
            gap: 16px;
            position: sticky;
            top: 0;
            z-index: 10;
        }

        .back-btn {
            background: rgba(255,255,255,0.08);
            border: none;
            color: white;
            width: 38px;
            height: 38px;
            border-radius: 10px;
            font-size: 18px;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            text-decoration: none;
        }

        .back-btn:hover { background: rgba(255,255,255,0.15); }

        .topbar-title {
            font-size: 20px;
            font-weight: 700;
        }

        .page {
            max-width: 700px;
            margin: 0 auto;
            padding: 28px 20px;
        }

        /* Stats Row */
        .stats-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 16px;
            margin-bottom: 32px;
        }

        .stat-card {
            background: #1a1a1a;
            border: 1px solid #2a2a2a;
            border-radius: 14px;
            padding: 22px;
            text-align: center;
        }

        .stat-number {
            font-size: 42px;
            font-weight: 800;
            line-height: 1;
        }

        .stat-number.blue { color: #3b82f6; }
        .stat-number.green { color: #22c55e; }

        .stat-label {
            font-size: 13px;
            color: #888;
            margin-top: 8px;
            font-weight: 500;
        }

        /* Section */
        .section-title {
            font-size: 17px;
            font-weight: 700;
            margin-bottom: 14px;
            color: #eee;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .section { margin-bottom: 32px; }

        /* Cards */
        .card {
            background: #1a1a1a;
            border: 1px solid #2a2a2a;
            border-radius: 12px;
            padding: 16px 18px;
            margin-bottom: 10px;
        }

        .card-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .card-title {
            font-size: 15px;
            font-weight: 600;
            color: #eee;
        }

        .card-sub {
            font-size: 12px;
            color: #777;
            margin-top: 4px;
        }

        .badge {
            font-size: 11px;
            padding: 4px 10px;
            border-radius: 20px;
            font-weight: 600;
        }

        .badge-green { background: rgba(34,197,94,0.15); color: #22c55e; }
        .badge-blue  { background: rgba(59,130,246,0.15); color: #3b82f6; }
        .badge-red   { background: rgba(239,68,68,0.15); color: #ef4444; }

        .empty {
            text-align: center;
            padding: 32px;
            color: #555;
            font-size: 14px;
        }

        .empty-icon { font-size: 36px; margin-bottom: 10px; }
    </style>
</head>
<body>

    <div class="topbar">
        <a href="/Parking/Index" class="back-btn">←</a>
        <span class="topbar-title">📊 Dashboard</span>
    </div>

    <div class="page">

        <!-- Stats -->
        <div class="stats-row">
            <div class="stat-card">
                <div class="stat-number blue">@slots.Count</div>
                <div class="stat-label">Slots Added by You</div>
            </div>
            <div class="stat-card">
                <div class="stat-number green">@bookings.Count</div>
                <div class="stat-label">Slots Booked by You</div>
            </div>
        </div>

        <!-- My Slots -->
        <div class="section">
            <div class="section-title">🏠 My Parking Slots</div>

            @if (slots.Count == 0)
            {
                <div class="card empty">
                    <div class="empty-icon">🅿️</div>
                    You haven't added any parking slots yet.
                </div>
            }
            else
            {
                @foreach (var slot in slots)
                {
                    <div class="card">
                        <div class="card-row">
                            <div>
                                <div class="card-title">@slot.OwnerName's Slot</div>
                                <div class="card-sub">📍 @slot.Latitude.ToString("F4"), @slot.Longitude.ToString("F4")</div>
                                <div class="card-sub">🚗 @slot.VehicleType &nbsp;·&nbsp; ₹@slot.PricePerHour/hr</div>
                            </div>
                            <div>
                                @if (slot.IsBooked)
                                {
                                    <span class="badge badge-red">Booked</span>
                                }
                                else
                                {
                                    <span class="badge badge-green">Available</span>
                                }
                            </div>
                        </div>
                    </div>
                }
            }
        </div>

        <!-- My Bookings -->
        <div class="section">
            <div class="section-title">🔑 My Bookings</div>

            @if (bookings.Count == 0)
            {
                <div class="card empty">
                    <div class="empty-icon">🔍</div>
                    You haven't booked any slots yet.
                </div>
            }
            else
            {
                @foreach (var booking in bookings)
                {
                    DateTime bookFrom = (DateTime)booking.BookingFrom;
                    DateTime bookTo = (DateTime)booking.BookingTo;
                    var istFrom = bookFrom.AddHours(5.5);
                    var istTo = bookTo.AddHours(5.5);
                    var isActive = istTo > DateTime.UtcNow.AddHours(5.5);

                    <div class="card">
                        <div class="card-row">
                            <div>
                                <div class="card-title">Slot #@booking.ParkingSlotId</div>
                                <div class="card-sub">📅 @istFrom.ToString("dd MMM yyyy, hh:mm tt")</div>
                                <div class="card-sub">⏰ To: @istTo.ToString("dd MMM yyyy, hh:mm tt")</div>
                            </div>
                            <div>
                                @if (isActive)
                                {
                                    <span class="badge badge-blue">Active</span>
                                }
                                else
                                {
                                    <span class="badge badge-red">Expired</span>
                                }
                            </div>
                        </div>
                    </div>
                }
            }
        </div>

    </div>
</body>
</html>
