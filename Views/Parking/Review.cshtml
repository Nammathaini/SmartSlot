@{
    ViewData["Title"] = "Rate Your Experience";
}

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Syne:wght@700;800&family=DM+Sans:wght@300;400;500&display=swap');

    body{
        background:#080c10!important;color:white!important;
        font-family:'DM Sans',sans-serif;
        min-height:100vh;display:flex;align-items:center;justify-content:center;
    }
    body::before{
        content:'';position:fixed;inset:0;z-index:0;
        background:linear-gradient(135deg,#080c10 0%,#0a0f18 50%,#060a0c 100%);
    }
    .glow-orb{
        position:fixed;width:400px;height:400px;border-radius:50%;z-index:0;pointer-events:none;
        background:radial-gradient(circle,rgba(255,215,0,0.05) 0%,transparent 70%);
        top:50%;left:50%;transform:translate(-50%,-50%);
    }
    .card{
        position:relative;z-index:1;
        width:90%;max-width:460px;
        background:rgba(13,17,23,0.98);
        border:1px solid rgba(255,255,255,0.08);
        border-radius:24px;padding:44px 40px;
        text-align:center;
        animation:fadeUp 0.5s ease both;
    }
    @@keyframes fadeUp{from{opacity:0;transform:translateY(16px);}to{opacity:1;transform:translateY(0);}}
    .icon{font-size:44px;margin-bottom:16px;animation:popIn 0.4s ease both;}
    @@keyframes popIn{from{transform:scale(0.5);opacity:0;}to{transform:scale(1);opacity:1;}}
    h2{font-family:'Syne',sans-serif;font-size:22px;font-weight:800;margin-bottom:6px;}
    .sub{font-size:14px;color:rgba(255,255,255,0.4);margin-bottom:32px;}

    /* Stars */
    .stars{display:flex;justify-content:center;gap:12px;margin-bottom:16px;}
    .star{
        font-size:44px;color:rgba(255,255,255,0.1);
        cursor:pointer;transition:all 0.15s;
        user-select:none;line-height:1;
        filter:drop-shadow(0 0 0px transparent);
    }
    .star.lit{
        color:#FFD700;
        filter:drop-shadow(0 0 12px rgba(255,215,0,0.6));
    }
    .star:hover{transform:scale(1.2);}

    .rating-label{
        font-family:'Syne',sans-serif;font-size:16px;font-weight:700;
        color:#FFD700;min-height:24px;margin-bottom:24px;
        transition:all 0.2s;
    }
    .rating-label.empty{color:rgba(255,255,255,0.25);font-family:'DM Sans',sans-serif;font-weight:400;font-size:14px;}

    textarea{
        width:100%;height:96px;
        background:rgba(255,255,255,0.04);
        border:1px solid rgba(255,255,255,0.08);
        border-radius:12px;color:white;
        padding:14px;font-family:'DM Sans',sans-serif;font-size:14px;
        resize:none;outline:none;margin-bottom:20px;
        transition:border-color 0.2s;
    }
    textarea:focus{border-color:rgba(255,215,0,0.3);}
    textarea::placeholder{color:rgba(255,255,255,0.25);}

    .btn-submit{
        width:100%;padding:14px;
        background:linear-gradient(135deg,#f59e0b,#d97706);
        color:white;border:none;border-radius:12px;
        font-family:'Syne',sans-serif;font-size:15px;font-weight:700;
        cursor:pointer;transition:all 0.2s;
        box-shadow:0 4px 20px rgba(245,158,11,0.2);
    }
    .btn-submit:hover{transform:translateY(-2px);box-shadow:0 8px 28px rgba(245,158,11,0.35);}
    .btn-submit:disabled{
        background:rgba(255,255,255,0.06);color:rgba(255,255,255,0.25);
        cursor:not-allowed;transform:none;box-shadow:none;
    }
</style>

<div class="glow-orb"></div>
<div class="card">
    <div class="icon">⭐</div>
    <h2>How was your experience?</h2>
    <p class="sub">Your feedback helps improve SmartSlot for everyone</p>

    <form method="post" asp-controller="Parking" asp-action="SubmitReview">
        <input type="hidden" name="BookingId"     value="@ViewBag.BookingId"/>
        <input type="hidden" name="ParkingSlotId" value="@ViewBag.ParkingSlotId"/>
        <input type="hidden" name="Rating"        id="ratingValue" value=""/>

        <div class="stars" id="starRow">
            <span class="star" data-val="1">★</span>
            <span class="star" data-val="2">★</span>
            <span class="star" data-val="3">★</span>
            <span class="star" data-val="4">★</span>
            <span class="star" data-val="5">★</span>
        </div>

        <div class="rating-label empty" id="ratingText">Tap a star to rate</div>

        <textarea name="Comment" placeholder="Tell us about your parking experience (optional)..."></textarea>

        <button type="submit" class="btn-submit" id="submitBtn" disabled>
            Submit Review
        </button>
    </form>
</div>

<script>
var labels = ["","Poor","Fair","Good","Great","Excellent! 🎉"];
var stars  = document.querySelectorAll('.star');
var selected = 0;

stars.forEach(function(star){
    star.addEventListener('mouseover',function(){
        var hov = parseInt(this.getAttribute('data-val'));
        stars.forEach(function(s){
            var v = parseInt(s.getAttribute('data-val'));
            s.className = v <= hov ? 'star lit' : 'star';
        });
    });
    star.addEventListener('mouseleave',function(){
        stars.forEach(function(s){
            var v = parseInt(s.getAttribute('data-val'));
            s.className = v <= selected ? 'star lit' : 'star';
        });
    });
    star.addEventListener('click',function(){
        selected = parseInt(this.getAttribute('data-val'));
        document.getElementById('ratingValue').value = selected;
        var lbl = document.getElementById('ratingText');
        lbl.textContent = labels[selected] + ' (' + selected + '/5)';
        lbl.className = 'rating-label';
        document.getElementById('submitBtn').disabled = false;
        stars.forEach(function(s){
            var v = parseInt(s.getAttribute('data-val'));
            s.className = v <= selected ? 'star lit' : 'star';
        });
    });
});
</script>
