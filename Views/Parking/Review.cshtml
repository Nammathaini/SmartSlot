@{
    ViewData["Title"] = "Rate Your Experience";
}
<style>
    @@import url('https://fonts.googleapis.com/css2?family=Poppins:wght@600;700;800&family=Inter:wght@300;400;500;600&display=swap');
    :root{--amber:#f59e0b;--dark:#0F172A;--border:rgba(255,255,255,0.08);--text:#f1f5f9;--text-dim:rgba(241,245,249,0.45);}
    body{
        font-family:'Inter',sans-serif;
        background:linear-gradient(135deg,#0F172A,#111827,#1a1500)!important;
        background-attachment:fixed!important;
        color:var(--text)!important;
        min-height:100vh;display:flex;align-items:center;justify-content:center;
        position:relative;
    }
    body::before{content:'';position:fixed;inset:0;z-index:0;pointer-events:none;opacity:0.025;background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)'/%3E%3C/svg%3E");background-size:128px 128px;}
    .orb{position:fixed;width:600px;height:600px;border-radius:50%;z-index:0;pointer-events:none;background:radial-gradient(circle,rgba(245,158,11,0.06) 0%,transparent 65%);top:50%;left:50%;transform:translate(-50%,-50%);}
    .card{
        position:relative;z-index:1;
        width:90%;max-width:460px;
        background:rgba(30,41,59,0.65);
        backdrop-filter:blur(20px);-webkit-backdrop-filter:blur(20px);
        border:1px solid rgba(255,255,255,0.09);
        border-radius:24px;padding:48px 44px;text-align:center;
        box-shadow:0 24px 80px rgba(0,0,0,0.4),inset 0 1px 0 rgba(255,255,255,0.08);
        animation:cardIn 0.6s cubic-bezier(0.34,1.56,0.64,1) both;
    }
    @@keyframes cardIn{from{opacity:0;transform:translateY(24px) scale(0.97);}to{opacity:1;transform:translateY(0) scale(1);}}
    .icon{font-size:46px;margin-bottom:16px;display:block;animation:popIn 0.45s 0.1s ease both;}
    @@keyframes popIn{0%{transform:scale(0.5);opacity:0;}70%{transform:scale(1.1);}100%{transform:scale(1);opacity:1;}}
    h2{font-family:'Poppins',sans-serif;font-size:24px;font-weight:700;margin-bottom:8px;}
    .sub{font-size:13px;color:var(--text-dim);margin-bottom:34px;line-height:1.6;}
    .stars{display:flex;justify-content:center;gap:10px;margin-bottom:16px;}
    .star{
        font-size:46px;color:rgba(255,255,255,0.1);
        cursor:pointer;transition:all 0.15s;
        user-select:none;line-height:1;
    }
    .star.lit{color:#FFD700;filter:drop-shadow(0 0 10px rgba(255,215,0,0.55));}
    .star:hover{transform:scale(1.18);}
    .rating-label{
        font-family:'Poppins',sans-serif;font-size:16px;font-weight:700;
        color:#FFD700;min-height:26px;margin-bottom:26px;transition:all 0.2s;
    }
    .rating-label.empty{color:var(--text-dim);font-family:'Inter',sans-serif;font-weight:400;font-size:13px;}
    textarea{
        width:100%;height:96px;
        background:#1F2937;
        border:1px solid rgba(255,255,255,0.06);
        border-radius:12px;color:var(--text);
        padding:14px;font-family:'Inter',sans-serif;font-size:14px;
        resize:none;outline:none;margin-bottom:22px;
        transition:border-color 0.2s,box-shadow 0.2s;
        box-sizing:border-box;
    }
    textarea:focus{border-color:rgba(245,158,11,0.4);box-shadow:0 0 0 3px rgba(245,158,11,0.12);}
    textarea::placeholder{color:var(--text-dim);}
    .btn-submit{
        width:100%;padding:15px;
        background:linear-gradient(90deg,#f59e0b,#d97706);
        color:#fff;border:none;border-radius:13px;
        font-family:'Inter',sans-serif;font-size:15px;font-weight:600;
        cursor:pointer;transition:all 0.2s;
        box-shadow:0 6px 20px rgba(245,158,11,0.3);
    }
    .btn-submit:hover{transform:translateY(-2px);box-shadow:0 12px 32px rgba(245,158,11,0.4);}
    .btn-submit:disabled{background:rgba(255,255,255,0.06);color:var(--text-dim);cursor:not-allowed;transform:none;box-shadow:none;}
</style>
<div class="orb"></div>
<div class="card">
    <span class="icon">⭐</span>
    <h2>How was your experience?</h2>
    <p class="sub">Your feedback helps improve SmartSlot for everyone</p>
    <form method="post" asp-controller="Parking" asp-action="SubmitReview">
        <input type="hidden" name="BookingId" value="@ViewBag.BookingId"/>
        <input type="hidden" name="ParkingSlotId" value="@ViewBag.ParkingSlotId"/>
        <input type="hidden" name="Rating" id="ratingValue" value=""/>
        <div class="stars" id="starRow">
            <span class="star" data-val="1">★</span>
            <span class="star" data-val="2">★</span>
            <span class="star" data-val="3">★</span>
            <span class="star" data-val="4">★</span>
            <span class="star" data-val="5">★</span>
        </div>
        <div class="rating-label empty" id="ratingText">Tap a star to rate</div>
        <textarea name="Comment" placeholder="Tell us about your parking experience (optional)..."></textarea>
        <button type="submit" class="btn-submit" id="submitBtn" disabled>Submit Review</button>
    </form>
</div>
<script>
var labels=["","Poor","Fair","Good","Great","Excellent! 🎉"];
var stars=document.querySelectorAll('.star');
var selected=0;
stars.forEach(function(star){
    star.addEventListener('mouseover',function(){
        var hov=parseInt(this.getAttribute('data-val'));
        stars.forEach(function(s){s.className=parseInt(s.getAttribute('data-val'))<=hov?'star lit':'star';});
    });
    star.addEventListener('mouseleave',function(){
        stars.forEach(function(s){s.className=parseInt(s.getAttribute('data-val'))<=selected?'star lit':'star';});
    });
    star.addEventListener('click',function(){
        selected=parseInt(this.getAttribute('data-val'));
        document.getElementById('ratingValue').value=selected;
        var lbl=document.getElementById('ratingText');
        lbl.textContent=labels[selected]+' ('+selected+'/5)';
        lbl.className='rating-label';
        document.getElementById('submitBtn').disabled=false;
        stars.forEach(function(s){s.className=parseInt(s.getAttribute('data-val'))<=selected?'star lit':'star';});
    });
});
</script>
