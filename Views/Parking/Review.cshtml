@{
    ViewData["Title"] = "Rate Your Parking Experience";
}

<style>
    body {
        background: linear-gradient(135deg, #1a1a2e, #16213e, #0f3460);
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        font-family: 'Segoe UI', sans-serif;
    }

    .review-card {
        background: rgba(255, 255, 255, 0.05);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 20px;
        padding: 40px;
        max-width: 480px;
        width: 90%;
        text-align: center;
        box-shadow: 0 20px 60px rgba(0,0,0,0.4);
    }

    .review-card h2 { color: white; font-size: 1.6rem; margin-bottom: 8px; }
    .review-card p  { color: #aaa; margin-bottom: 30px; }

    /* Star Rating - normal left to right order */
    .stars {
        display: flex;
        justify-content: center;
        gap: 10px;
        margin-bottom: 20px;
    }

    .stars span {
        font-size: 48px;
        color: #444;
        cursor: pointer;
        transition: color 0.2s, transform 0.15s;
        user-select: none;
    }

    .stars span.active {
        color: #FFD700;
    }

    .stars span:hover {
        transform: scale(1.2);
    }

    .selected-rating {
        color: #FFD700;
        font-size: 1rem;
        margin-bottom: 20px;
        min-height: 24px;
        font-weight: bold;
    }

    textarea {
        width: 100%;
        height: 100px;
        background: rgba(255,255,255,0.08);
        border: 1px solid rgba(255,255,255,0.2);
        border-radius: 10px;
        color: white;
        padding: 12px;
        font-size: 0.95rem;
        resize: none;
        outline: none;
        margin-bottom: 20px;
        box-sizing: border-box;
    }

    textarea::placeholder { color: #888; }

    .btn-submit {
        background: linear-gradient(135deg, #28a745, #20c997);
        color: white;
        border: none;
        padding: 14px 40px;
        border-radius: 30px;
        font-size: 1rem;
        font-weight: bold;
        cursor: pointer;
        width: 100%;
        transition: transform 0.2s, box-shadow 0.2s;
    }

    .btn-submit:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 25px rgba(40, 167, 69, 0.4);
    }

    .btn-submit:disabled {
        background: #555;
        cursor: not-allowed;
        transform: none;
        box-shadow: none;
    }
</style>

<div class="review-card">
    <h2>⭐ Rate Your Parking Experience</h2>
    <p>We value your feedback!</p>

    <form method="post" asp-controller="Parking" asp-action="SubmitReview">

        <input type="hidden" name="BookingId"     value="@ViewBag.BookingId" />
        <input type="hidden" name="ParkingSlotId" value="@ViewBag.ParkingSlotId" />
        <input type="hidden" name="Rating"        id="ratingValue" value="" />

        <!-- Stars: 1 to 5 left to right -->
        <div class="stars" id="starRow">
            <span data-val="1">★</span>
            <span data-val="2">★</span>
            <span data-val="3">★</span>
            <span data-val="4">★</span>
            <span data-val="5">★</span>
        </div>

        <div class="selected-rating" id="ratingText">Click a star to rate</div>

        <textarea name="Comment" placeholder="Share your experience (optional)..."></textarea>

        <button type="submit" class="btn-submit" id="submitBtn" disabled>
            Submit Review
        </button>

    </form>
</div>

<script>
    var labels = ["", "Poor", "Fair", "Good", "Great", "Excellent!"];
    var stars  = document.querySelectorAll('.stars span');
    var selected = 0;

    stars.forEach(function(star) {
        // Hover: highlight 1 to hovered star
        star.addEventListener('mouseover', function() {
            var hov = parseInt(this.getAttribute('data-val'));
            stars.forEach(function(s) {
                s.style.color = parseInt(s.getAttribute('data-val')) <= hov ? '#FFD700' : '#444';
            });
        });

        // Mouse leave: restore to selected state
        star.addEventListener('mouseleave', function() {
            stars.forEach(function(s) {
                s.style.color = parseInt(s.getAttribute('data-val')) <= selected ? '#FFD700' : '#444';
            });
        });

        // Click: set selected rating
        star.addEventListener('click', function() {
            selected = parseInt(this.getAttribute('data-val'));
            document.getElementById('ratingValue').value = selected;
            document.getElementById('ratingText').innerText = labels[selected] + " (" + selected + "/5)";
            document.getElementById('submitBtn').disabled = false;

            stars.forEach(function(s) {
                s.style.color = parseInt(s.getAttribute('data-val')) <= selected ? '#FFD700' : '#444';
            });
        });
    });
</script>
