@{
    ViewData["Title"] = "Available Parking Slots";
    var lat = ViewBag.Lat;
    var lon = ViewBag.Lon;
    var radius = ViewBag.Radius;
}

<style>
body {
    background-image: url('https://i.pinimg.com/1200x/ea/3f/92/ea3f92fcdab7799f742c813cdb651463.jpg');
    background-size: cover;
    background-position: center;
    background-attachment: fixed;
    background-color: #000 !important;
    color: white !important;
}
body::before {
    content:'';
    position:fixed;
    width:100%;
    height:100%;
    background:rgba(0,0,0,0.78);
    z-index:0;
}
.container-box {
    position:relative;
    z-index:1;
    max-width:1200px;
    margin:40px auto;
    background:rgba(26,26,26,0.95);
    padding:30px;
    border-radius:12px;
    border:1px solid #333;
}
h2 { text-align:center; margin-bottom:25px; }

table {
    width:100%;
    border-collapse:collapse;
}
th, td {
    padding:10px;
    border:1px solid #444;
    text-align:center;
}
th { background:#2a2a2a; }

.back-btn {
    display:inline-block;
    margin-bottom:20px;
    padding:8px 15px;
    background:#007bff;
    color:white;
    border-radius:6px;
    text-decoration:none;
}
.verify-btn {
    background:#28a745;
    padding:6px 12px;
    border-radius:6px;
    color:white;
    text-decoration:none;
}
</style>

<div class="container-box">
    <a href="/Parking/Search" class="back-btn">⬅ Back to Search</a>
    <h2>🟢 Available Parking Slots</h2>

    <!-- 🔥 SORT DROPDOWN ADDED -->
    <select id="sortOption" onchange="applySort()" style="margin-bottom:15px;padding:6px;">
        <option value="">Sort By</option>
        <option value="price">Price (Low → High)</option>
        <option value="distance">Distance (Near → Far)</option>
        <option value="status">Slot Status</option>
    </select>

    <table>
        <thead>
            <tr>
                <th>Owner</th>
                <th>Phone</th>
                <th>Price</th>
                <th>Vehicle</th>
                <th>Available From</th>
                <th>Available To</th>
                <th>Distance</th>
                <th>Rating</th>
                <th>Status</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody id="availableBody"></tbody>
    </table>
</div>

<script>

var allAvailableSlots = [];

function getDistanceKm(lat1, lon1, lat2, lon2) {
    var R = 6371;
    var dLat = (lat2 - lat1) * Math.PI / 180;
    var dLon = (lon2 - lon1) * Math.PI / 180;
    var a = Math.sin(dLat/2) * Math.sin(dLat/2) +
            Math.cos(lat1*Math.PI/180) * Math.cos(lat2*Math.PI/180) *
            Math.sin(dLon/2) * Math.sin(dLon/2);
    return (R * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1-a)));
}

function renderTable(slots){
    var body=document.getElementById("availableBody");
    body.innerHTML="";

    if(slots.length===0){
        body.innerHTML="<tr><td colspan='10'>No Available Slots</td></tr>";
        return;
    }

    slots.forEach(slot=>{
        var distance=getDistanceKm(@lat,@lon,slot.latitude,slot.longitude);
        slot._distanceValue = distance;

        body.innerHTML+=`
        <tr>
            <td>${slot.ownerName}</td>
            <td>${slot.ownerPhone ? slot.ownerPhone : "-"}</td>
            <td>₹${slot.pricePerHour}/hr</td>
            <td>${slot.vehicleType}</td>
            <td>${new Date(slot.availableFrom).toLocaleString()}</td>
            <td>${new Date(slot.availableTo).toLocaleString()}</td>
            <td>${distance.toFixed(2)} km</td>
            <td>${slot.averageRating ? "⭐ "+slot.averageRating.toFixed(1) : "No reviews"}</td>
            <td>${slot.parkingBadge ? slot.parkingBadge : "-"}</td>
            <td>
                <a href="/Verification/Upload/${slot.id}" class="verify-btn">
                    Verify & Book
                </a>
            </td>
        </tr>`;
    });
}

function applySort(){
    var option=document.getElementById("sortOption").value;
    var sorted=[...allAvailableSlots];

    if(option==="price"){
        sorted.sort((a,b)=>a.pricePerHour-b.pricePerHour);
    }

    if(option==="distance"){
        sorted.sort((a,b)=>a._distanceValue-b._distanceValue);
    }

    if(option==="status"){
        var rank={
            "🥇 Premium":1,
            "🥈 Gold":2,
            "🥉 Silver":3,
            "🏠 Basic":4,
            "❌ Poor":5
        };
        sorted.sort((a,b)=>{
            return (rank[a.parkingBadge]||6) - (rank[b.parkingBadge]||6);
        });
    }

    renderTable(sorted);
}

function loadData(){
fetch("/Parking/NearbySlots?lat=@lat&lon=@lon&radius=@radius")
.then(res=>res.json())
.then(data=>{
    var available=data.filter(s=>!s.isBooked);

    allAvailableSlots=available.map(slot=>{
        slot._distanceValue=getDistanceKm(@lat,@lon,slot.latitude,slot.longitude);
        return slot;
    });

    renderTable(allAvailableSlots);
});
}

loadData();

/* 🔥 Auto Refresh Every 30 Seconds */
setInterval(loadData,30000);

</script>