@{
    ViewData["Title"] = "Add Parking Slot";
    Layout = "_Layout";
}
<style>
    @@import url('https://fonts.googleapis.com/css2?family=Poppins:wght@600;700;800&family=Inter:wght@300;400;500;600&display=swap');
    *,*::before,*::after{box-sizing:border-box;}
    :root{
        --primary:#2563EB;--primary-dim:#1d4ed8;--green:#10b981;--green-dim:#059669;
        --dark:#0F172A;--surface:rgba(20,30,48,0.72);--border:rgba(255,255,255,0.08);
        --text:#f1f5f9;--text-dim:rgba(241,245,249,0.45);
    }
    /* No body background — _Layout handles the parking photo + blue overlay */
    .page-wrap{position:relative;z-index:1;min-height:100vh;display:flex;flex-direction:column;align-items:center;justify-content:flex-start;padding:40px 20px 60px;}
    .page-title{font-family:'Poppins',sans-serif;font-size:24px;font-weight:700;margin-bottom:28px;text-align:center;color:#f1f5f9;}
    .loc-section{width:100%;max-width:480px;margin-bottom:16px;}
    .loc-label{font-size:10px;font-weight:600;letter-spacing:1px;text-transform:uppercase;color:var(--text-dim);margin-bottom:10px;}
    .btn-location{width:100%;display:flex;align-items:center;justify-content:center;gap:8px;padding:12px;margin-bottom:10px;background:linear-gradient(90deg,#10b981,#059669);color:#fff;border:none;border-radius:11px;font-family:'Inter',sans-serif;font-size:14px;font-weight:600;cursor:pointer;transition:all 0.2s;box-shadow:0 6px 16px rgba(16,185,129,0.3);}
    .btn-location:hover{transform:translateY(-1px);}
    .search-row{display:flex;gap:8px;}
    .search-row input{flex:1;padding:11px 14px;background:rgba(15,23,42,0.7);border:1px solid rgba(255,255,255,0.06);border-radius:10px;color:var(--text);font-family:'Inter',sans-serif;font-size:14px;outline:none;transition:border-color 0.2s;}
    .search-row input:focus{border-color:#3B82F6;}
    .search-row input::placeholder{color:var(--text-dim);}
    .search-btn{padding:11px 16px;background:rgba(37,99,235,0.12);border:1px solid rgba(37,99,235,0.2);border-radius:10px;color:#93c5fd;font-size:15px;cursor:pointer;transition:all 0.2s;}
    .status-text{font-size:12px;color:var(--text-dim);text-align:center;margin-top:8px;}
    .form-card{background:var(--surface);backdrop-filter:blur(20px);-webkit-backdrop-filter:blur(20px);border:1px solid rgba(255,255,255,0.09);border-radius:20px;padding:32px;width:100%;max-width:480px;box-shadow:0 16px 60px rgba(0,0,0,0.35);}
    .field{margin-bottom:16px;}
    .field label{display:block;font-size:10px;font-weight:600;color:var(--text-dim);letter-spacing:1px;text-transform:uppercase;margin-bottom:7px;}
    .field input,.field select{width:100%;padding:12px 14px;background:rgba(15,23,42,0.7);border:1px solid rgba(255,255,255,0.06);border-radius:10px;color:var(--text);font-family:'Inter',sans-serif;font-size:14px;outline:none;transition:border-color 0.2s;}
    .field input:focus,.field select:focus{border-color:#3B82F6;}
    .field input::placeholder{color:var(--text-dim);}
    .field select option{background:#1e293b;}
    .upload-box{border:2px dashed rgba(255,255,255,0.1);border-radius:12px;padding:20px;text-align:center;margin-top:4px;background:rgba(255,255,255,0.02);cursor:pointer;transition:all 0.2s;}
    .upload-box:hover{border-color:rgba(16,185,129,0.4);background:rgba(16,185,129,0.03);}
    .upload-icon{font-size:32px;margin-bottom:8px;}
    .upload-text{font-size:13px;color:var(--text-dim);}
    .upload-sub{font-size:11px;color:var(--text-dim);opacity:0.6;margin-top:4px;}

    /* UPI QR Upload */
    .upi-qr-upload-box{border:2px dashed rgba(139,92,246,0.3);border-radius:12px;padding:20px;text-align:center;margin-top:4px;background:rgba(139,92,246,0.04);cursor:pointer;transition:all 0.2s;}
    .upi-qr-upload-box:hover{border-color:rgba(139,92,246,0.6);background:rgba(139,92,246,0.08);}

    /* QR icon in upload box */
    .upi-qr-svg-icon{display:flex;justify-content:center;margin-bottom:10px;}
    .upi-qr-svg-icon svg{width:44px;height:44px;opacity:0.75;}

    .upi-qr-preview{display:none;margin-top:12px;text-align:center;}
    .upi-qr-preview img{width:140px;height:140px;object-fit:contain;border-radius:10px;border:2px solid rgba(139,92,246,0.3);background:white;padding:6px;}
    .upi-qr-preview-label{font-size:11px;color:#a78bfa;margin-top:6px;font-weight:600;}
    .upi-hint{font-size:11px;color:#a78bfa;margin-top:8px;padding:8px 12px;background:rgba(139,92,246,0.08);border-radius:8px;border:1px solid rgba(139,92,246,0.15);}

    .analyzing-box{display:none;text-align:center;padding:16px;color:var(--text-dim);font-size:13px;}
    .analyzing-spinner{display:inline-block;width:20px;height:20px;border:2px solid rgba(255,255,255,0.1);border-top-color:#3B82F6;border-radius:50%;animation:spin 0.7s linear infinite;vertical-align:middle;margin-right:8px;}
    .ai-score-box{display:none;margin-top:16px;padding:24px 18px;border-radius:14px;text-align:center;border:1px solid rgba(255,255,255,0.08);background:rgba(255,255,255,0.02);}
    .badge-pill{display:inline-block;padding:10px 28px;border-radius:30px;font-family:'Poppins',sans-serif;font-size:15px;font-weight:700;margin-bottom:10px;}
    .badge-sub{font-size:13px;color:var(--text-dim);margin-bottom:12px;}
    .btn-submit{width:100%;padding:14px;margin-top:10px;background:linear-gradient(90deg,#10b981,#059669);color:#fff;border:none;border-radius:12px;font-family:'Inter',sans-serif;font-size:15px;font-weight:600;cursor:pointer;transition:all 0.2s;box-shadow:0 6px 20px rgba(16,185,129,0.3);}
    .btn-submit:hover{transform:translateY(-2px);}
    @@keyframes spin{to{transform:rotate(360deg);}}
    @@keyframes fadeUp{from{opacity:0;transform:translateY(12px);}to{opacity:1;transform:translateY(0);}}
</style>

<div class="page-wrap">
    <h2 class="page-title">&#8617; Add Your Parking Slot</h2>

    <div class="loc-section">
        <div class="loc-label">Your Location</div>
        <button type="button" class="btn-location" onclick="getLocation()">&#128205; Use My Live Location</button>
        <p id="locationStatus" class="status-text">Please fetch your location first.</p>
        <div class="search-row">
            <input type="text" id="addressInput" placeholder="Or search area / address..."/>
            <button type="button" class="search-btn" onclick="searchAddress()">&#128269;</button>
        </div>
        <p id="addressStatus" class="status-text"></p>
    </div>

    <div class="form-card">
        <form method="post" action="/Parking/AddSlot" id="slotForm" enctype="multipart/form-data">
            <input type="hidden" name="Latitude" id="latField"/>
            <input type="hidden" name="Longitude" id="lonField"/>
            <input type="hidden" name="ParkingScore" id="parkingScoreField" value="0"/>
            <input type="hidden" name="ParkingBadge" id="parkingBadgeField" value=""/>
            <input type="hidden" name="ParkingScoreDetails" id="parkingDetailsField" value=""/>
            <input type="hidden" name="ExitMethod" value="QR"/>

            <div class="field"><label>Owner Name</label><input type="text" name="OwnerName" placeholder="Your full name" required/></div>
            <div class="field"><label>Phone Number</label><input type="tel" name="OwnerPhone" placeholder="10-digit number" maxlength="10" pattern="[0-9]{10}" required/></div>
            <div class="field"><label>Price Per Hour (Rs.)</label><input type="number" name="PricePerHour" placeholder="e.g. 30" required/></div>
            <div class="field"><label>Available From</label><input type="datetime-local" name="AvailableFrom" required/></div>
            <div class="field"><label>Available To</label><input type="datetime-local" name="AvailableTo" required/></div>
            <div class="field"><label>Vehicle Type</label>
                <select name="VehicleType"><option>Bike</option><option>Car</option><option>Both</option></select>
            </div>
            <div class="field"><label>Payment Mode</label>
                <select name="PaymentMode" id="paymentMode" onchange="toggleUpi()">
                    <option value="Cash">Hard Cash Only</option>
                    <option value="UPI">UPI</option>
                    
                </select>
            </div>

            <div id="upiSection" style="display:none;">
                <div class="field">
                    <label>Your UPI ID (optional)</label>
                    <input type="text" name="OwnerUpiId" id="ownerUpiId" placeholder="example@upi"/>
                </div>
                <div class="field">
                    <label>Upload Your UPI QR Code</label>
                    <div class="upi-qr-upload-box" onclick="document.getElementById('upiQrFile').click()">
                        <!-- SVG QR icon instead of crown emoji -->
                        <div class="upi-qr-svg-icon">
                            <svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <rect x="4" y="4" width="24" height="24" rx="3" stroke="#a78bfa" stroke-width="2.5"/>
                                <rect x="11" y="11" width="10" height="10" fill="#a78bfa" rx="1"/>
                                <rect x="36" y="4" width="24" height="24" rx="3" stroke="#a78bfa" stroke-width="2.5"/>
                                <rect x="43" y="11" width="10" height="10" fill="#a78bfa" rx="1"/>
                                <rect x="4" y="36" width="24" height="24" rx="3" stroke="#a78bfa" stroke-width="2.5"/>
                                <rect x="11" y="43" width="10" height="10" fill="#a78bfa" rx="1"/>
                                <rect x="36" y="36" width="7" height="7" fill="#a78bfa" rx="1"/>
                                <rect x="47" y="36" width="7" height="7" fill="#a78bfa" rx="1"/>
                                <rect x="36" y="47" width="7" height="7" fill="#a78bfa" rx="1"/>
                                <rect x="47" y="47" width="7" height="7" fill="#a78bfa" rx="1"/>
                                <rect x="41" y="41" width="7" height="7" fill="#a78bfa" rx="1" opacity="0.5"/>
                            </svg>
                        </div>
                        <div class="upload-text" style="color:#c4b5fd;font-weight:600;">Tap to upload your UPI QR image</div>
                        <div class="upload-sub">Customer will scan this to pay you directly</div>
                        <input type="file" id="upiQrFile" name="upiQrImage" accept="image/*" style="display:none;" onchange="previewUpiQr(this)"/>
                    </div>
                    <div class="upi-qr-preview" id="upiQrPreview">
                        <img id="upiQrPreviewImg" src="" alt="UPI QR Preview"/>
                        <div class="upi-qr-preview-label">&#10003; QR uploaded &#8212; customers will scan this to pay</div>
                    </div>
                    <div class="upi-hint">&#128161; Open GPay/PhonePe/Paytm, go to your QR code, screenshot it and upload here</div>
                </div>
            </div>

            <div class="field">
                <label>&#128247; Parking Slot Photo</label>
                <div class="upload-box" onclick="document.getElementById('parkingImage').click()">
                    <div class="upload-icon">&#128247;</div>
                    <div class="upload-text">Click to upload parking photo</div>
                    <div class="upload-sub">Our AI will analyze and score your slot</div>
                    <input type="file" id="parkingImage" name="parkingImage" accept="image/*" style="display:none;" onchange="analyzeParking(this)"/>
                </div>
            </div>

            <div class="analyzing-box" id="analyzingBox">
                <span class="analyzing-spinner"></span> AI is analyzing your parking slot...
            </div>
            <div class="ai-score-box" id="aiScoreBox">
                <div class="badge-pill" id="badgePill"></div>
                <div class="badge-sub" id="badgeSubText"></div>
                <img id="previewImage" src="" alt="" style="width:100%;border-radius:10px;margin-top:4px;display:none;"/>
            </div>

            <button type="submit" class="btn-submit" onclick="return validateLocation()">&#10133; Add Slot</button>
        </form>
    </div>
</div>

<script>
function getLocation(){
    if(!navigator.geolocation){document.getElementById("locationStatus").innerText="Not supported";return;}
    document.getElementById("locationStatus").innerText="Fetching...";
    navigator.geolocation.getCurrentPosition(function(p){
        setLocation(p.coords.latitude,p.coords.longitude);
        document.getElementById("locationStatus").innerText="Live location fetched!";
    },function(){document.getElementById("locationStatus").innerText="Permission denied.";});
}
function searchAddress(){
    var address=document.getElementById("addressInput").value.trim();
    if(!address){document.getElementById("addressStatus").innerText="Please enter an address.";return;}
    document.getElementById("addressStatus").innerText="Searching...";
    fetch("https://nominatim.openstreetmap.org/search?q="+encodeURIComponent(address)+"&format=json&limit=1")
    .then(r=>r.json()).then(function(data){
        if(!data.length){document.getElementById("addressStatus").innerText="Not found.";setLocation("","");}
        else{setLocation(data[0].lat,data[0].lon);document.getElementById("addressStatus").innerText="Found: "+data[0].display_name;}
    }).catch(function(){document.getElementById("addressStatus").innerText="Error. Try again.";});
}
function setLocation(lat,lon){document.getElementById("latField").value=lat;document.getElementById("lonField").value=lon;}

function toggleUpi(){
    var mode=document.getElementById("paymentMode").value;
    var show=(mode==="UPI");
    document.getElementById("upiSection").style.display=show?"block":"none";
    if(!show){document.getElementById("ownerUpiId").value="";document.getElementById("upiQrFile").value="";document.getElementById("upiQrPreview").style.display="none";}
}

function previewUpiQr(input){
    var file=input.files[0];if(!file)return;
    var reader=new FileReader();
    reader.onload=function(e){
        document.getElementById("upiQrPreviewImg").src=e.target.result;
        document.getElementById("upiQrPreview").style.display="block";
    };
    reader.readAsDataURL(file);
}

function getBadgeInfo(score){
    if(score>=80)return{label:"Premium",color:"#FFD700",dark:true,sub:"Excellent parking slot!"};
    if(score>=70)return{label:"Gold",color:"#C0C0C0",dark:true,sub:"Very good parking slot!"};
    if(score>=50)return{label:"Silver",color:"#CD7F32",dark:false,sub:"Good parking slot"};
    if(score>=35)return{label:"Basic",color:"#10b981",dark:false,sub:"Basic parking slot"};
    return{label:"Poor",color:"#ef4444",dark:false,sub:"Not recommended"};
}
function validateLocation(){
    if(!document.getElementById("latField").value){alert("Please set your location first!");return false;}
    if(!document.getElementById("parkingImage").files.length){alert("Please upload a parking photo!");return false;}
    if(parseInt(document.getElementById("parkingScoreField").value)<35){alert("Score too low. Upload a clearer photo of your parking area.");return false;}
    var mode=document.getElementById("paymentMode").value;
    if((mode==="UPI")&&!document.getElementById("upiQrFile").files.length){
        alert("Please upload your UPI QR code image!");return false;
    }
    return true;
}
function analyzeParking(input){
    var file=input.files[0];if(!file)return;
    var reader=new FileReader();
    reader.onload=function(e){document.getElementById("previewImage").src=e.target.result;document.getElementById("previewImage").style.display="block";};
    reader.readAsDataURL(file);
    document.getElementById("analyzingBox").style.display="block";
    document.getElementById("aiScoreBox").style.display="none";
    var formData=new FormData();formData.append("image",file);
    fetch("/Parking/AnalyzeParking",{method:"POST",body:formData})
    .then(async r=>{if(!r.ok)throw new Error("Server Error: "+(await r.text()));return r.json();})
    .then(function(data){
        document.getElementById("analyzingBox").style.display="none";
        document.getElementById("aiScoreBox").style.display="block";
        if(!data||data.score===undefined)throw new Error("Invalid response");
        var info=getBadgeInfo(data.score);
        var pill=document.getElementById("badgePill");
        pill.innerText=info.label;pill.style.background=info.color;pill.style.color=info.dark?"#000":"#fff";
        document.getElementById("badgeSubText").innerText=info.sub;
        document.getElementById("aiScoreBox").style.borderColor=info.color+"44";
        document.getElementById("parkingScoreField").value=data.score;
        document.getElementById("parkingBadgeField").value=data.badge;
        document.getElementById("parkingDetailsField").value=data.details;
    })
    .catch(function(){
        document.getElementById("analyzingBox").style.display="none";
        document.getElementById("aiScoreBox").style.display="block";
        var pill=document.getElementById("badgePill");
        pill.innerText="Analysis Failed";pill.style.background="#ef4444";pill.style.color="#fff";
        document.getElementById("badgeSubText").innerText="Could not analyze image. Please try again.";
    });
}
</script>
