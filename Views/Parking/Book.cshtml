@{
    ViewData["Title"] = "Book Parking Slot";
    var slot = ViewBag.Slot as SmartSlot.Models.ParkingSlot;
    var bookedRanges = ViewBag.BookedRanges as List<dynamic>;
    bool isExtension = ViewBag.ExtensionMode != null && (bool)ViewBag.ExtensionMode;
    DateTime? extensionStart = ViewBag.ExtensionStart as DateTime?;
    string extensionStartStr = extensionStart != null ? extensionStart.Value.ToString("yyyy-MM-ddTHH:mm") : "";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
<script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Syne:wght@700;800&family=DM+Sans:wght@300;400;500&display=swap');

    body{
        background:#080c10!important;color:white!important;
        font-family:'DM Sans',sans-serif;
    }
    body::before{
        content:'';position:fixed;inset:0;z-index:0;
        background:url('/images/parking-bg.jpg') center/cover no-repeat;
    }
    body::after{
        content:'';position:fixed;inset:0;z-index:0;
        background:rgba(5,8,15,0.92);
    }
    .page{
        position:relative;z-index:1;
        min-height:100vh;display:flex;flex-direction:column;
        align-items:center;padding:40px 20px 60px;
    }
    .page-title{
        font-family:'Syne',sans-serif;font-size:22px;font-weight:800;
        margin-bottom:24px;text-align:center;
    }
    .ext-banner{
        background:rgba(23,162,184,0.12);border:1px solid rgba(23,162,184,0.3);
        color:#67e8f9;padding:12px 20px;border-radius:12px;
        font-size:13px;font-weight:500;margin-bottom:20px;
        width:100%;max-width:480px;text-align:center;
    }
    .card{
        background:rgba(13,17,23,0.97);
        border:1px solid rgba(255,255,255,0.08);
        border-radius:18px;padding:24px;
        width:100%;max-width:480px;margin-bottom:16px;
        animation:fadeUp 0.4s ease both;
    }
    .card:nth-child(3){animation-delay:0.1s;}
    @@keyframes fadeUp{from{opacity:0;transform:translateY(12px);}to{opacity:1;transform:translateY(0);}}

    .card-label{
        font-family:'Syne',sans-serif;font-size:13px;font-weight:700;
        color:rgba(255,255,255,0.5);letter-spacing:0.5px;
        margin-bottom:16px;text-transform:uppercase;font-size:11px;
    }
    .detail-row{
        display:flex;justify-content:space-between;align-items:center;
        padding:10px 0;border-bottom:1px solid rgba(255,255,255,0.05);
    }
    .detail-row:last-child{border-bottom:none;}
    .detail-key{font-size:13px;color:rgba(255,255,255,0.4);}
    .detail-val{font-size:13px;font-weight:600;color:#eee;}
    .price-val{font-family:'Syne',sans-serif;font-size:18px;font-weight:800;color:#00e676;}

    /* Payment mode badge */
    .pay-badge{
        margin-top:14px;padding:12px 16px;border-radius:12px;
        display:flex;align-items:center;gap:10px;font-size:13px;
    }
    .pay-badge.upi{background:rgba(0,230,118,0.06);border:1px solid rgba(0,230,118,0.15);color:#86efac;}
    .pay-badge.cash{background:rgba(255,171,64,0.06);border:1px solid rgba(255,171,64,0.15);color:#fcd34d;}
    .pay-badge-icon{font-size:20px;}

    /* Floating label inputs */
    .field{position:relative;margin-bottom:16px;}
    .field label{
        display:block;font-size:11px;font-weight:600;
        color:rgba(255,255,255,0.4);letter-spacing:0.8px;
        text-transform:uppercase;margin-bottom:6px;
    }
    .field input,.field .flatpickr-input{
        width:100%;padding:12px 14px;
        background:rgba(255,255,255,0.04);
        border:1px solid rgba(255,255,255,0.08);
        border-radius:10px;color:white;
        font-family:'DM Sans',sans-serif;font-size:14px;
        outline:none;transition:border-color 0.2s,background 0.2s;
        box-sizing:border-box;
    }
    .field input:focus{border-color:#00e676;background:rgba(0,230,118,0.04);}
    .field input.readonly-field{background:rgba(255,255,255,0.02)!important;color:rgba(255,255,255,0.4)!important;cursor:not-allowed;}
    .field .hint{font-size:11px;color:rgba(23,162,184,0.7);margin-top:5px;}

    /* Price box */
    .price-box{
        background:rgba(0,230,118,0.04);
        border:1px solid rgba(0,230,118,0.15);
        border-radius:12px;padding:16px;
        text-align:center;margin-top:16px;display:none;
    }
    .price-duration{font-size:13px;color:rgba(255,255,255,0.4);margin-bottom:6px;}
    .price-total{font-family:'Syne',sans-serif;font-size:28px;font-weight:800;color:#00e676;}
    .price-rate{font-size:12px;color:rgba(255,255,255,0.3);margin-top:4px;}

    /* UPI button */
    .upi-btn{
        display:flex;align-items:center;justify-content:center;gap:8px;
        background:linear-gradient(135deg,#6d28d9,#00e676);
        color:white;padding:13px;border-radius:12px;
        text-decoration:none;font-family:'Syne',sans-serif;
        font-size:14px;font-weight:700;margin-top:12px;
        transition:all 0.2s;
    }
    .upi-btn:hover{opacity:0.9;transform:translateY(-1px);color:white;}

    .upi-note{
        background:rgba(255,171,64,0.06);border:1px solid rgba(255,171,64,0.15);
        border-radius:10px;padding:12px;text-align:center;
        font-size:12px;color:#fcd34d;margin-top:12px;
    }

    /* Submit button with ripple */
    .btn-submit{
        width:100%;padding:14px;margin-top:8px;
        background:#00e676;color:#000;
        border:none;border-radius:12px;
        font-family:'Syne',sans-serif;font-size:15px;font-weight:700;
        cursor:pointer;transition:all 0.2s;
        position:relative;overflow:hidden;
        box-shadow:0 4px 20px rgba(0,230,118,0.2);
    }
    .btn-submit:hover{background:#00c853;transform:translateY(-1px);box-shadow:0 8px 28px rgba(0,230,118,0.3);}
    .btn-submit:active{transform:translateY(0);}
    .btn-submit:disabled{background:rgba(255,255,255,0.06);color:rgba(255,255,255,0.3);cursor:not-allowed;transform:none;box-shadow:none;}
    .ripple{
        position:absolute;border-radius:50%;
        background:rgba(255,255,255,0.3);
        transform:scale(0);animation:rippleAnim 0.5s linear;
        pointer-events:none;
    }
    @@keyframes rippleAnim{to{transform:scale(4);opacity:0;}}

    /* Spinner */
    .spinner{
        display:inline-block;width:16px;height:16px;
        border:2px solid rgba(0,0,0,0.3);border-top-color:#000;
        border-radius:50%;animation:spin 0.6s linear infinite;
        vertical-align:middle;margin-right:6px;
    }
    @@keyframes spin{to{transform:rotate(360deg);}}
</style>

<div class="page">
    <h2 class="page-title">
        @(isExtension ? "🔄 Extend Your Booking" : "🅿️ Book Parking Slot")
    </h2>

    @if (isExtension)
    {
        <div class="ext-banner">🔄 Extension Mode — Select your new end time below</div>
    }

    <!-- Slot Details Card -->
    <div class="card">
        <div class="card-label">Slot Details</div>
        <div class="detail-row">
            <span class="detail-key">Owner</span>
            <span class="detail-val">@slot.OwnerName</span>
        </div>
        <div class="detail-row">
            <span class="detail-key">Vehicle Type</span>
            <span class="detail-val">@slot.VehicleType</span>
        </div>
        <div class="detail-row">
            <span class="detail-key">Rate</span>
            <span class="price-val">₹@slot.PricePerHour/hr</span>
        </div>
        <div class="detail-row">
            <span class="detail-key">Available From</span>
            <span class="detail-val">@slot.AvailableFrom.ToString("dd MMM, hh:mm tt")</span>
        </div>
        <div class="detail-row">
            <span class="detail-key">Available To</span>
            <span class="detail-val">@slot.AvailableTo.ToString("dd MMM, hh:mm tt")</span>
        </div>

        @if (slot.PaymentMode == "UPI")
        {
            <div class="pay-badge upi">
                <span class="pay-badge-icon">💳</span>
                <div>
                    <div style="font-weight:600;">UPI Payment</div>
                    <div style="font-size:12px;opacity:0.7;">UPI ID: @slot.OwnerUpiId</div>
                </div>
            </div>
            <a id="upiPayBtn"
               href="upi://pay?pa=@slot.OwnerUpiId&pn=SmartSlot Parking&am=0&tn=Parking Payment"
               class="upi-btn" onclick="paymentDone()">
                📱 Pay via GPay / PhonePe / Paytm
            </a>
        }
        else
        {
            <div class="pay-badge cash">
                <span class="pay-badge-icon">💵</span>
                <div>
                    <div style="font-weight:600;">Cash Payment</div>
                    <div style="font-size:12px;opacity:0.7;">Pay the owner when you arrive</div>
                </div>
            </div>
        }
    </div>

    <!-- Booking Form Card -->
    <div class="card">
        <div class="card-label">Booking Details</div>
        <form method="post" action="@(isExtension ? "/Parking/ConfirmExtension" : "/Parking/ConfirmBooking")" id="bookingForm">
            <input type="hidden" name="ParkingSlotId" value="@slot.Id"/>
            <input type="hidden" name="totalAmount" id="totalAmountField" value="0"/>
            <input type="hidden" name="ExistingBookingId" value="@(ViewBag.ExistingBookingId ?? 0)"/>

            @if (!isExtension)
            {
                <div class="field">
                    <label>Your Name</label>
                    <input type="text" name="CustomerName" placeholder="Full name" required/>
                </div>
                <div class="field">
                    <label>Phone Number</label>
                    <input type="tel" name="CustomerPhone" placeholder="10-digit number" maxlength="10" pattern="[0-9]{10}" required/>
                </div>
                <div class="field">
                    <label>Vehicle Number</label>
                    <input type="text" name="VehicleNumber" placeholder="e.g. TN01AB1234" required/>
                </div>
            }

            <div class="field">
                <label>@(isExtension ? "Extension Starts" : "Booking From")</label>
                @if (isExtension)
                {
                    <input type="datetime-local" name="BookingFrom" id="bookingFrom"
                           value="@extensionStartStr" min="@extensionStartStr" max="@extensionStartStr"
                           class="readonly-field" readonly required/>
                    <div class="hint">⏰ Your extension starts from your previous booking end time</div>
                }
                else
                {
                    <input type="datetime-local" name="BookingFrom" id="bookingFrom"
                           value="@ViewBag.IstNow" min="@ViewBag.IstNow"
                           max="@slot.AvailableTo.ToString("yyyy-MM-ddTHH:mm")"
                           onchange="calculatePrice()" required/>
                }
            </div>

            <div class="field">
                <label>@(isExtension ? "Extend To" : "Booking To")</label>
                <input type="datetime-local" name="BookingTo" id="bookingTo"
                       min="@(isExtension ? extensionStartStr : ViewBag.IstNow)"
                       max="@slot.AvailableTo.ToString("yyyy-MM-ddTHH:mm")"
                       onchange="calculatePrice()" required/>
            </div>

            <!-- Price Box -->
            <div class="price-box" id="priceBox">
                <div class="price-duration" id="durationText"></div>
                <div class="price-total">₹<span id="totalPrice">0</span></div>
                <div class="price-rate">@ ₹@slot.PricePerHour/hr</div>
            </div>

            @if (slot.PaymentMode == "UPI")
            {
                <div class="upi-note" id="payNote">
                    ⚠ Complete UPI payment first, then click Confirm
                </div>
                <button type="submit" class="btn-submit" id="confirmBtn" style="display:none;">
                    ✅ @(isExtension ? "Confirm Extension" : "Confirm Booking")
                </button>
            }
            else
            {
                <button type="submit" class="btn-submit" id="confirmBtn" onclick="handleSubmit(this)">
                    ✅ @(isExtension ? "Confirm Extension" : "Confirm Booking")
                </button>
            }
        </form>
    </div>
</div>

<script>
var bookedRanges = [];
@if (bookedRanges != null)
{
    foreach (var range in bookedRanges)
    {
        <text>
        bookedRanges.push({
            from: new Date("@range.BookingFrom.ToString("yyyy-MM-ddTHH:mm:ss")"),
            to:   new Date("@range.BookingTo.ToString("yyyy-MM-ddTHH:mm:ss")")
        });
        </text>
    }
}

function isTimeBlocked(date) {
    for (var i = 0; i < bookedRanges.length; i++) {
        if (date >= bookedRanges[i].from && date < bookedRanges[i].to) return true;
    }
    return false;
}

@if (!isExtension)
{
    <text>
    flatpickr("#bookingFrom", {
        enableTime:true, dateFormat:"Y-m-d H:i",
        minDate:"@ViewBag.IstNow", defaultDate:"@ViewBag.IstNow",
        maxDate:"@slot.AvailableTo.ToString("yyyy-MM-ddTHH:mm")",
        disable:[function(d){return isTimeBlocked(d);}],
        onChange:function(){calculatePrice();}
    });
    </text>
}

flatpickr("#bookingTo", {
    enableTime:true, dateFormat:"Y-m-d H:i",
    minDate:"@(isExtension ? extensionStartStr : ViewBag.IstNow)",
    maxDate:"@slot.AvailableTo.ToString("yyyy-MM-ddTHH:mm")",
    disable:[function(d){return isTimeBlocked(d);}],
    onChange:function(){calculatePrice();}
});

@if (isExtension)
{
    <text>window.addEventListener("load",function(){calculatePrice();});</text>
}

function calculatePrice() {
    var from = document.getElementById("bookingFrom").value;
    var to   = document.getElementById("bookingTo").value;
    if (!from || !to) return;
    var fromDate = new Date(from), toDate = new Date(to);
    if (toDate <= fromDate) { document.getElementById("priceBox").style.display = "none"; return; }
    var diffMs = toDate - fromDate;
    var diffHours = diffMs / (1000 * 60 * 60);
    var pricePerHour = @(slot.PricePerHour);
    var total = (diffHours * pricePerHour).toFixed(2);
    var hours   = Math.floor(diffHours);
    var minutes = Math.round((diffHours - hours) * 60);
    var dur = (hours > 0 ? hours + " hr " : "") + (minutes > 0 ? minutes + " min" : "");
    document.getElementById("durationText").innerText = "Duration: " + dur;
    document.getElementById("totalPrice").innerText = total;
    document.getElementById("totalAmountField").value = total;
    document.getElementById("priceBox").style.display = "block";
    var upiBtn = document.getElementById("upiPayBtn");
    if (upiBtn) {
        upiBtn.href = "upi://pay?pa=@slot.OwnerUpiId&pn=SmartSlot Parking&am=" + total + "&tn=Parking Payment";
    }
}

function paymentDone() {
    setTimeout(function() {
        document.getElementById("confirmBtn").style.display = "block";
        document.getElementById("payNote").style.display = "none";
    }, 3000);
}

// Ripple + loading spinner on submit
function handleSubmit(btn) {
    setTimeout(function() {
        btn.disabled = true;
        btn.innerHTML = '<span class="spinner"></span> Processing...';
    }, 10);
}
</script>
