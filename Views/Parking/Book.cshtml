@{
    ViewData["Title"] = "Book Parking Slot";
    var slot = ViewBag.Slot as SmartSlot.Models.ParkingSlot;
    var bookedRanges = ViewBag.BookedRanges as List<dynamic>;
    bool isExtension = ViewBag.ExtensionMode != null && (bool)ViewBag.ExtensionMode;
    DateTime? extensionStart = ViewBag.ExtensionStart as DateTime?;
}
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
<script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>

<style>
    body {
        background-image: url('/images/parking-bg.jpg');
        background-size: cover;
        background-position: center;
        background-attachment: fixed;
        background-color: #000 !important;
        color: white !important;
    }

    body::before {
        content: '';
        position: fixed;
        top: 0; left: 0;
        width: 100%; height: 100%;
        background: rgba(0, 0, 0, 0.78);
        z-index: 0;
    }

    .navbar { background-color: #111 !important; position: relative; z-index: 2; }
    .navbar-brand { color: white !important; }

    .page-wrapper {
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 40px 20px;
        position: relative;
        z-index: 1;
    }

    h2 { color: white; text-align: center; margin-bottom: 30px; }

    .card {
        background-color: rgba(26, 26, 26, 0.92);
        border: 1px solid #333;
        border-radius: 12px;
        padding: 30px;
        width: 100%;
        max-width: 480px;
        margin-bottom: 20px;
        position: relative;
        z-index: 1;
    }

    .card p { color: #ccc; margin: 8px 0; }

    .card label {
        color: #ccc;
        display: block;
        margin-top: 15px;
        margin-bottom: 5px;
    }

    .card input {
        width: 100%;
        padding: 10px;
        border-radius: 6px;
        border: 1px solid #444;
        background-color: #2a2a2a;
        color: white;
        font-size: 1rem;
        box-sizing: border-box;
    }

    .price-box {
        background-color: #222;
        border: 1px solid #28a745;
        border-radius: 8px;
        padding: 15px;
        margin-top: 20px;
        text-align: center;
    }

    .price-box h4 { color: #28a745; margin: 0; font-size: 1.4rem; }
    .price-box p { color: #aaa; margin: 5px 0 0 0; font-size: 0.85rem; }

    .btn-submit {
        width: 100%;
        padding: 12px;
        margin-top: 25px;
        background-color: #28a745;
        color: white;
        border: none;
        border-radius: 6px;
        font-size: 1.1rem;
        cursor: pointer;
        font-weight: bold;
    }

    .btn-submit:hover { background-color: #218838; }

    .upi-pay-btn {
        display: block;
        background: linear-gradient(135deg, #6f42c1, #28a745);
        color: white;
        text-align: center;
        padding: 12px;
        border-radius: 8px;
        font-size: 1.1rem;
        font-weight: bold;
        text-decoration: none;
        margin-top: 10px;
    }

    .upi-pay-btn:hover { opacity: 0.9; color: white; text-decoration: none; }

    .readonly-field {
        background-color: #1a1a1a !important;
        color: #888 !important;
        cursor: not-allowed;
    }
</style>

<div class="page-wrapper">
    <h2>&#9989; @(isExtension ? "Extend Parking Slot" : "Book Parking Slot")</h2>

    @if (isExtension)
    {
        <div style="background:#17a2b8;padding:12px;margin-bottom:20px;border-radius:8px;text-align:center;font-weight:bold;">
            🔄 Extension Mode — Select your new end time below
        </div>
    }

    <!-- Slot Details -->
    <div class="card">
        <h4 style="color:white; margin-bottom:15px;">&#128663; Slot Details</h4>
        <p>&#128100; Owner: <b style="color:white;">@slot.OwnerName</b></p>
        <p>&#128176; Rate: <b style="color:#28a745;">&#8377;@slot.PricePerHour / hr</b></p>
        <p>&#128663; Vehicle Type: <b style="color:white;">@slot.VehicleType</b></p>
        <p>&#9200; Available From: <b style="color:white;">@slot.AvailableFrom</b></p>
        <p>&#9200; Available To: <b style="color:white;">@slot.AvailableTo</b></p>

        @if (slot.PaymentMode == "UPI")
        {
            <div style="background:rgba(0,0,0,0.4); border:1px solid #28a745; border-radius:8px; padding:15px; margin-top:15px;">
                <p style="color:#28a745; font-weight:bold; font-size:1.1rem;">&#128179; Owner Accepts: UPI Payment</p>
                <p style="color:#ccc;">Click below to pay directly via your UPI app:</p>
                <p style="color:white; font-size:1rem; background:#2a2a2a; padding:10px; border-radius:6px;">
                    &#128242; UPI ID: <b>@slot.OwnerUpiId</b>
                </p>
                <a id="upiPayBtn"
                   href="upi://pay?pa=@slot.OwnerUpiId&pn=SmartSlot Parking&am=0&tn=Parking Payment"
                   class="upi-pay-btn"
                   onclick="paymentDone()">
                    &#128241; Pay with UPI App (GPay / PhonePe / Paytm)
                </a>
                <p style="color:#aaa; font-size:0.75rem; margin-top:8px; text-align:center;">
                    &#9888; Select your booking time first to calculate amount
                </p>
            </div>
        }
        else
        {
            <div style="background:rgba(0,0,0,0.4); border:1px solid #ffc107; border-radius:8px; padding:15px; margin-top:15px;">
                <p style="color:#ffc107; font-weight:bold; font-size:1.1rem;">&#128181; Owner Accepts: Cash on Delivery</p>
                <p style="color:#ccc;">Pay directly to the owner when you arrive at the parking slot.</p>
                <p style="color:#aaa; font-size:0.8rem;">&#9888; Please carry exact cash amount.</p>
            </div>
        }
    </div>

    <!-- Booking Form -->
    <div class="card">
        <form method="post" action="@(isExtension ? "/Parking/ConfirmExtension" : "/Parking/ConfirmBooking")">

            <input type="hidden" name="ParkingSlotId" value="@slot.Id" />
            <input type="hidden" name="totalAmount" id="totalAmountField" value="0" />
            <input type="hidden" name="ExistingBookingId" value="@(ViewBag.ExistingBookingId ?? 0)" />

            @if (!isExtension)
            {
                <!-- Normal booking — show name/phone/vehicle fields -->
                <label>Your Name</label>
                <input type="text" name="CustomerName" required />

                <label>Customer Phone Number</label>
                <input type="tel"
                       name="CustomerPhone"
                       placeholder="Enter your phone number"
                       maxlength="10"
                       pattern="[0-9]{10}"
                       required />

                <label>Vehicle Number</label>
                <input type="text" name="VehicleNumber" placeholder="TN01AB1234" required />
            }

            <label>Booking From</label>
         <input type="datetime-local"
       name="BookingFrom"
       id="bookingFrom"
       value="@(isExtension && extensionStart != null ? extensionStart.Value.ToString("yyyy-MM-ddTHH:mm") : ViewBag.IstNow)"
       min="@(isExtension ? slot.AvailableFrom.ToString("yyyy-MM-ddTHH:mm") : ViewBag.IstNow)"
                   max="@slot.AvailableTo.ToString("yyyy-MM-ddTHH:mm")"
                   class="@(isExtension ? "readonly-field" : "")"
                   @(isExtension ? "readonly" : "")
                   onchange="calculatePrice()"
                   required />

            @if (isExtension)
            {
                <p style="color:#17a2b8; font-size:0.8rem; margin-top:4px;">
                    ⏰ This is your previous booking end time — your extension starts here
                </p>
            }

            <label>@(isExtension ? "Extend To" : "Booking To")</label>
            <input type="datetime-local"
                   name="BookingTo"
                   id="bookingTo"
                   min="@(isExtension && extensionStart != null ? extensionStart.Value.ToString("yyyy-MM-ddTHH:mm") : slot.AvailableFrom.ToString("yyyy-MM-ddTHH:mm"))"
                   max="@slot.AvailableTo.ToString("yyyy-MM-ddTHH:mm")"
                   onchange="calculatePrice()"
                   required />

            <!-- Price Calculation Box -->
            <div class="price-box" id="priceBox" style="display:none;">
                <p>Duration: <span id="durationText"></span></p>
                <h4>Total: &#8377;<span id="totalPrice">0</span></h4>
                <p>&#64; &#8377;@slot.PricePerHour/hr</p>
            </div>

            @if (slot.PaymentMode == "UPI")
            {
                <div id="payNote" style="background:#2a2a2a; border:1px solid #ffc107;
                     border-radius:8px; padding:12px; margin-top:20px; text-align:center;">
                    <p style="color:#ffc107; margin:0; font-size:0.9rem;">
                        &#9888; Please complete UPI payment first then click Confirm
                    </p>
                </div>
                <button type="submit" class="btn-submit" id="confirmBtn"
                        style="display:none; background-color:#28a745;">
                    &#9989; @(isExtension ? "Confirm Extension (Payment Done)" : "Confirm Booking (Payment Done)")
                </button>
            }
            else
            {
                <button type="submit" class="btn-submit">
                    &#9989; @(isExtension ? "Confirm Extension" : "Confirm Booking")
                </button>
            }
        </form>
    </div>
</div>

<script>
    var bookedRanges = [];

    @if (bookedRanges != null)
    {
        foreach (var range in bookedRanges)
        {
            <text>
                bookedRanges.push({
                    from: new Date("@range.BookingFrom.ToString("yyyy-MM-ddTHH:mm:ss")"),
                    to: new Date("@range.BookingTo.ToString("yyyy-MM-ddTHH:mm:ss")")
                });
            </text>
        }
    }

    function isTimeBlocked(date) {
        for (var i = 0; i < bookedRanges.length; i++) {
            if (date >= bookedRanges[i].from && date < bookedRanges[i].to) {
                return true;
            }
        }
        return false;
    }

    @if (!isExtension)
    {
        <text>
        flatpickr("#bookingFrom", {
            enableTime: true,
            dateFormat: "Y-m-d H:i",
            minDate: "@slot.AvailableFrom.ToString("yyyy-MM-ddTHH:mm")",
            maxDate: "@slot.AvailableTo.ToString("yyyy-MM-ddTHH:mm")",
            disable: [function(date) { return isTimeBlocked(date); }],
            onChange: function() { calculatePrice(); }
        });
        </text>
    }

    flatpickr("#bookingTo", {
        enableTime: true,
        dateFormat: "Y-m-d H:i",
       minDate: "@(isExtension && extensionStart != null ? extensionStart.Value.ToString("yyyy-MM-ddTHH:mm") : ViewBag.IstNow)",
        maxDate: "@slot.AvailableTo.ToString("yyyy-MM-ddTHH:mm")",
        disable: [function(date) { return isTimeBlocked(date); }],
        onChange: function() { calculatePrice(); }
    });

    @if (isExtension)
    {
        <text>
        window.addEventListener("load", function () {
            calculatePrice();
        });
        </text>
    }

    function calculatePrice() {
        var from = document.getElementById("bookingFrom").value;
        var to = document.getElementById("bookingTo").value;

        if (from && to) {
            var fromDate = new Date(from);
            var toDate = new Date(to);

            if (toDate <= fromDate) {
                document.getElementById("priceBox").style.display = "none";
                return;
            }

            var diffMs = toDate - fromDate;
            var diffHours = diffMs / (1000 * 60 * 60);
            var pricePerHour = @(slot.PricePerHour);
            var total = (diffHours * pricePerHour).toFixed(2);

            var hours = Math.floor(diffHours);
            var minutes = Math.round((diffHours - hours) * 60);
            var durationText = hours > 0 ? hours + " hr " : "";
            durationText += minutes > 0 ? minutes + " min" : "";

            document.getElementById("durationText").innerText = durationText;
            document.getElementById("totalPrice").innerText = total;
            document.getElementById("totalAmountField").value = total;
            document.getElementById("priceBox").style.display = "block";

            var upiBtn = document.getElementById("upiPayBtn");
            if (upiBtn) {
                var ownerUpi = "@slot.OwnerUpiId";
                upiBtn.href = "upi://pay?pa=" + ownerUpi +
                    "&pn=SmartSlot Parking" +
                    "&am=" + total +
                    "&tn=Parking Payment";
            }
        }
    }

    function paymentDone() {
        setTimeout(function () {
            document.getElementById("confirmBtn").style.display = "block";
            document.getElementById("payNote").style.display = "none";
        }, 3000);
    }
</script>