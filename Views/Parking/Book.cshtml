@{
    ViewData["Title"] = "Book Parking Slot";
    Layout = "_Layout";
    var slot = ViewBag.Slot as SmartSlot.Models.ParkingSlot;
    var isExtension = ViewBag.ExtensionMode as bool? ?? false;
    var existingBookingId = ViewBag.ExistingBookingId as int?;
    var extensionStart = ViewBag.ExtensionStart != null
        ? ((DateTime)ViewBag.ExtensionStart).ToString("yyyy-MM-ddTHH:mm")
        : "";
    var istNow = ViewBag.IstNow as string ?? DateTime.UtcNow.AddHours(5.5).ToString("yyyy-MM-ddTHH:mm");
    var locationName = ViewBag.LocationName as string ?? "";

    // UPI: owner has UPI ID set
    var isUpi = slot != null && slot.PaymentMode?.ToLower().Contains("upi") == true && !string.IsNullOrEmpty(slot.OwnerUpiId);
}

<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@600;700;800&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet"/>

<style>
    *,*::before,*::after{box-sizing:border-box;margin:0;padding:0;}
    :root{
        --blue:#2563EB;--blue-light:#3B82F6;--blue-glow:rgba(37,99,235,0.35);
        --glass:rgba(20,30,48,0.72);--border:rgba(255,255,255,0.09);
        --text:#F1F5F9;--muted:#94A3B8;--green:#10b981;--orange:#F97316;--purple:#8B5CF6;
    }
    .orb{position:fixed;border-radius:50%;pointer-events:none;z-index:0;}
    .orb1{top:-15%;right:-5%;width:520px;height:520px;background:radial-gradient(circle,rgba(37,99,235,0.07) 0%,transparent 70%);}
    .orb2{bottom:-10%;left:-8%;width:440px;height:440px;background:radial-gradient(circle,rgba(16,185,129,0.05) 0%,transparent 70%);}
    .main{position:relative;z-index:1;max-width:820px;margin:0 auto;padding:40px 24px 80px;}
    .page-header{margin-bottom:32px;animation:fadeUp 0.45s ease both;}
    .page-header h1{font-family:'Poppins',sans-serif;font-weight:700;font-size:1.55rem;letter-spacing:-0.4px;margin-bottom:4px;}
    .page-header p{font-size:0.85rem;color:var(--muted);}
    .ext-banner{display:flex;align-items:center;gap:10px;padding:13px 18px;margin-bottom:24px;background:rgba(249,115,22,0.1);border:1px solid rgba(249,115,22,0.25);border-radius:12px;font-size:0.875rem;color:var(--orange);font-weight:500;animation:fadeUp 0.45s ease 0.05s both;}
    .book-card{background:var(--glass);backdrop-filter:blur(18px);-webkit-backdrop-filter:blur(18px);border:1px solid var(--border);border-radius:20px;padding:32px 36px;box-shadow:0 16px 48px rgba(0,0,0,0.35);animation:fadeUp 0.45s ease 0.1s both;}
    .slot-info{display:flex;gap:16px;flex-wrap:wrap;padding:16px 20px;margin-bottom:28px;background:rgba(15,23,42,0.55);border:1px solid var(--border);border-radius:12px;}
    .info-chip{display:flex;flex-direction:column;gap:2px;}
    .ic-label{font-size:0.68rem;text-transform:uppercase;letter-spacing:0.5px;color:var(--muted);font-weight:500;}
    .ic-val{font-size:0.9rem;font-weight:600;color:var(--text);}
    .ic-val.green{color:var(--green);}
    .section-title{font-family:'Poppins',sans-serif;font-weight:600;font-size:0.9rem;color:var(--muted);text-transform:uppercase;letter-spacing:0.5px;margin-bottom:16px;}
    .form-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:20px;}
    .form-group{display:flex;flex-direction:column;gap:6px;}
    .form-group.full{grid-column:1/-1;}
    .form-group label{font-size:0.78rem;font-weight:500;color:var(--muted);letter-spacing:0.3px;}
    .form-control{padding:12px 14px;background:rgba(15,23,42,0.7);border:1px solid var(--border);border-radius:10px;color:var(--text);font-family:'Inter',sans-serif;font-size:0.875rem;outline:none;transition:all 0.2s;width:100%;color-scheme:dark;}
    .form-control:focus{border-color:var(--blue);box-shadow:0 0 0 3px rgba(37,99,235,0.18);}
    .form-control::placeholder{color:rgba(148,163,184,0.45);}
    .locked-field{position:relative;}
    .locked-badge{font-size:10px;color:var(--orange);font-weight:600;letter-spacing:0.3px;margin-top:3px;}
    .divider{height:1px;background:linear-gradient(90deg,transparent,var(--border),transparent);margin:24px 0;}
    .price-preview{display:flex;align-items:center;justify-content:space-between;padding:16px 20px;background:rgba(16,185,129,0.08);border:1px solid rgba(16,185,129,0.18);border-radius:12px;margin-bottom:16px;}
    .pp-label{font-size:0.85rem;color:var(--muted);}
    .pp-price{font-family:'Poppins',sans-serif;font-weight:800;font-size:1.5rem;color:var(--green);}
    .pp-note{font-size:0.75rem;color:var(--muted);}

    /* UPI SECTION */
    .upi-pay-box{padding:22px;background:rgba(139,92,246,0.07);border:1px solid rgba(139,92,246,0.22);border-radius:16px;margin-bottom:16px;}
    .upi-pay-title{font-size:0.95rem;font-weight:700;color:#a78bfa;margin-bottom:4px;display:flex;align-items:center;gap:8px;}
    .upi-pay-subtitle{font-size:0.75rem;color:var(--muted);margin-bottom:18px;}
    .upi-amount-row{display:flex;align-items:center;justify-content:space-between;padding:12px 16px;background:rgba(16,185,129,0.07);border:1px solid rgba(16,185,129,0.15);border-radius:10px;margin-bottom:16px;}
    .upi-amount-label{font-size:0.8rem;color:var(--muted);}
    .upi-amount-val{font-family:'Poppins',sans-serif;font-size:1.25rem;font-weight:800;color:var(--green);}
    .btn-upi-pay{width:100%;padding:14px 20px;border:none;border-radius:12px;cursor:pointer;background:linear-gradient(90deg,#7c3aed,#6d28d9);color:#fff;font-family:'Inter',sans-serif;font-weight:700;font-size:0.95rem;box-shadow:0 6px 20px rgba(109,40,217,0.35);transition:all 0.25s;display:flex;align-items:center;justify-content:center;gap:10px;margin-bottom:14px;}
    .btn-upi-pay:hover:not(:disabled){transform:translateY(-2px);box-shadow:0 10px 28px rgba(109,40,217,0.45);}
    .btn-upi-pay:disabled{opacity:0.45;cursor:not-allowed;transform:none;}
    .upi-id-row{display:flex;align-items:center;gap:10px;padding:10px 14px;background:rgba(15,23,42,0.6);border:1px solid rgba(255,255,255,0.07);border-radius:10px;margin-bottom:14px;}
    .upi-id-label{font-size:0.72rem;color:var(--muted);white-space:nowrap;}
    .upi-id-val{font-size:0.85rem;color:#c4b5fd;font-weight:600;flex:1;word-break:break-all;}
    .btn-copy-upi{padding:5px 12px;background:rgba(139,92,246,0.15);border:1px solid rgba(139,92,246,0.25);border-radius:7px;color:#a78bfa;font-size:0.72rem;font-weight:600;cursor:pointer;white-space:nowrap;transition:all 0.2s;}
    .btn-copy-upi:hover{background:rgba(139,92,246,0.28);}
    .upi-steps{list-style:none;padding:0;margin:0 0 14px;}
    .upi-steps li{font-size:0.78rem;color:var(--muted);margin-bottom:7px;display:flex;align-items:flex-start;gap:8px;}
    .upi-steps li .num{background:rgba(139,92,246,0.18);color:#a78bfa;width:20px;height:20px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:10px;font-weight:700;flex-shrink:0;margin-top:1px;}
    .upi-confirm-area{display:none;padding:14px 16px;background:rgba(16,185,129,0.06);border:1px solid rgba(16,185,129,0.18);border-radius:12px;margin-top:4px;}
    .upi-confirm-area.visible{display:block;animation:fadeUp 0.3s ease both;}
    .upi-paid-check{display:flex;align-items:center;gap:10px;margin-bottom:4px;}
    .upi-paid-check input[type=checkbox]{width:18px;height:18px;accent-color:#10b981;cursor:pointer;flex-shrink:0;}
    .upi-paid-check label{font-size:0.85rem;color:#6ee7b7;font-weight:600;cursor:pointer;}
    .upi-confirm-note{font-size:0.72rem;color:var(--muted);margin-top:6px;}
    .upi-warn{display:none;margin-top:8px;padding:8px 12px;background:rgba(239,68,68,0.08);border:1px solid rgba(239,68,68,0.2);border-radius:8px;font-size:0.75rem;color:#fca5a5;}
    .payment-lock-notice{display:flex;align-items:center;gap:10px;padding:12px 16px;margin-bottom:8px;background:rgba(239,68,68,0.07);border:1px solid rgba(239,68,68,0.18);border-radius:10px;font-size:0.8rem;color:#fca5a5;font-weight:500;}
    .payment-lock-notice .lock-icon{font-size:1.1rem;flex-shrink:0;}

    /* Submit button */
    .btn-submit{width:100%;padding:15px;border:none;border-radius:12px;cursor:pointer;background:linear-gradient(90deg,var(--blue-light),var(--blue));color:#fff;font-family:'Inter',sans-serif;font-weight:700;font-size:1rem;box-shadow:0 6px 20px var(--blue-glow);transition:all 0.25s;margin-top:4px;}
    .btn-submit:hover:not(:disabled){transform:translateY(-2px);box-shadow:0 10px 28px var(--blue-glow);}
    .btn-submit:disabled{background:rgba(255,255,255,0.05)!important;color:rgba(148,163,184,0.4)!important;cursor:not-allowed!important;box-shadow:none!important;transform:none!important;border:1px solid rgba(255,255,255,0.07);}

    .back-link{display:inline-flex;align-items:center;gap:5px;color:var(--muted);text-decoration:none;font-size:0.83rem;margin-bottom:24px;transition:color 0.2s;}
    .back-link:hover{color:var(--text);}
    @@keyframes fadeUp{from{opacity:0;transform:translateY(14px);}to{opacity:1;transform:translateY(0);}}
    @@media(max-width:600px){
        .form-grid{grid-template-columns:1fr;}
        .slot-info{flex-direction:column;}
        .book-card{padding:24px 20px;}
    }
</style>

<div class="orb orb1"></div>
<div class="orb orb2"></div>

<div class="main">
    <a href="/Parking/Search" class="back-link">&#8592; Back to Search</a>

    <div class="page-header">
        <h1>@(isExtension ? "Extend Your Booking" : "Book Parking Slot")</h1>
        <p>@(isExtension ? "Extend your current parking duration" : "Complete your booking details below")</p>
    </div>

    @if (isExtension)
    {
        <div class="ext-banner">
            Extension Mode &#8212; Booking starts from
            <strong style="margin:0 4px;">@(((DateTime)ViewBag.ExtensionStart).ToString("dd MMM, hh:mm tt"))</strong>.
            Only select a new end time.
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div style="padding:13px 18px;margin-bottom:20px;background:rgba(220,38,38,0.1);border:1px solid rgba(220,38,38,0.28);border-radius:12px;color:#f87171;font-size:0.875rem;font-weight:500;">
            &#9888; @TempData["Error"]
        </div>
    }

    <div class="book-card">
        @if (slot != null)
        {
            <div class="slot-info">
                <div class="info-chip"><span class="ic-label">Owner</span><span class="ic-val">@slot.OwnerName</span></div>
                <div class="info-chip"><span class="ic-label">Rate</span><span class="ic-val green">&#8377;@slot.PricePerHour / hr</span></div>
                <div class="info-chip"><span class="ic-label">Vehicle Type</span><span class="ic-val">@slot.VehicleType</span></div>
                <div class="info-chip"><span class="ic-label">Location</span><span class="ic-val" id="locationDisplay" style="font-size:0.82rem;">@(string.IsNullOrEmpty(locationName) ? "Fetching location..." : locationName)</span></div>
                @if (!string.IsNullOrEmpty(slot.PaymentMode))
                {
                    <div class="info-chip"><span class="ic-label">Payment</span><span class="ic-val">@slot.PaymentMode</span></div>
                }
            </div>
        }

        @{ var formAction = isExtension ? "/Parking/ConfirmExtension" : "/Parking/ConfirmBooking"; }

        <form method="post" action="@formAction" onsubmit="return validateForm()">
            @if (slot != null)
            {
                <input type="hidden" name="ParkingSlotId" value="@slot.Id"/>
                <input type="hidden" name="PricePerHour"  value="@slot.PricePerHour"/>
            }
            @if (isExtension && existingBookingId.HasValue)
            {
                <input type="hidden" name="ExistingBookingId" value="@existingBookingId.Value"/>
            }
            <input type="hidden" name="totalAmount" id="totalAmountField" value="0"/>

            <div class="section-title">Personal Details</div>
            <div class="form-grid">
                <div class="form-group">
                    <label>Full Name</label>
                    <input type="text" name="CustomerName" class="form-control" placeholder="Your full name" required/>
                </div>
                <div class="form-group">
                    <label>Phone Number</label>
                    <input type="tel" name="CustomerPhone" class="form-control" placeholder="+91 XXXXX XXXXX" required/>
                </div>
                <div class="form-group full">
                    <label>Vehicle Number</label>
                    <input type="text" name="VehicleNumber" class="form-control" placeholder="e.g. TN 01 AB 1234" required/>
                </div>
            </div>

            <div class="divider"></div>
            <div class="section-title">Booking Duration</div>
            <div class="form-grid">
                <div class="form-group @(isExtension ? "locked-field" : "")">
                    <label>From</label>
                    @if (isExtension)
                    {
                        <input type="hidden" name="BookingFrom" value="@extensionStart"/>
                        <input type="text" id="bookingFrom" class="form-control"
                               value="@(ViewBag.ExtensionStart != null ? ((DateTime)ViewBag.ExtensionStart).ToString("dd MMM yyyy, hh:mm tt") : extensionStart)"
                               readonly disabled
                               style="cursor:not-allowed;opacity:0.6;border-color:rgba(249,115,22,0.3);background:rgba(249,115,22,0.06);color:#F97316;"/>
                        <span class="locked-badge">&#128274; Locked — continues from your previous booking end time</span>
                    }
                    else
                    {
                        <input type="datetime-local" name="BookingFrom" id="bookingFrom"
                               class="form-control" value="@istNow" min="@istNow" required/>
                    }
                </div>
                <div class="form-group">
                    <label>To</label>
                    <input type="datetime-local" name="BookingTo" id="bookingTo"
                           class="form-control" min="@(isExtension ? extensionStart : istNow)" required/>
                </div>
            </div>

            <div class="price-preview">
                <div>
                    <div class="pp-label">Estimated Cost</div>
                    <div class="pp-note" id="durationNote">Select times to calculate</div>
                </div>
                <div class="pp-price" id="priceDisplay">&#8377;&#8212;</div>
            </div>

            @if (isUpi)
            {
                <!-- UPI DEEP LINK PAYMENT SECTION -->
                <div class="upi-pay-box" id="upiPayBox">
                    <div class="upi-pay-title">
                        <svg viewBox="0 0 24 24" fill="none" width="20" height="20">
                            <rect x="2" y="5" width="20" height="14" rx="3" stroke="#a78bfa" stroke-width="1.5"/>
                            <path d="M7 12h4M7 12l2-2M7 12l2 2" stroke="#a78bfa" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                            <path d="M13 9l4 3-4 3" stroke="#c4b5fd" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                        Step 1 — Pay via UPI
                    </div>
                    <div class="upi-pay-subtitle">Tap the button below to open your UPI app and pay directly to the owner.</div>

                    <div class="upi-amount-row">
                        <span class="upi-amount-label">Amount to Pay</span>
                        <span class="upi-amount-val" id="upiAmountDisplay">&#8377;&#8212;</span>
                    </div>

                    <div class="upi-id-row">
                        <span class="upi-id-label">UPI ID:</span>
                        <span class="upi-id-val" id="upiIdDisplay">@slot.OwnerUpiId</span>
                        <button type="button" class="btn-copy-upi" onclick="copyUpiId()">&#128203; Copy</button>
                    </div>

                    <ul class="upi-steps">
                        <li><span class="num">1</span>Select your booking time above to see the amount</li>
                        <li><span class="num">2</span>Tap "Pay via UPI App" — your installed UPI apps will appear</li>
                        <li><span class="num">3</span>Choose GPay / PhonePe / Paytm or any UPI app and complete payment</li>
                        <li><span class="num">4</span>Return here and tick the confirmation checkbox below</li>
                    </ul>

                    <button type="button" class="btn-upi-pay" id="upiPayBtn" onclick="openUpiApp()" disabled>
                        <svg viewBox="0 0 24 24" fill="none" width="22" height="22">
                            <rect x="2" y="5" width="20" height="14" rx="3" fill="rgba(255,255,255,0.1)" stroke="white" stroke-width="1.5"/>
                            <path d="M7 12h4M7 12l2-2M7 12l2 2" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                            <path d="M13 9l4 3-4 3" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                        <span id="upiPayBtnText">Select booking time first</span>
                    </button>

                    <div class="upi-confirm-area" id="upiConfirmArea">
                        <div class="upi-paid-check">
                            <input type="checkbox" id="upiPaidCheck" onchange="onPaymentChecked()"/>
                            <label for="upiPaidCheck">I have successfully completed the UPI payment</label>
                        </div>
                        <div class="upi-confirm-note">Confirm Booking will unlock once you tick this.</div>
                    </div>
                    <div class="upi-warn" id="upiWarn">&#9888; Please tap "Pay via UPI App" button first to open your UPI app.</div>
                </div>

                <div class="payment-lock-notice" id="paymentLockNotice">
                    <span class="lock-icon">&#128274;</span>
                    <span><strong>Step 2 — Confirm Booking</strong> is locked until you complete UPI payment above.</span>
                </div>
            }

            <!-- ✅ FIX: button text as plain HTML, not inside Razor string expression -->
            @if (isExtension)
            {
                <button type="submit" class="btn-submit" id="submitBtn" @(isUpi ? "disabled" : "")>
                    &#10003; Confirm Extension
                </button>
            }
            else
            {
                <button type="submit" class="btn-submit" id="submitBtn" @(isUpi ? "disabled" : "")>
                    &#10003; Confirm Booking
                </button>
            }

        </form>
    </div>
</div>

<script>
var pricePerHour  = @(slot?.PricePerHour ?? 0);
var ownerUpiId    = "@(slot?.OwnerUpiId ?? "")";
var ownerName     = "@(slot?.OwnerName ?? "")";
var currentAmount = 0;
var isUpi         = @(isUpi ? "true" : "false");
var upiPayOpened  = false;

// Reverse geocode slot location
(function(){
    var lat = @(slot?.Latitude ?? 0), lon = @(slot?.Longitude ?? 0);
    if (!lat || !lon) return;
    fetch('https://nominatim.openstreetmap.org/reverse?lat='+lat+'&lon='+lon+'&format=json')
        .then(r => r.json())
        .then(function(d){
            var el = document.getElementById('locationDisplay'); if (!el) return;
            var a = d.address || {}, p = [];
            if (a.road) p.push(a.road);
            if (a.suburb || a.neighbourhood) p.push(a.suburb || a.neighbourhood);
            if (a.city || a.town || a.village) p.push(a.city || a.town || a.village);
            el.textContent = p.length ? p.join(', ') : (d.display_name || 'Location found');
        }).catch(function(){});
})();

// Price calculator
function calcPrice() {
    var fe = document.querySelector('input[name="BookingFrom"][type="hidden"]') || document.getElementById('bookingFrom');
    var fr = fe ? fe.value : '';
    var to = document.getElementById('bookingTo').value;
    if (!fr || !to) return;
    var d = (new Date(to) - new Date(fr)) / 3600000;
    if (d <= 0) {
        document.getElementById('priceDisplay').textContent = '₹--';
        document.getElementById('durationNote').textContent = 'End time must be after start';
        document.getElementById('totalAmountField').value   = '0';
        currentAmount = 0;
        updateUpiAmount();
        return;
    }
    currentAmount = Math.ceil(d * pricePerHour);
    document.getElementById('priceDisplay').textContent = '₹' + currentAmount;
    document.getElementById('durationNote').textContent = d.toFixed(1) + ' hr' + (d !== 1 ? 's' : '');
    document.getElementById('totalAmountField').value   = currentAmount;
    updateUpiAmount();
}

function updateUpiAmount() {
    var el = document.getElementById('upiAmountDisplay');
    if (el) el.textContent = currentAmount > 0 ? '₹' + currentAmount : '₹--';

    var payBtn     = document.getElementById('upiPayBtn');
    var payBtnText = document.getElementById('upiPayBtnText');
    if (payBtn && isUpi) {
        if (currentAmount > 0) {
            payBtn.disabled = false;
            payBtnText.textContent = 'Pay ₹' + currentAmount + ' via UPI App';
        } else {
            payBtn.disabled = true;
            payBtnText.textContent = 'Select booking time first';
        }
    }
}

// Open UPI deep link
function openUpiApp() {
    if (currentAmount <= 0) { alert('Please select booking times first.'); return; }
    if (!ownerUpiId) { alert('Owner UPI ID not found. Please contact support.'); return; }

    var upiLink = 'upi://pay'
        + '?pa=' + encodeURIComponent(ownerUpiId)
        + '&pn=' + encodeURIComponent(ownerName)
        + '&am=' + currentAmount
        + '&cu=INR'
        + '&tn=' + encodeURIComponent('SmartSlot Parking Payment');

    window.location.href = upiLink;
    upiPayOpened = true;

    // Show confirmation area after returning from UPI app
    setTimeout(function() {
        var confirmArea = document.getElementById('upiConfirmArea');
        if (confirmArea) {
            confirmArea.classList.add('visible');
            confirmArea.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
        var payBtn = document.getElementById('upiPayBtn');
        if (payBtn) {
            payBtn.style.background   = 'linear-gradient(90deg,#059669,#10b981)';
            payBtn.style.boxShadow    = '0 6px 20px rgba(16,185,129,0.35)';
        }
        if (document.getElementById('upiPayBtnText'))
            document.getElementById('upiPayBtnText').textContent = 'Payment initiated — tick below to confirm';
    }, 1500);
}

// Copy UPI ID
function copyUpiId() {
    navigator.clipboard.writeText(ownerUpiId).then(function() {
        var btn = document.querySelector('.btn-copy-upi');
        if (btn) { btn.textContent = 'Copied!'; setTimeout(function(){ btn.textContent = '📋 Copy'; }, 2000); }
    }).catch(function() {
        var ta = document.createElement('textarea');
        ta.value = ownerUpiId; document.body.appendChild(ta);
        ta.select(); document.execCommand('copy'); document.body.removeChild(ta);
        var btn = document.querySelector('.btn-copy-upi');
        if (btn) { btn.textContent = 'Copied!'; setTimeout(function(){ btn.textContent = '📋 Copy'; }, 2000); }
    });
}

// Checkbox unlock — only works if Pay button was clicked first
function onPaymentChecked() {
    var checked = document.getElementById('upiPaidCheck').checked;
    var btn     = document.getElementById('submitBtn');
    var warn    = document.getElementById('upiWarn');
    var notice  = document.getElementById('paymentLockNotice');

    if (checked && !upiPayOpened) {
        document.getElementById('upiPaidCheck').checked = false;
        warn.style.display = 'block';
        warn.textContent = '⚠ Please tap "Pay via UPI App" button first to open your UPI app.';
        return;
    }

    btn.disabled = !checked;
    if (checked) {
        if (warn)   warn.style.display   = 'none';
        if (notice) notice.style.display = 'none';
    } else {
        if (notice) notice.style.display = 'flex';
    }
}

// Time input listeners
var fe = document.querySelector('input[name="BookingFrom"][type="hidden"]') || document.getElementById('bookingFrom');
if (fe && fe.type !== 'hidden') {
    fe.addEventListener('change', function() {
        document.getElementById('bookingTo').min = this.value;
        calcPrice();
    });
}
document.getElementById('bookingTo').addEventListener('change', calcPrice);

// Form validation safety net
function validateForm() {
    var fe = document.querySelector('input[name="BookingFrom"][type="hidden"]') || document.getElementById('bookingFrom');
    var fr = new Date(fe ? fe.value : '');
    var to = new Date(document.getElementById('bookingTo').value);
    if (!document.getElementById('bookingTo').value) { alert('Please select an end time.'); return false; }
    if (to <= fr) { alert('End time must be after start time.'); return false; }
    if (isUpi) {
        var c = document.getElementById('upiPaidCheck');
        if (!upiPayOpened) {
            document.getElementById('upiWarn').style.display = 'block';
            document.getElementById('upiPayBox').scrollIntoView({ behavior: 'smooth', block: 'center' });
            return false;
        }
        if (c && !c.checked) {
            document.getElementById('upiWarn').style.display = 'block';
            document.getElementById('upiPayBox').scrollIntoView({ behavior: 'smooth', block: 'center' });
            return false;
        }
    }
    return true;
}

calcPrice();
</script>
