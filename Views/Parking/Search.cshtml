@{
    ViewData["Title"] = "Find Parking Near Me";
}

<style>
    body {
        background-image: url('https://i.pinimg.com/1200x/ea/3f/92/ea3f92fcdab7799f742c813cdb651463.jpg');
        background-size: cover;
        background-position: center;
        background-attachment: fixed;
        background-color: #000 !important;
        color: white !important;
    }

    body::before {
        content: '';
        position: fixed;
        width: 100%;
        height: 100%;
        background: rgba(0,0,0,0.78);
        z-index: 0;
    }

    h2 { text-align:center; margin:20px 0; position:relative; z-index:1; }

    .top-section { text-align:center; position:relative; z-index:1; padding:20px; }

    .btn-location {
        padding:10px 20px;
        background:#28a745;
        color:white;
        border:none;
        border-radius:6px;
        cursor:pointer;
        font-size:15px;
        font-weight:600;
    }
    .btn-location:hover { background:#218838; }

    .search-row { margin-top:10px; }

    .search-row input {
        padding:10px;
        width:280px;
        border-radius:6px;
        border:1px solid #444;
        background:#2a2a2a;
        color:white;
    }

    .search-row button {
        padding:10px 15px;
        background:#007bff;
        color:white;
        border:none;
        border-radius:6px;
        cursor:pointer;
    }

    #status {
        margin-top:10px;
        font-size:15px;
        font-weight:600;
        min-height:24px;
    }

    .searching { color: #f59e0b; animation: blink 1s infinite alternate; }
    @@keyframes blink { from { opacity: 0.5; } to { opacity: 1; } }

    .found-msg    { color: #4ade80; }
    .notfound-msg { color: #f87171; }

    #map { height:500px; margin:20px; border-radius:10px; z-index:1; position:relative; }

    .toggle-section {
        display:none;
        text-align:center;
        margin-top:20px;
        margin-bottom:30px;
        z-index:1;
        position:relative;
    }

    .toggle-section button {
        padding:10px 22px;
        border:none;
        border-radius:6px;
        margin:0 10px;
        cursor:pointer;
        font-weight:bold;
        font-size:15px;
    }

    .available-btn { background:#28a745; color:white; }
    .booked-btn    { background:#dc3545; color:white; }

    .time-filter-box {
        margin: 16px auto;
        background: rgba(26,26,26,0.95);
        border: 1px solid #444;
        border-radius: 12px;
        padding: 20px;
        max-width: 560px;
    }

    .time-filter-box label { color:#ccc; font-size:13px; display:block; margin-bottom:4px; }

    .time-filter-box input[type="datetime-local"] {
        padding: 8px 12px;
        border-radius: 6px;
        border: 1px solid #555;
        background: #2a2a2a;
        color: white;
        font-size: 14px;
        width: 100%;
        box-sizing: border-box;
    }

    .proceed-btn {
        margin-top: 14px;
        padding: 12px 30px;
        background: linear-gradient(135deg, #28a745, #20c997);
        color: white;
        border: none;
        border-radius: 8px;
        font-size: 15px;
        font-weight: bold;
        cursor: pointer;
        width: 100%;
        transition: transform 0.2s;
    }

    .proceed-btn:hover { transform: translateY(-2px); }
</style>

<h2>🔍 Find Parking Near Me</h2>

<div class="top-section">
    <button class="btn-location" onclick="useLiveLocation()">📍 Use My Live Location</button>

    <div class="search-row">
        <input type="text" id="searchAddress" placeholder="Search your area / address" />
        <button onclick="searchByAddress()">🔍 Search (3 km)</button>
    </div>

    <!-- Time Filter Box -->
    <div class="time-filter-box">
        <p style="color:#f59e0b; font-weight:bold; margin-bottom:14px; font-size:15px;">
            🗓 When do you need parking?
        </p>
        <div style="display:flex; gap:16px; flex-wrap:wrap; justify-content:center;">
            <div style="flex:1; min-width:200px;">
                <label>Parking From</label>
                <input type="datetime-local" id="filterFrom" />
            </div>
            <div style="flex:1; min-width:200px;">
                <label>Parking To</label>
                <input type="datetime-local" id="filterTo" />
            </div>
        </div>
        <button class="proceed-btn" onclick="proceedSearch()">
            🚀 Proceed — Find Available Slots
        </button>
    </div>

    <p id="status"></p>

    @if (TempData["ExtensionError"] != null)
    {
        <div style="background:#dc3545;padding:12px;margin:15px auto;max-width:600px;border-radius:8px;text-align:center;font-weight:bold;">
            @TempData["ExtensionError"]
        </div>
    }
</div>

<div id="map"></div>

<div id="toggleSection" class="toggle-section">
    <button class="available-btn" onclick="goToAvailable()">🟢 Available Slots</button>
    <button class="booked-btn"    onclick="goToBooked()">🔴 Booked Slots</button>
</div>

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"/>
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

<script>

var map = L.map('map').setView([13.0827, 80.2707], 13);
L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png').addTo(map);

var markerLayer = L.layerGroup().addTo(map);
var searchCircle = null;
var availableSlots = [];
var bookedSlots = [];
var userLat, userLon;
var filterFromVal = null;
var filterToVal = null;

var greenIcon = L.icon({
    iconUrl: 'https://raw.githubusercontent.com/pointhi/leaflet-color-markers/master/img/marker-icon-green.png',
    shadowUrl: 'https://unpkg.com/leaflet@1.9.4/dist/images/marker-shadow.png',
    iconSize: [25, 41], iconAnchor: [12, 41]
});

var redIcon = L.icon({
    iconUrl: 'https://raw.githubusercontent.com/pointhi/leaflet-color-markers/master/img/marker-icon-red.png',
    shadowUrl: 'https://unpkg.com/leaflet@1.9.4/dist/images/marker-shadow.png',
    iconSize: [25, 41], iconAnchor: [12, 41]
});

function getDistanceKm(lat1, lon1, lat2, lon2) {
    var R = 6371;
    var dLat = (lat2 - lat1) * Math.PI / 180;
    var dLon = (lon2 - lon1) * Math.PI / 180;
    var a = Math.sin(dLat/2)*Math.sin(dLat/2) +
            Math.cos(lat1*Math.PI/180)*Math.cos(lat2*Math.PI/180)*
            Math.sin(dLon/2)*Math.sin(dLon/2);
    return (R * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1-a))).toFixed(2);
}

function getSlotStatus(score) {
    if (!score)    return "—";
    if (score>=80) return "🥇 Premium";
    if (score>=70) return "🥈 Gold";
    if (score>=50) return "🥉 Silver";
    if (score>=30) return "🏠 Basic";
    return "❌ Poor";
}

function setStatus(msg, type) {
    var el = document.getElementById("status");
    el.className = type || "";
    el.innerHTML = msg;
}

function resetUI() {
    document.getElementById("toggleSection").style.display = "none";
    markerLayer.clearLayers();
    if (searchCircle) { map.removeLayer(searchCircle); searchCircle = null; }
}

function useLiveLocation() {
    setStatus("📡 Getting your location...", "searching");
    navigator.geolocation.getCurrentPosition(function(pos) {
        userLat = pos.coords.latitude;
        userLon = pos.coords.longitude;
        map.setView([userLat, userLon], 14);
        markerLayer.clearLayers();
        markerLayer.addLayer(
            L.marker([userLat, userLon]).bindPopup("📍 You are here!").openPopup()
        );
        setStatus("✅ Location set! Now select your parking time and click Proceed.", "found-msg");
    }, function() {
        setStatus("❌ Location access denied.", "notfound-msg");
    });
}

function searchByAddress() {
    var address = document.getElementById("searchAddress").value.trim();
    if (!address) return;

    setStatus("🔍 Finding <b>" + address + "</b>...", "searching");

    fetch("https://nominatim.openstreetmap.org/search?q=" +
        encodeURIComponent(address) + "&format=json&limit=1")
    .then(res => res.json())
    .then(data => {
        if (!data.length) {
            setStatus("❌ Location not found.", "notfound-msg");
            return;
        }
        userLat = parseFloat(data[0].lat);
        userLon = parseFloat(data[0].lon);
        map.setView([userLat, userLon], 14);
        markerLayer.clearLayers();
        markerLayer.addLayer(
            L.marker([userLat, userLon]).bindPopup("📍 " + address).openPopup()
        );
        setStatus("✅ Location set! Now select your parking time and click Proceed.", "found-msg");
    });
}

function proceedSearch() {
    filterFromVal = document.getElementById("filterFrom").value;
    filterToVal   = document.getElementById("filterTo").value;

    if (!filterFromVal || !filterToVal) {
        alert("Please select both Parking From and Parking To times!");
        return;
    }

    if (new Date(filterToVal) <= new Date(filterFromVal)) {
        alert("Parking To time must be after Parking From time!");
        return;
    }

    if (!userLat || !userLon) {
        alert("Please use live location or search an address first!");
        return;
    }

    performSearch(userLat, userLon);
}

function performSearch(lat, lon) {
    resetUI();
    userLat = lat;
    userLon = lon;

    map.setView([lat, lon], 14);

    markerLayer.addLayer(
        L.marker([lat, lon]).bindPopup("📍 You are here!").openPopup()
    );

    searchCircle = L.circle([lat, lon], {
        color: 'blue', fillColor: '#3f51b5', fillOpacity: 0.15, radius: 3000
    }).addTo(map);

    setStatus("⏳ Searching for parking slots nearby...", "searching");

    var url = "/Parking/NearbySlots?lat=" + lat + "&lon=" + lon + "&radius=3";
    if (filterFromVal && filterToVal) {
        url += "&fromTime=" + encodeURIComponent(filterFromVal) +
               "&toTime="   + encodeURIComponent(filterToVal);
    }

    fetch(url)
    .then(res => res.json())
    .then(slots => {
        if (!slots || !slots.length) {
            setStatus("😕 No parking slots found within 3 km.", "notfound-msg");
            return;
        }

        availableSlots = slots.filter(s => !s.isBooked);
        bookedSlots    = slots.filter(s =>  s.isBooked);

        var coordCount = {};

        availableSlots.forEach(function(slot) {
            var slotLat = parseFloat(slot.latitude);
            var slotLon = parseFloat(slot.longitude);
            if (isNaN(slotLat) || isNaN(slotLon)) return;

            var key = slotLat.toFixed(6) + "," + slotLon.toFixed(6);
            if (!coordCount[key]) coordCount[key] = 0;
            else coordCount[key]++;
            var offset = coordCount[key] * 0.00015;

            var dist = getDistanceKm(lat, lon, slotLat, slotLon);

            markerLayer.addLayer(
                L.marker([slotLat + offset, slotLon + offset], { icon: greenIcon })
                .bindPopup(
                    "<b>" + slot.ownerName + "</b><br>" +
                    "₹" + slot.pricePerHour + "/hr<br>" +
                    slot.vehicleType + "<br>🟢 Available<br>" +
                    dist + " km away"
                )
            );
        });

        bookedSlots.forEach(function(slot) {
            var slotLat = parseFloat(slot.latitude);
            var slotLon = parseFloat(slot.longitude);
            if (isNaN(slotLat) || isNaN(slotLon)) return;

            var key = slotLat.toFixed(6) + "," + slotLon.toFixed(6);
            if (!coordCount[key]) coordCount[key] = 0;
            else coordCount[key]++;
            var offset = coordCount[key] * 0.00015;

            var dist = getDistanceKm(lat, lon, slotLat, slotLon);

            markerLayer.addLayer(
                L.marker([slotLat + offset, slotLon + offset], { icon: redIcon })
                .bindPopup(
                    "<b>" + slot.ownerName + "</b><br>" +
                    "₹" + slot.pricePerHour + "/hr<br>" +
                    slot.vehicleType + "<br>🔴 Booked<br>" +
                    dist + " km away"
                )
            );
        });

        var filterMsg = filterFromVal && filterToVal
            ? " for <b>" + new Date(filterFromVal).toLocaleString() +
              "</b> → <b>" + new Date(filterToVal).toLocaleString() + "</b>"
            : "";

        setStatus(
            "✅ Found <b>" + availableSlots.length + " available</b> and <b>" +
            bookedSlots.length + " booked</b> slot(s) nearby" + filterMsg + ".",
            "found-msg"
        );

        document.getElementById("toggleSection").style.display = "block";
    })
    .catch(function() {
        setStatus("❌ Failed to load slots. Please try again.", "notfound-msg");
    });
}

// ── Navigate to separate pages with filter times ──
function goToAvailable() {
    if (!userLat || !userLon) return;
    var url = "/Parking/AvailableSlots?lat=" + userLat + "&lon=" + userLon + "&radius=3";
    if (filterFromVal && filterToVal) {
        url += "&fromTime=" + encodeURIComponent(filterFromVal) +
               "&toTime="   + encodeURIComponent(filterToVal);
    }
    window.location.href = url;
}

function goToBooked() {
    if (!userLat || !userLon) return;
    var url = "/Parking/BookedSlots?lat=" + userLat + "&lon=" + userLon + "&radius=3";
    if (filterFromVal && filterToVal) {
        url += "&fromTime=" + encodeURIComponent(filterFromVal) +
               "&toTime="   + encodeURIComponent(filterToVal);
    }
    window.location.href = url;
}

// Auto refresh every 60 seconds
setInterval(function() {
    if (!userLat || !userLon || !filterFromVal || !filterToVal) return;
    performSearch(userLat, userLon);
}, 60000);

</script>