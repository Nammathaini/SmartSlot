

@{
    ViewData["Title"] = "Find Parking Near Me";
}

<style>
    body {
        background-image: url('https://i.pinimg.com/1200x/ea/3f/92/ea3f92fcdab7799f742c813cdb651463.jpg');
        background-size: cover;
        background-position: center;
        background-attachment: fixed;
        background-color: #000 !important;
        color: white !important;
    }

    body::before {
        content: '';
        position: fixed;
        top: 0; left: 0;
        width: 100%; height: 100%;
        background: rgba(0, 0, 0, 0.78);
        z-index: 0;
    }

    .navbar {
        background-color: #111 !important;
        position: relative;
        z-index: 2;
    }

    .navbar-brand { color: white !important; }

    h2 {
        color: white;
        text-align: center;
        margin-bottom: 20px;
        font-size: 2rem;
        position: relative;
        z-index: 1;
    }

    .btn-location {
        padding: 10px 25px;
        background-color: #28a745;
        color: white;
        border: none;
        border-radius: 6px;
        cursor: pointer;
        font-size: 1rem;
        margin-bottom: 8px;
    }

    .search-row {
        display: flex;
        gap: 8px;
        margin-top: 10px;
        justify-content: center;
    }

    .search-row input {
        padding: 10px;
        width: 300px;
        border-radius: 6px;
        border: 1px solid #444;
        background-color: #2a2a2a;
        color: white;
        font-size: 1rem;
    }

    .search-row button {
        padding: 10px 15px;
        background-color: #007bff;
        color: white;
        border: none;
        border-radius: 6px;
        cursor: pointer;
        font-size: 1rem;
    }

    .status-text {
        color: #aaa;
        font-size: 0.85rem;
        text-align: center;
        margin-top: 5px;
    }

    #map {
        margin: 0 20px;
        border-radius: 10px;
        position: relative;
        z-index: 1;
    }

    #slotsBox {
        margin: 20px;
        background-color: rgba(26, 26, 26, 0.92);
        border: 1px solid #333;
        border-radius: 10px;
        padding: 15px;
        color: white;
        position: relative;
        z-index: 1;
    }

    #slotsBox h4 { color: white; }
    #slotsBox table th { background-color: #2a2a2a; color: white; }
    #slotsBox table td { color: #ddd; vertical-align: middle; }

    #status { position: relative; z-index: 1; }

    .top-section {
        position: relative;
        z-index: 1;
        text-align: center;
        padding: 20px;
    }

    .slot-badge {
        display: inline-block;
        padding: 5px 14px;
        border-radius: 20px;
        font-weight: bold;
        font-size: 0.8rem;
        color: white;
    }
</style>

<h2>🔍 Find Parking Near Me</h2>

<div class="top-section">
    <button type="button" class="btn-location" onclick="findParking()">📍 Use My Live Location</button>
    <p id="locationStatus" class="status-text"></p>

    <div class="search-row">
        <input type="text" id="searchAddress" placeholder="Search your area / address" />
        <button type="button" onclick="searchByAddress()">🔍</button>
    </div>
    <p id="addressStatus" class="status-text"></p>
</div>

<p id="status" style="text-align:center; color:#aaa;">Click above to find parking slots near you.</p>

<div id="map" style="height: 500px; margin-top: 20px;"></div>

<div id="slotsBox" style="display:none; margin-top: 20px;">
    <h4>🅿️ Nearby Parking Slots</h4>
    <div style="overflow-x:auto;">
        <table style="width:100%; border-collapse: collapse;">
            <thead>
                <tr>
                    <th style="padding:8px; border:1px solid #444;">Owner</th>
                    <th style="padding:8px; border:1px solid #444;">Price</th>
                    <th style="padding:8px; border:1px solid #444;">Vehicle</th>
                    <th style="padding:8px; border:1px solid #444;">Available From</th>
                    <th style="padding:8px; border:1px solid #444;">Available To</th>
                    <th style="padding:8px; border:1px solid #444;">Status</th>
                    <th style="padding:8px; border:1px solid #444;">Distance</th>
                    <th style="padding:8px; border:1px solid #444;">Rating</th>
                    <th style="padding:8px; border:1px solid #444;">Slot Status</th>
                    <th style="padding:8px; border:1px solid #444;">Action</th>
                </tr>
            </thead>
            <tbody id="slotsTableBody"></tbody>
        </table>
    </div>
</div>

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

<script>
    var map = L.map('map').setView([13.0827, 80.2707], 13);

    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        attribution: '© OpenStreetMap contributors'
    }).addTo(map);

    var greenIcon = L.icon({
        iconUrl: 'https://raw.githubusercontent.com/pointhi/leaflet-color-markers/master/img/marker-icon-green.png',
        shadowUrl: 'https://unpkg.com/leaflet@1.9.4/dist/images/marker-shadow.png',
        iconSize: [25, 41], iconAnchor: [12, 41], popupAnchor: [1, -34],
    });

    var redIcon = L.icon({
        iconUrl: 'https://raw.githubusercontent.com/pointhi/leaflet-color-markers/master/img/marker-icon-red.png',
        shadowUrl: 'https://unpkg.com/leaflet@1.9.4/dist/images/marker-shadow.png',
        iconSize: [25, 41], iconAnchor: [12, 41], popupAnchor: [1, -34],
    });

    function getScoreBadge(score) {
        if (!score || score === 0) return "<span style='color:#aaa;'>—</span>";
        var label, color, textColor;
        if (score >= 80) { label = "🥇 Premium"; color = "#FFD700"; textColor = "#000"; }
        else if (score >= 70) { label = "🥈 Gold"; color = "#C0C0C0"; textColor = "#000"; }
        else if (score >= 50) { label = "🥉 Silver"; color = "#CD7F32"; textColor = "#fff"; }
        else if (score >= 30) { label = "🏠 Basic"; color = "#28a745"; textColor = "#fff"; }
        else { label = "❌ Poor"; color = "#dc3545"; textColor = "#fff"; }
        return "<span style='background:" + color + "; color:" + textColor + "; padding:4px 10px; border-radius:12px; font-weight:bold; font-size:0.8rem;'>" + label + "</span>";
    }

    function findParking() {
        if (navigator.geolocation) {
            document.getElementById("locationStatus").innerText = "Fetching your location...";
            navigator.geolocation.getCurrentPosition(
                function (position) {
                    var lat = position.coords.latitude;
                    var lon = position.coords.longitude;
                    document.getElementById("locationStatus").innerText = "✅ Live location fetched!";
                    loadSlotsForLocation(lat, lon);
                },
                function () {
                    document.getElementById("locationStatus").innerText = "❌ Location permission denied.";
                }
            );
        }
    }

    function searchByAddress() {
        var address = document.getElementById("searchAddress").value.trim();
        if (!address) {
            document.getElementById("addressStatus").innerText = "⚠️ Please enter an address.";
            return;
        }
        document.getElementById("addressStatus").innerText = "Searching...";
        fetch("https://nominatim.openstreetmap.org/search?q=" + encodeURIComponent(address) + "&format=json&limit=1")
            .then(function(response) { return response.json(); })
            .then(function(data) {
                if (data.length === 0) {
                    document.getElementById("addressStatus").innerText = "❌ No related area found.";
                } else {
                    var lat = parseFloat(data[0].lat);
                    var lon = parseFloat(data[0].lon);
                    document.getElementById("addressStatus").innerText = "✅ Found: " + data[0].display_name;
                    loadSlotsForLocation(lat, lon);
                }
            })
            .catch(function() {
                document.getElementById("addressStatus").innerText = "❌ Error searching. Try again.";
            });
    }

    function getDistanceKm(lat1, lon1, lat2, lon2) {
        var R = 6371;
        var dLat = (lat2 - lat1) * Math.PI / 180;
        var dLon = (lon2 - lon1) * Math.PI / 180;
        var a = Math.sin(dLat / 2) * Math.sin(dLat / 2) +
            Math.cos(lat1 * Math.PI / 180) * Math.cos(lat2 * Math.PI / 180) *
            Math.sin(dLon / 2) * Math.sin(dLon / 2);
        return R * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
    }

    function loadSlotsForLocation(lat, lon) {
        map.setView([lat, lon], 14);

        L.marker([lat, lon])
            .addTo(map)
            .bindPopup("📍 You are here!")
            .openPopup();

        L.circle([lat, lon], {
            color: 'blue',
            fillColor: '#add8e6',
            fillOpacity: 0.2,
            radius: 3000
        }).addTo(map);

        fetch("/Parking/NearbySlots?lat=" + lat + "&lon=" + lon + "&radius=6")
            .then(function(response) { return response.json(); })
            .then(function(slots) {
                var available = slots.filter(function(s) { return !s.isBooked; }).length;
                var booked = slots.filter(function(s) { return s.isBooked; }).length;

                document.getElementById("status").innerText =
                    "✅ Found " + slots.length + " slot(s) nearby — " + available + " available, " + booked + " booked.";

                var tableBody = document.getElementById("slotsTableBody");
                tableBody.innerHTML = "";

                slots.forEach(function(slot) {
                    var icon = slot.isBooked ? redIcon : greenIcon;

                    var ratingText = slot.averageRating > 0
                        ? "⭐ " + slot.averageRating.toFixed(1)
                        : "No reviews yet";

                    var popupContent = slot.isBooked
                        ? "<b>" + slot.ownerName + "</b><br>" +
                          "🚗 " + slot.vehicleType + "<br>" +
                          "⏰ " + new Date(slot.availableFrom).toLocaleString() + "<br>" +
                          "to " + new Date(slot.availableTo).toLocaleString() + "<br>" +
                          "<br><span style='color:red; font-weight:bold;'>🔴 Already Booked</span>"
                        : "<b>" + slot.ownerName + "</b><br>" +
                          "💰 ₹" + slot.pricePerHour + "/hr<br>" +
                          "🚗 " + slot.vehicleType + "<br>" +
                          "⭐ Rating: " + ratingText + "<br>" +
                          "⏰ " + new Date(slot.availableFrom).toLocaleString() + "<br>" +
                          "to " + new Date(slot.availableTo).toLocaleString() + "<br><br>" +
                          "<a href='/Verification/Upload/" + slot.id + "' style='background:#28a745; color:white; padding:5px 10px; text-decoration:none; border-radius:4px;'>✅ Book This Slot</a>";

                    L.marker([slot.latitude, slot.longitude], { icon: icon })
                        .addTo(map)
                        .bindPopup(popupContent);

                    var statusBadge = slot.isBooked
                        ? "<span style='color:red; font-weight:bold;'>🔴 Booked</span>"
                        : "<span style='color:green; font-weight:bold;'>🟢 Available</span>";

                    var actionBtn = slot.isBooked
                        ? "<span style='color:gray;'>—</span>"
                        : "<a href='/Verification/Upload/" + slot.id + "' style='background:#28a745; color:white; padding:4px 8px; text-decoration:none; border-radius:4px;'>🔐 Verify & Book</a>";

                    var distText = getDistanceKm(lat, lon, slot.latitude, slot.longitude).toFixed(2) + " km";

                    var starDisplay = slot.averageRating > 0
                        ? "⭐ " + slot.averageRating.toFixed(1)
                        : "<span style='color:#aaa;'>No reviews</span>";

                    tableBody.innerHTML += "<tr>" +
                        "<td style='padding:8px; border:1px solid #444;'>" + slot.ownerName + "</td>" +
                        "<td style='padding:8px; border:1px solid #444;'>₹" + slot.pricePerHour + "/hr</td>" +
                        "<td style='padding:8px; border:1px solid #444;'>" + slot.vehicleType + "</td>" +
                        "<td style='padding:8px; border:1px solid #444;'>" + new Date(slot.availableFrom).toLocaleString() + "</td>" +
                        "<td style='padding:8px; border:1px solid #444;'>" + new Date(slot.availableTo).toLocaleString() + "</td>" +
                        "<td style='padding:8px; border:1px solid #444;'>" + statusBadge + "</td>" +
                        "<td style='padding:8px; border:1px solid #444;'>📍 " + distText + "</td>" +
                        "<td style='padding:8px; border:1px solid #444;'>" + starDisplay + "</td>" +
                        "<td style='padding:8px; border:1px solid #444;'>" + getScoreBadge(slot.parkingScore) + "</td>" +
                        "<td style='padding:8px; border:1px solid #444;'>" + actionBtn + "</td>" +
                        "</tr>";
                });

                document.getElementById("slotsBox").style.display = "block";
            })
            .catch(function(err) {
                console.error("Error loading slots:", err);
                document.getElementById("status").innerText = "❌ Error loading slots. Try again.";
            });
    }
</script>