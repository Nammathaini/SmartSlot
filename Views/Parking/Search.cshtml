@{
    ViewData["Title"] = "Find Parking Near Me";
}

<style>
    body {
        background-image: url('https://i.pinimg.com/1200x/ea/3f/92/ea3f92fcdab7799f742c813cdb651463.jpg');
        background-size: cover;
        background-position: center;
        background-attachment: fixed;
        background-color: #000 !important;
        color: white !important;
    }

    body::before {
        content: '';
        position: fixed;
        top: 0; left: 0;
        width: 100%; height: 100%;
        background: rgba(0, 0, 0, 0.78);
        z-index: 0;
    }

    h2 { text-align:center; margin:20px 0; position:relative; z-index:1; }

    .top-section {
        position: relative;
        z-index: 1;
        text-align: center;
        padding: 20px;
    }

    .btn-toggle {
        padding: 8px 15px;
        border: none;
        border-radius: 6px;
        cursor: pointer;
        margin: 0 5px;
        font-weight: bold;
    }

    .btn-available { background:#28a745; color:white; }
    .btn-booked { background:#dc3545; color:white; }

    #map { height:500px; margin:20px; border-radius:10px; z-index:1; }

    .slots-section {
        margin: 20px;
        background-color: rgba(26, 26, 26, 0.92);
        border: 1px solid #333;
        border-radius: 10px;
        padding: 15px;
        position: relative;
        z-index: 1;
    }

    table { width:100%; border-collapse: collapse; }
    th, td { padding:8px; border:1px solid #444; }
    th { background:#2a2a2a; }

</style>

<h2>🔍 Find Parking Near Me</h2>

<div class="top-section">
    <button class="btn-toggle btn-available" onclick="showAvailable()">🟢 Available Slots</button>
    <button class="btn-toggle btn-booked" onclick="showBooked()">🔴 Booked Slots</button>
</div>

<p id="status" style="text-align:center;">Click location to load slots.</p>

<div id="map"></div>

<div class="slots-section">
    <div style="overflow-x:auto;">
        <table>
            <thead>
                <tr>
                    <th>Owner</th>
                    <th>Price</th>
                    <th>Vehicle</th>
                    <th>Available From</th>
                    <th>Available To</th>
                    <th class="booking-col" style="display:none;">Booked From</th>
                    <th class="booking-col" style="display:none;">Booked To</th>
                    <th>Distance</th>
                    <th>Rating</th>
                    <th>Slot Status</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody id="slotsTableBody"></tbody>
        </table>
    </div>
</div>

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

<script>

var map = L.map('map').setView([13.0827, 80.2707], 13);

L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
    attribution: '© OpenStreetMap contributors'
}).addTo(map);

var allSlots = [];
var currentLat, currentLon;

function getScoreBadge(score) {
    if (!score || score === 0) return "<span style='color:#aaa;'>—</span>";
    if (score >= 80) return "🥇 Premium";
    if (score >= 70) return "🥈 Gold";
    if (score >= 50) return "🥉 Silver";
    if (score >= 30) return "🏠 Basic";
    return "❌ Poor";
}

function getDistanceKm(lat1, lon1, lat2, lon2) {
    var R = 6371;
    var dLat = (lat2 - lat1) * Math.PI / 180;
    var dLon = (lon2 - lon1) * Math.PI / 180;
    var a = Math.sin(dLat/2)*Math.sin(dLat/2) +
            Math.cos(lat1*Math.PI/180)*Math.cos(lat2*Math.PI/180) *
            Math.sin(dLon/2)*Math.sin(dLon/2);
    return R * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1-a));
}

function loadSlots(lat, lon) {

    currentLat = lat;
    currentLon = lon;

    fetch("/Parking/NearbySlots?lat=" + lat + "&lon=" + lon + "&radius=6")
        .then(r => r.json())
        .then(data => {
            allSlots = data;
            document.getElementById("status").innerText =
                "Found " + data.length + " slots nearby.";
            renderTable("available");
        });
}

function renderTable(type) {

    var body = document.getElementById("slotsTableBody");
    body.innerHTML = "";

    var bookingCols = document.querySelectorAll(".booking-col");
    bookingCols.forEach(c => {
        c.style.display = (type === "booked") ? "" : "none";
    });

    var filtered = type === "available"
        ? allSlots.filter(s => !s.isBooked)
        : allSlots.filter(s => s.isBooked);

    filtered.forEach(slot => {

        var dist = getDistanceKm(currentLat, currentLon,
                    slot.latitude, slot.longitude).toFixed(2) + " km";

        var rating = slot.averageRating > 0
            ? "⭐ " + slot.averageRating.toFixed(1)
            : "No reviews";

        var action = slot.isBooked
            ? "-"
            : "<a href='/Verification/Upload/" + slot.id +
              "' style='background:#28a745;color:white;padding:4px 8px;border-radius:4px;'>Book</a>";

        var row = "<tr>" +
            "<td>" + slot.ownerName + "</td>" +
            "<td>₹" + slot.pricePerHour + "/hr</td>" +
            "<td>" + slot.vehicleType + "</td>" +
            "<td>" + new Date(slot.availableFrom).toLocaleString() + "</td>" +
            "<td>" + new Date(slot.availableTo).toLocaleString() + "</td>";

        if (type === "booked") {
            row += "<td>" +
                (slot.bookingFrom ? new Date(slot.bookingFrom).toLocaleString() : "—")
                + "</td>";
            row += "<td>" +
                (slot.bookingTo ? new Date(slot.bookingTo).toLocaleString() : "—")
                + "</td>";
        }

        row += "<td>" + dist + "</td>" +
               "<td>" + rating + "</td>" +
               "<td>" + getScoreBadge(slot.parkingScore) + "</td>" +
               "<td>" + action + "</td>" +
               "</tr>";

        body.innerHTML += row;
    });
}

function showAvailable() {
    renderTable("available");
}

function showBooked() {
    renderTable("booked");
}

navigator.geolocation.getCurrentPosition(function(pos){
    loadSlots(pos.coords.latitude, pos.coords.longitude);
});

</script>