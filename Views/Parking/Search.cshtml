@{
    ViewData["Title"] = "Find Parking Near Me";
}

<style>
    body {
        background-color: #000 !important;
        color: white !important;
    }

    .navbar {
        background-color: #111 !important;
    }

    .navbar-brand {
        color: white !important;
    }

    h2 {
        color: white;
        text-align: center;
        margin-bottom: 20px;
        font-size: 2rem;
    }

    .search-wrapper {
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: 30px 20px 20px 20px;
    }

    .btn-location {
        padding: 10px 25px;
        background-color: #28a745;
        color: white;
        border: none;
        border-radius: 6px;
        cursor: pointer;
        font-size: 1rem;
        margin-bottom: 8px;
    }

    .search-row {
        display: flex;
        gap: 8px;
        margin-top: 10px;
    }

        .search-row input {
            padding: 10px;
            width: 300px;
            border-radius: 6px;
            border: 1px solid #444;
            background-color: #2a2a2a;
            color: white;
            font-size: 1rem;
        }

        .search-row button {
            padding: 10px 15px;
            background-color: #007bff;
            color: white;
            border: none;
            border-radius: 6px;
            cursor: pointer;
            font-size: 1rem;
        }

    .status-text {
        color: #aaa;
        font-size: 0.85rem;
        text-align: center;
        margin-top: 5px;
    }

    #map {
        margin: 0 20px;
        border-radius: 10px;
    }

    #slotsBox {
        margin: 20px;
        background-color: #1a1a1a;
        border: 1px solid #333;
        border-radius: 10px;
        padding: 15px;
        color: white;
    }

        #slotsBox h4 {
            color: white;
        }

        #slotsBox table th {
            background-color: #2a2a2a;
            color: white;
        }

        #slotsBox table td {
            color: #ddd;
        }
</style>



@{
    ViewData["Title"] = "Find Parking Near Me";
}

<h2>Find Parking Near Me</h2>

<button type="button" onclick="findParking()">📍 Use My Live Location</button>
<p id="locationStatus"></p>

<div style="margin-top:10px;">
    <input type="text" id="searchAddress" placeholder="Search your area / address" style="width:300px;" />
    <button type="button" onclick="searchByAddress()">🔍</button>
    <p id="addressStatus"></p>
</div>

<p id="status">Click above to find parking slots near you.</p>

<!-- Map -->
<div id="map" style="height: 500px; margin-top: 20px;"></div>

<!-- Slots Info Box -->
<div id="slotsBox" style="display:none; margin-top: 20px; border: 1px solid #ccc; border-radius: 8px; padding: 15px;">
    <h4>🅿️ Nearby Parking Slots</h4>
    <table style="width:100%; border-collapse: collapse;">
        <thead>
            <tr style="background:#f0f0f0;">
                <th style="padding:8px; border:1px solid #ddd;">Owner</th>
                <th style="padding:8px; border:1px solid #ddd;">Price</th>
                <th style="padding:8px; border:1px solid #ddd;">Vehicle</th>
                <th style="padding:8px; border:1px solid #ddd;">Available From</th>
                <th style="padding:8px; border:1px solid #ddd;">Available To</th>
                <th style="padding:8px; border:1px solid #ddd;">Booked By</th>
                <th style="padding:8px; border:1px solid #ddd;">Status</th>
                <th style="padding:8px; border:1px solid #ddd;">Distance</th>
                <th style="padding:8px; border:1px solid #ddd;">Action</th>
            </tr>
        </thead>
        <tbody id="slotsTableBody"></tbody>
    </table>
</div>

<!-- Leaflet CSS -->
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
<!-- Leaflet JS -->
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

<script>
    var map = L.map('map').setView([13.0827, 80.2707], 13);

    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
    attribution: '© OpenStreetMap contributors'
    }).addTo(map);

    var greenIcon = L.icon({
    iconUrl: 'https://raw.githubusercontent.com/pointhi/leaflet-color-markers/master/img/marker-icon-green.png',
    shadowUrl: 'https://unpkg.com/leaflet@1.9.4/dist/images/marker-shadow.png',
    iconSize: [25, 41], iconAnchor: [12, 41], popupAnchor: [1, -34],
    });

    var redIcon = L.icon({
    iconUrl: 'https://raw.githubusercontent.com/pointhi/leaflet-color-markers/master/img/marker-icon-red.png',
    shadowUrl: 'https://unpkg.com/leaflet@1.9.4/dist/images/marker-shadow.png',
    iconSize: [25, 41], iconAnchor: [12, 41], popupAnchor: [1, -34],
    });

    function findParking() {
    if (navigator.geolocation) {
    document.getElementById("locationStatus").innerText = "Fetching your location...";
    navigator.geolocation.getCurrentPosition(
    function (position) {
    var lat = position.coords.latitude;
    var lon = position.coords.longitude;
    document.getElementById("locationStatus").innerText = "✅ Live location fetched!";
    loadSlotsForLocation(lat, lon);
    },
    function () {
    document.getElementById("locationStatus").innerText = "❌ Location permission denied.";
    }
    );
    }
    }

    function searchByAddress() {
    var address = document.getElementById("searchAddress").value.trim();
    if (!address) {
    document.getElementById("addressStatus").innerText = "⚠️ Please enter an address.";
    return;
    }
    document.getElementById("addressStatus").innerText = "Searching...";
    fetch(`https://nominatim.openstreetmap.org/search?q=${encodeURIComponent(address)}&format=json&limit=1`)
    .then(response => response.json())
    .then(data => {
    if (data.length === 0) {
    document.getElementById("addressStatus").innerText = "❌ No related area found. Please enter a valid address.";
    } else {
    var lat = parseFloat(data[0].lat);
    var lon = parseFloat(data[0].lon);
    document.getElementById("addressStatus").innerText = `✅ Found: ${data[0].display_name}`;
    loadSlotsForLocation(lat, lon);
    }
    })
    .catch(() => {
    document.getElementById("addressStatus").innerText = "❌ Error searching. Try again.";
    });
    }

    function getDistanceKm(lat1, lon1, lat2, lon2) {
    var R = 6371;
    var dLat = (lat2 - lat1) * Math.PI / 180;
    var dLon = (lon2 - lon1) * Math.PI / 180;
    var a = Math.sin(dLat / 2) * Math.sin(dLat / 2) +
    Math.cos(lat1 * Math.PI / 180) * Math.cos(lat2 * Math.PI / 180) *
    Math.sin(dLon / 2) * Math.sin(dLon / 2);
    return R * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
    }

    function loadSlotsForLocation(lat, lon) {
    map.setView([lat, lon], 14);

    L.marker([lat, lon])
    .addTo(map)
    .bindPopup("📍 You are here!")
    .openPopup();

    L.circle([lat, lon], {
    color: 'blue',
    fillColor: '#add8e6',
    fillOpacity: 0.2,
    radius: 8000
    }).addTo(map);

    fetch(`/Parking/NearbySlots?lat=${lat}&lon=${lon}&radius=8`)
    .then(response => response.json())
    .then(slots => {
    var available = slots.filter(s => !s.isBooked).length;
    var booked = slots.filter(s => s.isBooked).length;

    document.getElementById("status").innerText =
    `✅ Found ${slots.length} slot(s) nearby — ${available} available, ${booked} booked.`;

    var tableBody = document.getElementById("slotsTableBody");
    tableBody.innerHTML = "";

    slots.forEach(slot => {
    var icon = slot.isBooked ? redIcon : greenIcon;

    var popupContent = slot.isBooked
    ? `<b>${slot.ownerName}</b><br>🚗 ${slot.vehicleType}<br>
    ⏰ ${new Date(slot.availableFrom).toLocaleString()}<br>
    to ${new Date(slot.availableTo).toLocaleString()}<br><br>
    <span style="color:red; font-weight:bold;">🔴 Already Booked</span>`
    : `<b>${slot.ownerName}</b><br>💰 ₹${slot.pricePerHour}/hr<br>
    🚗 ${slot.vehicleType}<br>
    ⏰ ${new Date(slot.availableFrom).toLocaleString()}<br>
    to ${new Date(slot.availableTo).toLocaleString()}<br><br>
    <a href="/Parking/Book/${slot.id}" style="background:#28a745; color:white; padding:5px 10px; text-decoration:none; border-radius:4px;">✅ Book This Slot</a>`;

    L.marker([slot.latitude, slot.longitude], { icon: icon })
    .addTo(map)
    .bindPopup(popupContent);

    var statusBadge = slot.isBooked
    ? `<span style="color:red; font-weight:bold;">🔴 Booked</span>`
    : `<span style="color:green; font-weight:bold;">🟢 Available</span>`;

    var actionBtn = slot.isBooked
    ? `<span style="color:gray;">—</span>`
    : `<a href="/Parking/Book/${slot.id}" style="background:#28a745; color:white; padding:4px 8px; text-decoration:none; border-radius:4px;">Book</a>`;

    var distText = getDistanceKm(lat, lon, slot.latitude, slot.longitude).toFixed(2) + " km";

    fetch(`/Parking/GetBookingInfo/${slot.id}`)
    .then(r => r.json())
    .then(booking => {
    var bookedBy = booking ? booking.customerName : "—";
    tableBody.innerHTML += `
    <tr>
    <td style="padding:8px; border:1px solid #ddd;">${slot.ownerName}</td>
    <td style="padding:8px; border:1px solid #ddd;">₹${slot.pricePerHour}/hr</td>
    <td style="padding:8px; border:1px solid #ddd;">${slot.vehicleType}</td>
    <td style="padding:8px; border:1px solid #ddd;">${new Date(slot.availableFrom).toLocaleString()}</td>
    <td style="padding:8px; border:1px solid #ddd;">${new Date(slot.availableTo).toLocaleString()}</td>
    <td style="padding:8px; border:1px solid #ddd;">${bookedBy}</td>
    <td style="padding:8px; border:1px solid #ddd;">${statusBadge}</td>
    <td style="padding:8px; border:1px solid #ddd;">📍 ${distText}</td>
    <td style="padding:8px; border:1px solid #ddd;">${actionBtn}</td>
    </tr>`;
    });
    });

    document.getElementById("slotsBox").style.display = "block";
    });
    }
</script>