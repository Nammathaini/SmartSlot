@{
    Layout = null;
    var user = ViewBag.User as SmartSlot.Models.User;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>Profile — SmartSlot</title>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@600;700;800&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
    <style>
        *,*::before,*::after{margin:0;padding:0;box-sizing:border-box;}
        :root{
            --primary:#2563EB;--green:#10b981;--amber:#f59e0b;
            --dark:#0F172A;--surface:rgba(30,41,59,0.65);
            --surface-solid:#1e293b;--border:rgba(255,255,255,0.08);
            --text:#f1f5f9;--text-dim:rgba(241,245,249,0.45);
        }
        body{
            font-family:'Inter',sans-serif;
            background:linear-gradient(135deg,#0F172A,#111827,#1E293B);
            background-attachment:fixed;
            color:var(--text);min-height:100vh;position:relative;
        }
        body::before{content:'';position:fixed;inset:0;z-index:0;pointer-events:none;opacity:0.025;background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)'/%3E%3C/svg%3E");background-size:128px 128px;}
        body::after{content:'';position:fixed;inset:0;z-index:0;pointer-events:none;background:radial-gradient(ellipse 500px 400px at 80% 10%,rgba(37,99,235,0.07) 0%,transparent 70%);}

        .topbar{
            position:sticky;top:0;z-index:10;
            background:rgba(15,23,42,0.85);backdrop-filter:blur(20px);
            border-bottom:1px solid var(--border);
            padding:15px 24px;display:flex;align-items:center;gap:14px;
        }
        .back-btn{
            width:38px;height:38px;background:rgba(255,255,255,0.04);border:1px solid var(--border);
            border-radius:10px;color:var(--text);font-size:16px;
            display:flex;align-items:center;justify-content:center;
            text-decoration:none;transition:all 0.2s;
        }
        .back-btn:hover{background:rgba(255,255,255,0.09);color:var(--text);transform:translateX(-1px);}
        .topbar-title{font-family:'Poppins',sans-serif;font-size:18px;font-weight:700;}

        .page{position:relative;z-index:1;max-width:480px;margin:0 auto;padding:32px 20px 60px;}

        /* Avatar hero */
        .avatar-hero{text-align:center;padding:36px 20px 32px;animation:fadeUp 0.5s ease both;}
        .avatar-ring{position:relative;display:inline-block;margin-bottom:18px;}
        .avatar{
            width:92px;height:92px;
            background:linear-gradient(135deg,var(--primary),#7c3aed);
            border-radius:50%;display:flex;align-items:center;justify-content:center;
            font-family:'Poppins',sans-serif;font-size:38px;font-weight:800;color:#fff;
            position:relative;z-index:1;
            box-shadow:0 12px 32px rgba(37,99,235,0.35);
        }
        .avatar-glow{position:absolute;inset:-6px;border-radius:50%;background:linear-gradient(135deg,var(--primary),#7c3aed);opacity:0.18;filter:blur(10px);z-index:0;}
        .verified-badge{
            position:absolute;bottom:3px;right:3px;z-index:2;
            width:26px;height:26px;
            background:linear-gradient(135deg,var(--green),#059669);
            border-radius:50%;display:flex;align-items:center;justify-content:center;
            font-size:12px;border:2.5px solid #0F172A;
            box-shadow:0 4px 10px rgba(16,185,129,0.4);
        }
        .avatar-name{font-family:'Poppins',sans-serif;font-size:24px;font-weight:700;margin-bottom:10px;}
        .avatar-tag{
            display:inline-flex;align-items:center;gap:6px;
            background:rgba(16,185,129,0.08);border:1px solid rgba(16,185,129,0.2);
            padding:5px 14px;border-radius:100px;
            font-size:12px;color:var(--green);font-weight:500;
        }

        .section-label{font-size:10px;font-weight:600;letter-spacing:1.5px;text-transform:uppercase;color:var(--text-dim);margin-bottom:12px;margin-top:28px;}

        /* Info card */
        .info-card{
            background:var(--surface);backdrop-filter:blur(14px);
            border:1px solid var(--border);border-radius:16px;
            overflow:hidden;margin-bottom:16px;
            animation:fadeUp 0.5s 0.1s ease both;
        }
        .info-row{
            display:flex;align-items:center;gap:14px;
            padding:18px 20px;border-bottom:1px solid rgba(255,255,255,0.05);
            transition:background 0.15s;
        }
        .info-row:last-child{border-bottom:none;}
        .info-row:hover{background:rgba(255,255,255,0.02);}
        .info-icon{width:40px;height:40px;border-radius:11px;display:flex;align-items:center;justify-content:center;font-size:18px;flex-shrink:0;}
        .icon-user{background:rgba(37,99,235,0.1);}
        .icon-phone{background:rgba(16,185,129,0.1);}
        .icon-email{background:rgba(245,158,11,0.1);}
        .info-label{font-size:10px;font-weight:600;letter-spacing:1px;text-transform:uppercase;color:var(--text-dim);}
        .info-value{font-size:15px;color:var(--text);font-weight:500;margin-top:3px;}

        /* Actions */
        .actions{display:grid;grid-template-columns:1fr 1fr;gap:10px;animation:fadeUp 0.5s 0.2s ease both;}
        .action-btn{
            display:flex;align-items:center;gap:10px;padding:15px 16px;
            background:var(--surface);backdrop-filter:blur(14px);
            border:1px solid var(--border);border-radius:14px;
            color:var(--text);text-decoration:none;font-size:13px;font-weight:500;
            transition:all 0.2s;
        }
        .action-btn:hover{background:rgba(255,255,255,0.07);border-color:rgba(255,255,255,0.14);color:var(--text);transform:translateY(-1px);}
        .action-icon{width:34px;height:34px;border-radius:9px;display:flex;align-items:center;justify-content:center;font-size:16px;flex-shrink:0;}

        @@keyframes fadeUp{from{opacity:0;transform:translateY(12px);}to{opacity:1;transform:translateY(0);}}
    </style>
</head>
<body>
<div class="topbar">
    <a href="/Parking/Index" class="back-btn">←</a>
    <span class="topbar-title">Profile</span>
</div>
<div class="page">
@if(user!=null)
{
    <div class="avatar-hero">
        <div class="avatar-ring">
            <div class="avatar-glow"></div>
            <div class="avatar">@user.Username.Substring(0,1).ToUpper()</div>
            <div class="verified-badge">✓</div>
        </div>
        <div class="avatar-name">@user.Username</div>
        <div style="margin-top:8px;"><span class="avatar-tag">✓ SmartSlot Member</span></div>
    </div>

    <div class="section-label">Account Info</div>
    <div class="info-card">
        <div class="info-row">
            <div class="info-icon icon-user">👤</div>
            <div><div class="info-label">Username</div><div class="info-value">@user.Username</div></div>
        </div>
        <div class="info-row">
            <div class="info-icon icon-phone">📱</div>
            <div><div class="info-label">Phone Number</div><div class="info-value">@user.PhoneNumber</div></div>
        </div>
        <div class="info-row">
            <div class="info-icon icon-email">✉️</div>
            <div><div class="info-label">Email Address</div><div class="info-value">@(string.IsNullOrEmpty(user.Email)?"Not set":user.Email)</div></div>
        </div>
    </div>

    <div class="section-label">Actions</div>
    <div class="actions">
        <a href="/Parking/Dashboard" class="action-btn"><span class="action-icon" style="background:rgba(37,99,235,0.1)">📊</span>Dashboard</a>
        <a href="/Auth/ResetPassword" class="action-btn"><span class="action-icon" style="background:rgba(16,185,129,0.1)">🔑</span>Reset Password</a>
        <a href="/Parking/Search" class="action-btn" style="grid-column:span 2;"><span class="action-icon" style="background:rgba(245,158,11,0.1)">🔍</span>Find Parking</a>
    </div>
}
else
{
    <div style="text-align:center;padding:60px 20px;color:var(--text-dim);">
        <div style="font-size:48px;margin-bottom:12px;opacity:0.4;">⚠️</div>
        <p>Could not load profile. Please sign in again.</p>
    </div>
}
</div>
</body>
</html>
