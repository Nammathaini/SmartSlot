@{
    ViewData["Title"] = "Booking Cancelled";
    Layout = "_Layout";
}
<div style="min-height:80vh;display:flex;align-items:center;justify-content:center;">
    <div style="text-align:center;padding:40px;">
        <div style="font-size:52px;margin-bottom:16px;">✅</div>
        <h2 style="font-family:'Poppins',sans-serif;color:#f1f5f9;margin-bottom:8px;">Booking Cancelled</h2>
        <p style="color:rgba(241,245,249,0.5);margin-bottom:24px;">Your booking has been cancelled and the slot is now free.</p>
        <a href="/Parking/Search" style="padding:12px 28px;background:linear-gradient(90deg,#3B82F6,#2563EB);color:#fff;border-radius:12px;text-decoration:none;font-weight:600;">Find Another Slot</a>
    </div>
</div>