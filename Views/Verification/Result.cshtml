@model SmartSlot.Models.VerificationData

@{
    ViewData["Title"] = "Verification Result";
    bool verified = Model.PlateMatch && Model.NameMatch;
}

<style>
    body {
        background-image: url('https://i.pinimg.com/1200x/ea/3f/92/ea3f92fcdab7799f742c813cdb651463.jpg');
        background-size: cover;
        background-position: center;
        background-attachment: fixed;
        background-color: #000 !important;
        color: white !important;
    }

        body::before {
            content: '';
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.80);
            z-index: 0;
        }

    .navbar {
        background-color: #111 !important;
        position: relative;
        z-index: 2;
    }

    .page-wrapper {
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 40px 20px;
        position: relative;
        z-index: 1;
    }

    .card {
        background-color: rgba(26, 26, 26, 0.95);
        border: 2px solid @(verified ? "#28a745" : "#dc3545");
        border-radius: 12px;
        padding: 35px;
        width: 100%;
        max-width: 520px;
        text-align: center;
    }

    .result-icon {
        font-size: 4rem;
        margin-bottom: 15px;
    }

    .status-badge {
        display: inline-block;
        padding: 8px 20px;
        border-radius: 20px;
        font-weight: bold;
        font-size: 1.1rem;
        background: @(verified ? "#28a745" : "#dc3545");
        color: white;
        margin-bottom: 20px;
    }

    .check-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 12px;
        border-radius: 8px;
        background: rgba(0,0,0,0.3);
        margin-bottom: 10px;
    }

        .check-row p {
            color: #ccc;
            margin: 0;
            font-size: 0.9rem;
        }

    .btn-proceed {
        display: block;
        width: 100%;
        padding: 14px;
        background: #28a745;
        color: white;
        border: none;
        border-radius: 8px;
        font-size: 1.1rem;
        font-weight: bold;
        text-decoration: none;
        margin-top: 20px;
        cursor: pointer;
    }

    .btn-disabled {
        display: block;
        width: 100%;
        padding: 14px;
        background: #555;
        color: #888;
        border: none;
        border-radius: 8px;
        font-size: 1.1rem;
        font-weight: bold;
        margin-top: 20px;
        cursor: not-allowed;
    }

    .btn-retry {
        display: block;
        width: 100%;
        padding: 14px;
        background: #007bff;
        color: white;
        border: none;
        border-radius: 8px;
        font-size: 1.1rem;
        font-weight: bold;
        text-decoration: none;
        margin-top: 10px;
        cursor: pointer;
    }
</style>

<div class="page-wrapper">
    <div class="card">

        <div class="result-icon">@(verified ? "✅" : "❌")</div>
        <div class="status-badge">
            @(verified ? "Identity Verified" : "Verification Failed")
        </div>

        <h3 style="color:white; margin-bottom:20px;">Verification Report</h3>

        <div class="check-row">
            <p>🚗 Plate from RC</p>
            <b style="color:white;">@Model.ExtractedPlateFromRC</b>
        </div>

        <div class="check-row">
            <p>📸 Plate from Vehicle Photo</p>
            <b style="color:white;">@Model.ExtractedPlateFromVehicle</b>
        </div>

        <div class="check-row">
            <p>Plate Match</p>
            <b style="color:@(Model.PlateMatch ? "#28a745" : "#dc3545")">
                @(Model.PlateMatch ? "✅ Match" : "❌ Mismatch")
            </b>
        </div>

        <div class="check-row">
            <p>👤 Name from RC</p>
            <b style="color:white;">@Model.ExtractedNameFromRC</b>
        </div>

        <div class="check-row">
            <p>🪪 Name from DL</p>
            <b style="color:white;">@Model.ExtractedNameFromDL</b>
        </div>

        <div class="check-row">
            <p>Name Match</p>
            <b style="color:@(Model.NameMatch ? "#28a745" : "#dc3545")">
                @(Model.NameMatch ? "✅ Match" : "❌ Mismatch")
            </b>
        </div>

        <!-- Result Message Box -->
        <div style="
            margin-top: 20px;
            padding: 15px;
            border-radius: 8px;
            background: @(verified ? "rgba(40,167,69,0.15)" : "rgba(220,53,69,0.15)");
            border: 1px solid @(verified ? "#28a745" : "#dc3545");">

            @if (verified)
            {
                <p style="color:#28a745; font-weight:bold; margin:0;">
                    ✅ Both plate and name verified successfully!
                </p>
                <p style="color:#aaa; font-size:0.85rem; margin:5px 0 0 0;">
                    You can now proceed to book this parking slot.
                </p>
            }
            else if (!Model.PlateMatch && !Model.NameMatch)
            {
                <p style="color:#dc3545; font-weight:bold; margin:0;">
                    ❌ Both plate number and name did not match.
                </p>
                <p style="color:#aaa; font-size:0.85rem; margin:5px 0 0 0;">
                    Please upload clear, valid RC, DL and vehicle photos.
                </p>
            }
            else if (!Model.PlateMatch)
            {
                <p style="color:#dc3545; font-weight:bold; margin:0;">
                    ⚠️ Vehicle plate number did not match.
                </p>
                <p style="color:#aaa; font-size:0.85rem; margin:5px 0 0 0;">
                    Please upload a clearer vehicle photo showing the number plate.
                </p>
            }
            else if (!Model.NameMatch)
            {
                <p style="color:#dc3545; font-weight:bold; margin:0;">
                    ⚠️ Name on RC did not match Driving License.
                </p>
                <p style="color:#aaa; font-size:0.85rem; margin:5px 0 0 0;">
                    Please upload clearer RC and DL photos.
                </p>
            }
        </div>

        <!-- Confirm Booking Button -->
        @if (verified)
        {
            <a href="/Parking/Book/@TempData["SlotId"]" class="btn-proceed">
                ✅ Confirm Booking
            </a>
        }
        else
        {
            <button class="btn-disabled" disabled>
                🔒 Confirm Booking
            </button>
            <a href="javascript:history.back()" class="btn-retry">
                🔄 Re-upload Documents
            </a>
        }

    </div>
</div>